                    <TableCard Title="Evaluaciones de proveedores">
                        <thead><tr><th>Fecha</th><th>Proveedor</th><th>Periodo</th><th>Criticidad</th><th>Media</th><th>Decisión</th><th>Próxima</th><th>Acción</th></tr></thead>
