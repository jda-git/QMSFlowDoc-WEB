    private static bool IsAuditFindingOverdue(AuditFinding finding)
    {
        if (!finding.DueDate.HasValue || finding.DueDate.Value.Date >= DateTime.Today)
        {
            return false;
        }

        if (IsNonconformityFinding(finding.Type))
        {
            return !finding.RelatedNCId.HasValue;
        }

        return string.IsNullOrWhiteSpace(finding.EffectivenessReview);
    }

    private static string GetAuditFindingStatusLabel(AuditFinding finding)
    {
        if (IsNonconformityFinding(finding.Type) && finding.RelatedNCId.HasValue)
        {
            return "NC vinculada";
        }

        if (!IsNonconformityFinding(finding.Type) && !string.IsNullOrWhiteSpace(finding.EffectivenessReview))
        {
            return "Cerrado";
        }

        if (IsAuditFindingOverdue(finding))
        {
            return "Vencido";
        }

        return finding.DueDate.HasValue ? "Pendiente" : "Sin plazo";
    }

    private static string GetAuditFindingBadgeClass(AuditFinding finding)
    {
        return GetAuditFindingStatusLabel(finding) switch
        {
            "NC vinculada" => "bg-success",
            "Cerrado" => "bg-success",
            "Vencido" => "bg-danger",
            "Pendiente" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    private static bool IsRiskActionOverdue(Risk risk)
    {
        return risk.Status == RiskStatus.ACTIVE &&
               risk.DueDate.HasValue &&
               risk.DueDate.Value.Date < DateTime.Today;
    }

    private static string GetRiskActionStatusLabel(Risk risk)
    {
        if (risk.Status is RiskStatus.MITIGATED or RiskStatus.ACCEPTED or RiskStatus.RETIRED)
        {
            return "Cerrada";
        }

        if (IsRiskActionOverdue(risk))
        {
            return "Vencida";
        }

        return risk.DueDate.HasValue ? "Abierta" : "Sin plazo";
    }

    private static string GetRiskActionBadgeClass(Risk risk)
    {
        return GetRiskActionStatusLabel(risk) switch
        {
            "Cerrada" => "bg-success",
            "Vencida" => "bg-danger",
            "Abierta" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    private static bool ReviewHasOpenAction(ManagementReview review)
    {
        return !string.IsNullOrWhiteSpace(review.Actions) &&
               string.IsNullOrWhiteSpace(review.EffectivenessReview);
    }

    private static bool IsReviewActionOverdue(ManagementReview review)
    {
        return ReviewHasOpenAction(review) &&
               review.ActionDueDate.HasValue &&
               review.ActionDueDate.Value.Date < DateTime.Today;
    }

    private static string GetReviewActionStatusLabel(ManagementReview review)
    {
        if (string.IsNullOrWhiteSpace(review.Actions))
        {
            return "Sin acciones";
        }

        if (!string.IsNullOrWhiteSpace(review.EffectivenessReview))
        {
            return "Cerrada";
        }

        return IsReviewActionOverdue(review) ? "Vencida" : "Abierta";
    }

    private static string GetReviewActionBadgeClass(ManagementReview review)
    {
        return GetReviewActionStatusLabel(review) switch
        {
            "Cerrada" => "bg-success",
            "Vencida" => "bg-danger",
            "Abierta" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    private static bool IsIndicatorActionOverdue(QualityIndicator indicator)
    {
        return !indicator.MeetsTarget &&
               indicator.DueDate.HasValue &&
               indicator.DueDate.Value.Date < DateTime.Today;
    }

    private static string GetIndicatorActionStatusLabel(QualityIndicator indicator)
    {
        if (indicator.MeetsTarget)
        {
            return "Cumple";
        }

        return IsIndicatorActionOverdue(indicator) ? "Vencida" : "En seguimiento";
    }

    private static string GetIndicatorActionBadgeClass(QualityIndicator indicator)
    {
        return GetIndicatorActionStatusLabel(indicator) switch
        {
            "Cumple" => "bg-success",
            "Vencida" => "bg-danger",
            _ => "bg-warning text-dark"
        };
    }

    private static bool SupplierEvaluationIsApproved(SupplierEvaluation evaluation)
    {
        return evaluation.AverageScore >= 3.5 &&
               (evaluation.Decision == "Aprobado" || evaluation.Decision == "Aprobado con restricciones");
    }

    private static bool SupplierNeedsManagementAttention(SupplierEvaluation evaluation)
    {
        return !evaluation.IsApproved || evaluation.Decision == "Aprobado con restricciones";
    }

    private static bool SupplierReevaluationIsOverdue(Supplier supplier)
    {
        return !supplier.IsDeleted &&
               supplier.NextEvaluationDate.HasValue &&
               supplier.NextEvaluationDate.Value.Date < DateTime.Today;
    }

    private static bool SupplierNeedsCurrentAttention(Supplier supplier)
    {
        return !supplier.IsDeleted &&
               (SupplierReevaluationIsOverdue(supplier) ||
                supplier.QualityStatus is SupplierQualityStatus.PENDIENTE
                    or SupplierQualityStatus.NO_APTO
                    or SupplierQualityStatus.EN_OBSERVACION
                    or SupplierQualityStatus.EVALUACION_CADUCADA);
    }

    private static string GetSupplierMonitoringLabel(Supplier supplier)
    {
        if (SupplierReevaluationIsOverdue(supplier))
        {
            return "Reevaluacion vencida";
        }

        return supplier.QualityStatus switch
        {
            SupplierQualityStatus.APTO => "Al dia",
            SupplierQualityStatus.PENDIENTE => "Pendiente de evaluar",
            SupplierQualityStatus.EN_OBSERVACION => "Con restricciones",
            SupplierQualityStatus.EVALUACION_CADUCADA => "Reevaluar",
            SupplierQualityStatus.NO_APTO => "No aprobado",
            _ => supplier.QualityStatus.ToString()
        };
    }

    private static string GetSupplierMonitoringBadgeClass(Supplier supplier)
    {
        if (SupplierReevaluationIsOverdue(supplier) || supplier.QualityStatus == SupplierQualityStatus.NO_APTO)
        {
            return "bg-danger";
        }

        return supplier.QualityStatus switch
        {
            SupplierQualityStatus.APTO => "bg-success",
            SupplierQualityStatus.PENDIENTE => "bg-secondary",
            SupplierQualityStatus.EN_OBSERVACION => "bg-warning text-dark",
            SupplierQualityStatus.EVALUACION_CADUCADA => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    private static string GetSupplierQualityStatusLabel(SupplierQualityStatus status) => status switch
    {
        SupplierQualityStatus.PENDIENTE => "Pendiente de evaluacion",
        SupplierQualityStatus.APTO => "Aprobado",
        SupplierQualityStatus.NO_APTO => "No aprobado",
        SupplierQualityStatus.EN_OBSERVACION => "Aprobado con restricciones",
        SupplierQualityStatus.EVALUACION_CADUCADA => "Reevaluar",
        _ => status.ToString()
    };

    private static string GetSupplierStatusBadgeClass(SupplierQualityStatus status) => status switch
    {
        SupplierQualityStatus.APTO => "bg-success",
        SupplierQualityStatus.PENDIENTE => "bg-secondary",
        SupplierQualityStatus.EN_OBSERVACION => "bg-warning text-dark",
        SupplierQualityStatus.EVALUACION_CADUCADA => "bg-warning text-dark",
        SupplierQualityStatus.NO_APTO => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetSupplierTypeLabel(SupplierType type) => type switch
    {
        SupplierType.SUMINISTROS_REACTIVOS => "Suministros / reactivos",
        SupplierType.SERVICIO_TECNICO => "Servicio tecnico",
        SupplierType.LABORATORIO_DERIVACION => "Laboratorio de derivacion",
        _ => type.ToString()
    };

    private static SupplierQualityStatus MapSupplierEvaluationToQualityStatus(SupplierEvaluation evaluation)
    {
        if (evaluation.Decision == "Aprobado con restricciones" && evaluation.IsApproved)
        {
            return SupplierQualityStatus.EN_OBSERVACION;
        }

        if (!evaluation.IsApproved && evaluation.Decision == "Reevaluar")
        {
            return SupplierQualityStatus.EVALUACION_CADUCADA;
        }

        if (!evaluation.IsApproved)
        {
            return SupplierQualityStatus.NO_APTO;
        }

        return MapSupplierDecisionToQualityStatus(evaluation.Decision);
    }

    private static SupplierQualityStatus MapSupplierDecisionToQualityStatus(string? decision) => decision switch
    {
        "Aprobado" => SupplierQualityStatus.APTO,
        "Aprobado con restricciones" => SupplierQualityStatus.EN_OBSERVACION,
        "Reevaluar" => SupplierQualityStatus.EVALUACION_CADUCADA,
        "No aprobado" => SupplierQualityStatus.NO_APTO,
        _ => SupplierQualityStatus.PENDIENTE
    };

    private static string GetSupplierDecisionBadgeClass(string? decision)
    {
        return MapSupplierDecisionToQualityStatus(decision) switch
        {
            SupplierQualityStatus.APTO => "bg-success",
            SupplierQualityStatus.EN_OBSERVACION => "bg-warning text-dark",
            SupplierQualityStatus.EVALUACION_CADUCADA => "bg-warning text-dark",
            SupplierQualityStatus.NO_APTO => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private static bool IndicatorMeetsTarget(QualityIndicator indicator)
    {
        return indicator.TargetRule switch
        {
            "Minimo" => indicator.ActualValue >= indicator.TargetValue,
            "Igual" => indicator.ActualValue == indicator.TargetValue,
            _ => indicator.ActualValue <= indicator.TargetValue
        };
    }

    private static bool AuditHasCompletionEvidence(AuditPlan audit)
    {
        return !string.IsNullOrWhiteSpace(audit.Scope) &&
               !string.IsNullOrWhiteSpace(audit.Criteria) &&
               !string.IsNullOrWhiteSpace(audit.LeadAuditor) &&
               !string.IsNullOrWhiteSpace(audit.ChecklistJson) &&
               !string.IsNullOrWhiteSpace(audit.SummaryReport) &&
               !string.IsNullOrWhiteSpace(audit.Conclusions);
    }

    private string GetAuditTitle(Guid auditPlanId)
    {
        return audits.FirstOrDefault(a => a.Id == auditPlanId)?.Title ?? "Auditoría no encontrada";
    }

    private static bool IsNonconformityFinding(FindingType value)
    {
        return value == FindingType.MINOR_NC || value == FindingType.MAJOR_NC;
    }

    private bool AuditHasUnlinkedNonconformityFindings(Guid auditPlanId)
    {
        return auditFindings.Any(f =>
            f.AuditPlanId == auditPlanId &&
            IsNonconformityFinding(f.Type) &&
            !f.RelatedNCId.HasValue);
    }
}
