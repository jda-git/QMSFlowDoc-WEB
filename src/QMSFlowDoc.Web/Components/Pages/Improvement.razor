    private async Task WriteExport(string title, string prefix, string html)
    {
        var exportDir = GetImprovementExportDirectory();
        Directory.CreateDirectory(exportDir);
        var stamp = DateTime.Now.ToString("yyyyMMdd-HHmmss");
        var htmlFileName = $"{prefix}-{stamp}.html";
        var wordFileName = $"{prefix}-{stamp}.doc";
        await File.WriteAllTextAsync(Path.Combine(exportDir, htmlFileName), html, Encoding.UTF8);
        await File.WriteAllTextAsync(Path.Combine(exportDir, wordFileName), html, Encoding.UTF8);
        AddAuditLog("EXPORT", "ImprovementExport", Guid.Empty, $"Informe generado: {title} ({htmlFileName}, {wordFileName})");
        await DbContext.SaveChangesAsync();
        lastExportTitle = title;
        lastExportUrl = $"/api/exports/{Uri.EscapeDataString(htmlFileName)}";
        lastExportWordUrl = $"/api/exports/{Uri.EscapeDataString(wordFileName)}";
        successMessage = $"Informe generado: {title}.";
        errorMessage = null;
    }

    private string GetImprovementExportDirectory()
    {
        var configured = Configuration["ImprovementExports:Path"];
        if (!string.IsNullOrWhiteSpace(configured))
        {
            return configured;
        }

        var documentRoot = Configuration["DocumentStorage:RootPath"];
        if (!string.IsNullOrWhiteSpace(documentRoot))
        {
            return Path.Combine(documentRoot, "Exports");
        }

        return Path.Combine(WebHostEnvironment.ContentRootPath, "App_Data", "Exports");
    }

    private static string BuildHtmlReport(string title, string body)
    {
        var html = new StringBuilder();
        html.AppendLine("<!doctype html>");
        html.AppendLine("<html lang=\"es\">");
        html.AppendLine("<head>");
        html.AppendLine("<meta charset=\"utf-8\">");
        html.AppendLine($"<title>{E(title)}</title>");
        html.AppendLine("<style>");
        html.AppendLine("body { font-family: Arial, sans-serif; margin: 32px; color: #111827; }");
        html.AppendLine("h1 { border-bottom: 2px solid #2563eb; padding-bottom: 8px; }");
        html.AppendLine("table { border-collapse: collapse; width: 100%; margin-top: 16px; }");
        html.AppendLine("th, td { border: 1px solid #d1d5db; padding: 8px; vertical-align: top; }");
        html.AppendLine("th { background: #eff6ff; text-align: left; }");
        html.AppendLine(".meta { color: #6b7280; font-size: 12px; margin-bottom: 24px; }");
        html.AppendLine("section { margin-top: 20px; }");
        html.AppendLine("</style>");
        html.AppendLine("</head>");
        html.AppendLine("<body>");
        html.AppendLine($"<h1>{E(title)}</h1>");
        html.AppendLine($"<div class=\"meta\">Generado: {DateTime.Now:dd/MM/yyyy HH:mm} | QMSFlowDoc ISO 15189</div>");
        html.AppendLine(body);
        html.AppendLine("</body>");
        html.AppendLine("</html>");
        return html.ToString();
    }

    private static string TableHtml(string pipeHeaders, IEnumerable<string> rows)
    {
        var headers = string.Join("", pipeHeaders.Split('|').Select(h => $"<th>{E(h)}</th>"));
        return $"<table><thead><tr>{headers}</tr></thead><tbody>{string.Join("", rows)}</tbody></table>";
    }

    private static string SectionHtml(string title, string body) => $"<section><h2>{E(title)}</h2>{body}</section>";

