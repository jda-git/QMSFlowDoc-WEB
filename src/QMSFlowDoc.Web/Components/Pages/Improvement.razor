@page "/improvement"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity
@using System.Net
@using System.Text
@using QMSFlowDoc.Application.Services.Identity
@using QMSFlowDoc.Application.Services.Quality
@using QMSFlowDoc.Domain.Entities
@using QMSFlowDoc.Domain.Identity
@using QMSFlowDoc.Infrastructure.Persistence
@using QMSFlowDoc.Shared.DTOs
@inject QmsDbContext DbContext
@inject IPermissionService PermissionService
@inject IQualityService QualityService
@inject IWebHostEnvironment WebHostEnvironment
@inject IConfiguration Configuration
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Mejora Continua ISO - QMSFlowDoc</PageTitle>

<div class="container-fluid py-4 px-4 improvement-page">
    @if (!isAuthorized)
    {
        <div class="alert alert-danger rounded-4 shadow-sm p-4">
            <h4 class="fw-bold mb-1">Acceso denegado</h4>
            <p class="mb-0">Solo perfiles de calidad, dirección o administración pueden gestionar mejora continua ISO 15189.</p>
        </div>
    }
    else
    {
        <div class="improvement-header d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-1"><i class="bi bi-clipboard2-check text-primary me-2"></i>Mejora Continua ISO</h2>
                <p class="text-muted mb-0">Riesgos, auditorías internas, revisión por dirección y evaluación de proveedores.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success py-2 small">@successMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2 small">@errorMessage</div>
        }
        @if (canApproveImprovement)
        {
            <div class="improvement-approval row mb-4">
                <div class="col-lg-5">
                    <label class="form-label small fw-semibold text-secondary mb-1">Firma electronica para aprobaciones</label>
                    <input type="password" class="form-control" placeholder="Contraseña del usuario actual para aprobar/cerrar" @bind="approvalPassword" autocomplete="current-password" />
                </div>
            </div>
        }

        <ul class="nav nav-tabs custom-tabs improvement-tabs mb-4 border-bottom-0">
            <li class="nav-item"><button class="nav-link @(activeTab == "risks" ? "active" : "")" @onclick='() => activeTab = "risks"'><i class="bi bi-exclamation-diamond me-2"></i>Riesgos</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "audits" ? "active" : "")" @onclick='() => activeTab = "audits"'><i class="bi bi-clipboard-check me-2"></i>Auditorías internas</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "reviews" ? "active" : "")" @onclick='() => activeTab = "reviews"'><i class="bi bi-people me-2"></i>Revisión dirección</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "indicators" ? "active" : "")" @onclick='() => activeTab = "indicators"'><i class="bi bi-graph-up-arrow me-2"></i>Indicadores</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "suppliers" ? "active" : "")" @onclick='() => activeTab = "suppliers"'><i class="bi bi-truck me-2"></i>Proveedores</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "control" ? "active" : "")" @onclick='() => activeTab = "control"'><i class="bi bi-sliders me-2"></i>Control ISO</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "impartiality" ? "active" : "")" @onclick='() => activeTab = "impartiality"'><i class="bi bi-shield-check me-2"></i>Imparcialidad</button></li>
        </ul>

        @if (activeTab == "impartiality")
        {
            <section class="row g-4">
                <div class="col-lg-5"><div class="improvement-form"><h5 class="fw-bold mb-3">Declaración de imparcialidad</h5>
                    <input class="form-control mb-2" placeholder="Persona que declara" @bind="impartialityModel.DeclarantName" />
                    <input class="form-control mb-2" placeholder="Ámbito o actividad afectada" @bind="impartialityModel.Scope" />
                    <textarea class="form-control mb-2" rows="3" placeholder="Conflicto o riesgo identificado" @bind="impartialityModel.Description"></textarea>
                    <textarea class="form-control mb-2" rows="2" placeholder="Medida de mitigación" @bind="impartialityModel.Mitigation"></textarea>
                    <button class="btn btn-primary" @onclick="SaveImpartiality">Registrar declaración</button>
                </div></div>
                <div class="col-lg-7"><div class="improvement-card"><h5 class="fw-bold mb-3">Registro y revisión</h5><table class="table table-sm"><thead><tr><th>Fecha</th><th>Declarante</th><th>Ámbito</th><th>Estado</th><th></th></tr></thead><tbody>@foreach (var item in impartialityDeclarations) { <tr><td>@item.DeclaredAt.ToLocalTime().ToString("d")</td><td>@item.DeclarantName</td><td>@item.Scope</td><td>@item.Status</td><td>@if (item.Status == ImpartialityStatus.DECLARED) { <button class="btn btn-sm btn-outline-success" @onclick="() => ReviewImpartiality(item)">Revisar</button> }</td></tr> }</tbody></table></div></div>
            </section>
        }

        @if (activeTab == "risks")
        {
            <section class="row g-4">
                <div class="col-lg-4">
                    <div class="improvement-form">
                        <h5 class="fw-bold mb-3">Nuevo riesgo</h5>
                        <label class="form-label small fw-semibold text-secondary mb-1">Título del riesgo</label>
                        <input class="form-control mb-2" placeholder="Título" @bind="riskModel.Title" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Descripción</label>
                        <textarea class="form-control mb-2" rows="3" placeholder="Descripción" @bind="riskModel.Description"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Categoría</label>
                        <input class="form-control mb-2" placeholder="Categoría" @bind="riskModel.Category" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Probabilidad</label>
                        <select class="form-select mb-2" @bind="riskModel.Likelihood">
                            @foreach (var v in Enum.GetValues<RiskLikelihood>()) { <option value="@v">@GetRiskLikelihoodLabel(v)</option> }
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Impacto</label>
                        <select class="form-select mb-2" @bind="riskModel.Impact">
                            @foreach (var v in Enum.GetValues<RiskImpact>()) { <option value="@v">@GetRiskImpactLabel(v)</option> }
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Plan de mitigación</label>
                        <textarea class="form-control mb-3" rows="2" placeholder="Plan de mitigación" @bind="riskModel.MitigationPlan"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Oportunidad de mejora asociada</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Oportunidad de mejora asociada" @bind="riskModel.Opportunity"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Acción planificada</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Acción planificada" @bind="riskModel.ActionPlan"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Responsable</label>
                        <input class="form-control mb-2" placeholder="Responsable" @bind="riskModel.Responsible" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha límite</label>
                        <input type="date" class="form-control mb-2" @bind="riskModel.DueDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Riesgo residual</label>
                        <div class="row g-2 mb-2">
                            <div class="col">
                                <select class="form-select" value="@GetNullableEnumValue(riskModel.ResidualLikelihood)" @onchange="OnResidualLikelihoodChanged">
                                    <option value="">Probabilidad residual</option>
                                    @foreach (var v in Enum.GetValues<RiskLikelihood>()) { <option value="@((int)v)">@GetRiskLikelihoodLabel(v)</option> }
                                </select>
                            </div>
                            <div class="col">
                                <select class="form-select" value="@GetNullableEnumValue(riskModel.ResidualImpact)" @onchange="OnResidualImpactChanged">
                                    <option value="">Impacto residual</option>
                                    @foreach (var v in Enum.GetValues<RiskImpact>()) { <option value="@((int)v)">@GetRiskImpactLabel(v)</option> }
                                </select>
                            </div>
                        </div>
                        @if (riskModel.ResidualRiskScore.HasValue)
                        {
                            <div class="small mb-2">
                                Riesgo residual calculado:
                                <span class="badge @GetRiskScoreBadgeClass(riskModel.ResidualRiskScore.Value)">
                                    @riskModel.ResidualRiskScore.Value - @GetRiskScoreLevel(riskModel.ResidualRiskScore.Value)
                                </span>
                            </div>
                        }
                        <label class="form-label small fw-semibold text-secondary mb-1">Revisión de eficacia / aceptación</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Revisión de eficacia / aceptación" @bind="riskModel.EffectivenessReview"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha de revisión de eficacia</label>
                        <input type="date" class="form-control mb-2" @bind="riskModel.EffectivenessReviewDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Evidencia documental vinculada</label>
                        <select class="form-select mb-2" value="@GetNullableGuidValue(riskModel.EvidenceDocumentId)" @onchange="e => riskModel.EvidenceDocumentId = ParseNullableGuid(e.Value?.ToString())">
                            <option value="">Sin documento vinculado</option>
                            @foreach (var d in evidenceDocuments) { <option value="@d.Id">@GetDocumentLabel(d)</option> }
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Notas de aprobación/cierre formal</label>
                        <textarea class="form-control mb-3" rows="2" placeholder="Justificación de aceptación o cierre por responsable autorizado" @bind="riskModel.ApprovalNotes"></textarea>
                        <button class="btn btn-primary w-100" @onclick="SaveRisk">@(riskModel.Id == Guid.Empty ? "Registrar riesgo" : "Actualizar riesgo")</button>
                        @if (riskModel.Id != Guid.Empty)
                        {
                            <button class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelRiskEdit">Cancelar edicion</button>
                        }
                    </div>
                </div>
                <div class="col-lg-8">
                    <TableCard Title="Matriz de riesgos">
                        <thead><tr><th>Riesgo</th><th>Categoría</th><th>Score</th><th>Residual</th><th>Responsable</th><th>Plazo</th><th>Estado</th><th>Evidencia/Aprobación</th><th>Acción/Eficacia</th><th>Actualizar</th></tr></thead>
                        <tbody>
                        @foreach (var r in risks)
                        {
                            <tr>
                                <td>@r.Title</td>
                                <td>@r.Category</td>
                                <td><span class="badge @GetRiskScoreBadgeClass(r.RiskScore)">@r.RiskScore - @GetRiskScoreLevel(r.RiskScore)</span></td>
                                <td>
                                    @if (r.ResidualRiskScore.HasValue)
                                    {
                                        <span class="badge @GetRiskScoreBadgeClass(r.ResidualRiskScore.Value)">
                                            @r.ResidualRiskScore.Value - @GetRiskScoreLevel(r.ResidualRiskScore.Value)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pendiente</span>
                                    }
                                </td>
                                <td>@(r.Responsible ?? r.OwnerName)</td>
                                <td>@(r.DueDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@GetRiskStatusLabel(r.Status)</td>
                                <td>
                                    <div><small>@GetDocumentLabel(r.EvidenceDocumentId)</small></div>
                                    <span class="badge @(r.ApprovedAt.HasValue ? "bg-success" : "bg-secondary")">@(r.ApprovedAt.HasValue ? $"Aprobado {r.ApprovedAt.Value:dd/MM/yyyy}" : "Sin aprobación")</span>
                                </td>
                                <td>
                                    <span class="badge @GetRiskActionBadgeClass(r) mb-1">@GetRiskActionStatusLabel(r)</span>
                                    <div>@(string.IsNullOrWhiteSpace(r.ActionPlan) ? r.MitigationPlan : r.ActionPlan)</div>
                                    @if (!string.IsNullOrWhiteSpace(r.EffectivenessReview))
                                    {
                                        <small class="text-success">@r.EffectivenessReview</small>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditRisk(r)">Editar</button>
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => ApproveRisk(r)">Aprobar</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick='() => ShowHistory("Risk", r.Id, r.Title)'>Historial</button>
                                        <select class="form-select form-select-sm" value="@r.Status" @onchange="e => UpdateRiskStatus(r, e.Value?.ToString())">
                                            @foreach (var v in Enum.GetValues<RiskStatus>()) { <option value="@v">@GetRiskStatusLabel(v)</option> }
                                        </select>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </TableCard>
                </div>
            </section>
        }

        @if (activeTab == "audits")
        {
            <section class="row g-4">
                <div class="col-lg-4">
                    <div class="improvement-form">
                        <h5 class="fw-bold mb-3">Planificar auditoría</h5>
                        <label class="form-label small fw-semibold text-secondary mb-1">Título de la auditoría</label>
                        <input class="form-control mb-2" placeholder="Título" @bind="auditModel.Title" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha programada</label>
                        <input type="date" class="form-control mb-2" @bind="auditModel.ScheduledDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Año del programa anual</label>
                        <input type="number" class="form-control mb-2" @bind="auditModel.ProgramYear" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Alcance</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Alcance" @bind="auditModel.Scope"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Objetivos de la auditoría</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Objetivos de la auditoría" @bind="auditModel.Objectives"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Criterios / requisitos auditados</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Criterios / requisitos auditados" @bind="auditModel.Criteria"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Checklist o puntos verificados</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Checklist o puntos verificados" @bind="auditModel.ChecklistJson"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Auditor líder</label>
                        <input class="form-control mb-2" placeholder="Auditor líder" @bind="auditModel.LeadAuditor" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Equipo auditor</label>
                        <input class="form-control mb-2" placeholder="Auditores internos asignados" @bind="auditModel.InternalAuditors" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Independencia del auditor</label>
                        <textarea class="form-control mb-3" rows="2" placeholder="Declaración de independencia e imparcialidad respecto al proceso auditado" @bind="auditModel.AuditorIndependenceStatement"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Informe / resumen de auditoría</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Informe/resumen de auditoría" @bind="auditModel.SummaryReport"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Conclusiones</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Conclusiones" @bind="auditModel.Conclusions"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Seguimiento de acciones</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Seguimiento de acciones" @bind="auditModel.FollowUpActions"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Informe/evidencia documental</label>
                        <select class="form-select mb-2" value="@GetNullableGuidValue(auditModel.ReportDocumentId)" @onchange="e => auditModel.ReportDocumentId = ParseNullableGuid(e.Value?.ToString())">
                            <option value="">Sin documento vinculado</option>
                            @foreach (var d in evidenceDocuments) { <option value="@d.Id">@GetDocumentLabel(d)</option> }
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Notas de aprobación formal</label>
                        <textarea class="form-control mb-3" rows="2" placeholder="Aprobación del informe/programa por responsable autorizado" @bind="auditModel.ApprovalNotes"></textarea>
                        <button class="btn btn-primary w-100" @onclick="SaveAudit">@(auditModel.Id == Guid.Empty ? "Crear plan" : "Actualizar auditoria")</button>
                        @if (auditModel.Id != Guid.Empty)
                        {
                            <button class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelAuditEdit">Cancelar edicion</button>
                        }

                        <hr class="my-4" />

                        <h5 class="fw-bold mb-3">Registrar hallazgo</h5>
                        <label class="form-label small fw-semibold text-secondary mb-1">Auditoría asociada</label>
                        <select class="form-select mb-2" @bind="findingModel.AuditPlanId">
                            <option value="@Guid.Empty">Seleccione auditoría</option>
                            @foreach (var a in audits) { <option value="@a.Id">@a.Title</option> }
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Descripción del hallazgo</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Descripción del hallazgo" @bind="findingModel.Description"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Requisito ISO 15189</label>
                        <input class="form-control mb-2" placeholder="Requisito ISO 15189, ej. 8.8" @bind="findingModel.IsoRequirement" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Responsable del seguimiento</label>
                        <input class="form-control mb-2" placeholder="Responsable del seguimiento" @bind="findingModel.Responsible" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha prevista de cierre</label>
                        <input type="date" class="form-control mb-2" @bind="findingModel.DueDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Revisión de eficacia del hallazgo / acción</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Revisión de eficacia del hallazgo/acción" @bind="findingModel.EffectivenessReview"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Evidencia documental del hallazgo</label>
                        <select class="form-select mb-2" value="@GetNullableGuidValue(findingModel.EvidenceDocumentId)" @onchange="e => findingModel.EvidenceDocumentId = ParseNullableGuid(e.Value?.ToString())">
                            <option value="">Sin documento vinculado</option>
                            @foreach (var d in evidenceDocuments) { <option value="@d.Id">@GetDocumentLabel(d)</option> }
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Tipo de hallazgo</label>
                        <select class="form-select mb-3" @bind="findingModel.Type">
                            @foreach (var v in Enum.GetValues<FindingType>()) { <option value="@v">@GetFindingTypeLabel(v)</option> }
                        </select>
                        <button class="btn btn-outline-primary w-100" @onclick="SaveAuditFinding" disabled="@(findingModel.AuditPlanId == Guid.Empty)">@(findingModel.Id == Guid.Empty ? "Registrar hallazgo" : "Actualizar hallazgo")</button>
                        @if (findingModel.Id != Guid.Empty)
                        {
                            <button class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelFindingEdit">Cancelar edicion</button>
                        }
                    </div>
                </div>
                <div class="col-lg-8">
                    <TableCard Title="Programa anual de auditorías">
                        <thead><tr><th>Año/Fecha</th><th>Título</th><th>Alcance</th><th>Auditor</th><th>Evidencia/Aprobación</th><th>Estado</th><th>Actualizar</th></tr></thead>
                        <tbody>
                        @foreach (var a in audits)
                        {
                            <tr>
                                <td>@a.ProgramYear<br /><small>@a.ScheduledDate.ToString("dd/MM/yyyy")</small></td>
                                <td>@a.Title</td>
                                <td>@a.Scope</td>
                                <td>@a.LeadAuditor</td>
                                <td>
                                    @if (AuditHasCompletionEvidence(a))
                                    {
                                        <span class="badge bg-success">Completa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                    <div><small>@GetDocumentLabel(a.ReportDocumentId)</small></div>
                                    <span class="badge @(a.ApprovedAt.HasValue ? "bg-success" : "bg-secondary")">@(a.ApprovedAt.HasValue ? $"Aprobada {a.ApprovedAt.Value:dd/MM/yyyy}" : "Sin aprobación")</span>
                                </td>
                                <td>
                                    @GetAuditStatusLabel(a.Status)
                                    @if (AuditHasUnlinkedNonconformityFindings(a.Id))
                                    {
                                        <span class="badge bg-danger ms-2">NC pendiente</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditAudit(a)">Editar</button>
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => ApproveAudit(a)">Aprobar</button>
                                        <button class="btn btn-sm btn-outline-dark" @onclick="() => ExportAuditReport(a)">Informe</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick='() => ShowHistory("AuditPlan", a.Id, a.Title)'>Historial</button>
                                        <select class="form-select form-select-sm" value="@a.Status" @onchange="e => UpdateAuditStatus(a, e.Value?.ToString())">
                                            @foreach (var v in Enum.GetValues<AuditStatus>()) { <option value="@v">@GetAuditStatusLabel(v)</option> }
                                        </select>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </TableCard>

                    <div class="mt-4">
                        <TableCard Title="Hallazgos de auditoría">
                            <thead><tr><th>Auditoría</th><th>Tipo</th><th>ISO</th><th>Descripción</th><th>Evidencia</th><th>NC vinculada</th><th>Seguimiento</th><th>Acción</th></tr></thead>
                            <tbody>
                            @foreach (var f in auditFindings)
                            {
                                <tr>
                                    <td>@GetAuditTitle(f.AuditPlanId)</td>
                                    <td>@GetFindingTypeLabel(f.Type)</td>
                                    <td>@f.IsoRequirement</td>
                                    <td>@f.Description</td>
                                    <td><small>@GetDocumentLabel(f.EvidenceDocumentId)</small></td>
                                    <td>
                                        @if (f.RelatedNCId.HasValue)
                                        {
                                            <span class="badge bg-success">NC creada</span>
                                        }
                                        else if (IsNonconformityFinding(f.Type))
                                        {
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No aplica</span>
                                        }
                                    </td>
                                    <td><span class="badge @GetAuditFindingBadgeClass(f)">@GetAuditFindingStatusLabel(f)</span></td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditAuditFinding(f)">Editar</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick='() => ShowHistory("AuditFinding", f.Id, f.Description)'>Historial</button>
                                            @if (IsNonconformityFinding(f.Type) && !f.RelatedNCId.HasValue)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => CreateNCFromFinding(f)">Crear NC</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </TableCard>
                    </div>
                </div>
            </section>
        }

        @if (activeTab == "reviews")
        {
            <section class="row g-4">
                <div class="col-lg-4">
                    <div class="improvement-form">
                        <h5 class="fw-bold mb-3">Nueva revisión por dirección</h5>
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha de revisión</label>
                        <input type="date" class="form-control mb-2" @bind="reviewModel.ReviewDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Participantes</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Participantes" @bind="reviewModel.Participants"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Agenda</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Agenda" @bind="reviewModel.Agenda"></textarea>
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 mb-2" @onclick="UseIsoInputsInReviewAgenda">Usar entradas ISO en agenda</button>
                        <label class="form-label small fw-semibold text-secondary mb-1">Seguimiento de acciones previas</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Seguimiento de acciones previas" @bind="reviewModel.PreviousActionsReview"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Cambios que afectan al SGC</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Cambios que afectan al SGC" @bind="reviewModel.ChangesAffectingQms"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Necesidades de recursos</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Necesidades de recursos" @bind="reviewModel.ResourceNeeds"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Revisión de indicadores de calidad</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Revisión de indicadores de calidad" @bind="reviewModel.QualityIndicatorsReview"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Desempeño de proveedores externos</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Desempeño de proveedores externos" @bind="reviewModel.ExternalProviderPerformance"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Resumen</label>
                        <textarea class="form-control mb-2" rows="3" placeholder="Resumen" @bind="reviewModel.Summary"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Decisiones y conclusiones</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Decisiones y conclusiones" @bind="reviewModel.Decisions"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Oportunidades de mejora aprobadas</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Oportunidades de mejora aprobadas" @bind="reviewModel.ImprovementOpportunities"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Acciones acordadas</label>
                        <textarea class="form-control mb-3" rows="2" placeholder="Acciones acordadas" @bind="reviewModel.Actions"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Responsable de acciones</label>
                        <input class="form-control mb-2" placeholder="Responsable de acciones" @bind="reviewModel.ActionOwner" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha límite de acciones</label>
                        <input type="date" class="form-control mb-2" @bind="reviewModel.ActionDueDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Seguimiento / eficacia de acciones de dirección</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Seguimiento / eficacia de acciones de dirección" @bind="reviewModel.EffectivenessReview"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Acta/evidencia documental</label>
                        <select class="form-select mb-2" value="@GetNullableGuidValue(reviewModel.MinutesDocumentId)" @onchange="e => reviewModel.MinutesDocumentId = ParseNullableGuid(e.Value?.ToString())">
                            <option value="">Sin documento vinculado</option>
                            @foreach (var d in evidenceDocuments) { <option value="@d.Id">@GetDocumentLabel(d)</option> }
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Notas de aprobación formal</label>
                        <textarea class="form-control mb-3" rows="2" placeholder="Aprobación/cierre de la revisión por dirección" @bind="reviewModel.ApprovalNotes"></textarea>
                        <button class="btn btn-primary w-100" @onclick="SaveReview">@(reviewModel.Id == Guid.Empty ? "Registrar revision" : "Actualizar revision")</button>
                        @if (reviewModel.Id != Guid.Empty)
                        {
                            <button class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelReviewEdit">Cancelar edicion</button>
                        }
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="mb-4">
                        <TableCard Title="Entradas ISO para revisión">
                            <thead><tr><th>Entrada</th><th>Situación actual</th></tr></thead>
                            <tbody>
                                <tr><td>Riesgos activos</td><td><span class="badge bg-secondary">@activeRiskCount</span></td></tr>
                                <tr><td>Riesgos altos o críticos</td><td><span class="badge @GetWarningBadgeClass(highRiskCount)">@highRiskCount</span></td></tr>
                                <tr><td>Acciones de riesgo vencidas</td><td><span class="badge @GetWarningBadgeClass(overdueRiskActionCount)">@overdueRiskActionCount</span></td></tr>
                                <tr><td>No conformidades abiertas</td><td><span class="badge @GetWarningBadgeClass(openNcCount)">@openNcCount</span></td></tr>
                                <tr><td>Reclamaciones abiertas</td><td><span class="badge @GetWarningBadgeClass(openComplaintCount)">@openComplaintCount</span></td></tr>
                                <tr><td>CAPA abiertas / vencidas</td><td><span class="badge @GetWarningBadgeClass(openCapaCount)">@openCapaCount / @overdueCapaCount</span></td></tr>
                                <tr><td>Indicadores fuera de objetivo</td><td><span class="badge @GetWarningBadgeClass(indicatorOutOfTargetCount)">@indicatorOutOfTargetCount</span></td></tr>
                                <tr><td>Acciones de indicadores vencidas</td><td><span class="badge @GetWarningBadgeClass(overdueIndicatorActionCount)">@overdueIndicatorActionCount</span></td></tr>
                                <tr><td>Acciones de direccion abiertas / vencidas</td><td><span class="badge @GetWarningBadgeClass(openReviewActionCount)">@openReviewActionCount / @overdueReviewActionCount</span></td></tr>
                                <tr><td>Equipos no aptos o restringidos</td><td><span class="badge @GetWarningBadgeClass(equipmentAttentionCount)">@equipmentAttentionCount</span></td></tr>
                                <tr><td>EQA con revisión o acción pendiente</td><td><span class="badge @GetWarningBadgeClass(eqaAttentionCount)">@eqaAttentionCount</span></td></tr>
                                <tr><td>Desviaciones EQA abiertas</td><td><span class="badge @GetWarningBadgeClass(openEqaDeviationCount)">@openEqaDeviationCount</span></td></tr>
                                <tr><td>Auditorías planificadas/en curso</td><td><span class="badge bg-info text-dark">@plannedOrInProgressAuditCount</span></td></tr>
                                <tr><td>Hallazgos NC sin vincular</td><td><span class="badge @GetWarningBadgeClass(pendingAuditNcFindingCount)">@pendingAuditNcFindingCount</span></td></tr>
                                <tr><td>Hallazgos de auditoría vencidos</td><td><span class="badge @GetWarningBadgeClass(overdueAuditFindingCount)">@overdueAuditFindingCount</span></td></tr>
                                <tr><td>Proveedores con atencion</td><td><span class="badge @GetWarningBadgeClass(supplierAttentionCount)">@supplierAttentionCount</span></td></tr>
                                <tr><td>Reevaluaciones de proveedores vencidas</td><td><span class="badge @GetWarningBadgeClass(overdueSupplierReevaluationCount)">@overdueSupplierReevaluationCount</span></td></tr>
                            </tbody>
                        </TableCard>
                    </div>
                    <TableCard Title="Revisiones por dirección">
                        <thead><tr><th>Fecha</th><th>Participantes</th><th>Resumen</th><th>Decisiones</th><th>Acciones</th><th>Responsable/Plazo</th><th>Seguimiento</th></tr></thead>
                        <tbody>
                        @foreach (var r in reviews)
                        {
                            <tr><td>@r.ReviewDate.ToString("dd/MM/yyyy")</td><td>@r.Participants</td><td>@r.Summary</td><td>@r.Decisions</td><td>@r.Actions</td><td>@r.ActionOwner @(r.ActionDueDate.HasValue ? $"({r.ActionDueDate.Value:dd/MM/yyyy})" : "")<div><small>@GetDocumentLabel(r.MinutesDocumentId)</small></div><span class="badge @(r.ApprovedAt.HasValue ? "bg-success" : "bg-secondary")">@(r.ApprovedAt.HasValue ? $"Aprobada {r.ApprovedAt.Value:dd/MM/yyyy}" : "Sin aprobación")</span></td><td><span class="badge @GetReviewActionBadgeClass(r) me-2">@GetReviewActionStatusLabel(r)</span><div class="d-flex flex-wrap gap-2 mt-1"><button class="btn btn-sm btn-outline-primary" @onclick="() => EditReview(r)">Editar</button><button class="btn btn-sm btn-outline-success" @onclick="() => ApproveReview(r)">Aprobar</button><button class="btn btn-sm btn-outline-dark" @onclick="() => ExportReviewReport(r)">Acta</button><button class="btn btn-sm btn-outline-secondary" @onclick='() => ShowHistory("ManagementReview", r.Id, r.ReviewDate.ToString("dd/MM/yyyy"))'>Historial</button></div></td></tr>
                        }
                        </tbody>
                    </TableCard>
                </div>
            </section>
        }

        @if (activeTab == "indicators")
        {
            <section class="row g-4">
                <div class="col-lg-4">
                    <div class="improvement-form">
                        <h5 class="fw-bold mb-3">Nuevo indicador</h5>
                        <label class="form-label small fw-semibold text-secondary mb-1">Nombre del indicador</label>
                        <input class="form-control mb-2" placeholder="Nombre del indicador" @bind="indicatorModel.Name" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Área / proceso</label>
                        <input class="form-control mb-2" placeholder="Área/proceso" @bind="indicatorModel.Area" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Periodo evaluado</label>
                        <input class="form-control mb-2" placeholder="Periodo evaluado" @bind="indicatorModel.Period" />
                        <div class="row g-2 mb-2">
                            <div class="col">
                                <label class="form-label small fw-semibold text-secondary mb-1">Objetivo</label>
                                <input type="number" step="0.01" class="form-control" placeholder="Objetivo" @bind="indicatorModel.TargetValue" />
                            </div>
                            <div class="col">
                                <label class="form-label small fw-semibold text-secondary mb-1">Resultado</label>
                                <input type="number" step="0.01" class="form-control" placeholder="Resultado" @bind="indicatorModel.ActualValue" />
                            </div>
                        </div>
                        <label class="form-label small fw-semibold text-secondary mb-1">Regla de cumplimiento</label>
                        <select class="form-select mb-2" @bind="indicatorModel.TargetRule">
                            <option value="Maximo">Cumple si resultado &lt;= objetivo</option>
                            <option value="Minimo">Cumple si resultado &gt;= objetivo</option>
                            <option value="Igual">Cumple si resultado = objetivo</option>
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Unidad</label>
                        <input class="form-control mb-2" placeholder="Unidad, ej. %, días, n" @bind="indicatorModel.Unit" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Tendencia</label>
                        <select class="form-select mb-2" @bind="indicatorModel.Trend">
                            <option>Mejora</option>
                            <option>Estable</option>
                            <option>Empeora</option>
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Análisis de resultado / tendencia</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Análisis de resultado/tendencia" @bind="indicatorModel.Analysis"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Acción si no cumple objetivo</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Acción si no cumple objetivo" @bind="indicatorModel.ActionPlan"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Responsable</label>
                        <input class="form-control mb-2" placeholder="Responsable" @bind="indicatorModel.Responsible" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha límite</label>
                        <input type="date" class="form-control mb-2" @bind="indicatorModel.DueDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Revisión de eficacia de la acción</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Evidencia de cierre/eficacia de la acción" @bind="indicatorModel.EffectivenessReview"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha de revisión de eficacia</label>
                        <input type="date" class="form-control mb-2" @bind="indicatorModel.EffectivenessReviewDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Evidencia documental vinculada</label>
                        <select class="form-select mb-2" value="@GetNullableGuidValue(indicatorModel.EvidenceDocumentId)" @onchange="e => indicatorModel.EvidenceDocumentId = ParseNullableGuid(e.Value?.ToString())">
                            <option value="">Sin documento vinculado</option>
                            @foreach (var d in evidenceDocuments) { <option value="@d.Id">@GetDocumentLabel(d)</option> }
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Notas de aprobación/cierre formal</label>
                        <textarea class="form-control mb-3" rows="2" placeholder="Aprobación o cierre del seguimiento del indicador" @bind="indicatorModel.ApprovalNotes"></textarea>
                        <button class="btn btn-primary w-100" @onclick="SaveQualityIndicator">@(indicatorModel.Id == Guid.Empty ? "Registrar indicador" : "Actualizar indicador")</button>
                        @if (indicatorModel.Id != Guid.Empty)
                        {
                            <button class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelIndicatorEdit">Cancelar edicion</button>
                        }
                    </div>
                </div>
                <div class="col-lg-8">
                    <TableCard Title="Indicadores de calidad">
                        <thead><tr><th>Periodo</th><th>Indicador</th><th>Área</th><th>Objetivo</th><th>Resultado</th><th>Tendencia</th><th>Análisis / Acción</th><th>Evidencia/Aprobación</th><th>Seguimiento</th></tr></thead>
                        <tbody>
                        @foreach (var i in qualityIndicators)
                        {
                            <tr>
                                <td>@i.Period</td>
                                <td>@i.Name</td>
                                <td>@i.Area</td>
                                <td>@i.TargetValue.ToString("N2") @i.Unit</td>
                                <td><span class="badge @(i.MeetsTarget ? "bg-success" : "bg-warning text-dark")">@i.ActualValue.ToString("N2") @i.Unit</span></td>
                                <td>@i.Trend</td>
                                <td>
                                    <div>@i.Analysis</div>
                                    @if (!string.IsNullOrWhiteSpace(i.ActionPlan))
                                    {
                                        <small class="text-primary">@i.ActionPlan</small>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(i.EffectivenessReview))
                                    {
                                        <div><small class="text-success">Eficacia: @i.EffectivenessReview @(i.EffectivenessReviewDate.HasValue ? $"({i.EffectivenessReviewDate.Value:dd/MM/yyyy})" : "")</small></div>
                                    }
                                </td>
                                <td><small>@GetDocumentLabel(i.EvidenceDocumentId)</small><br /><span class="badge @(i.ApprovedAt.HasValue ? "bg-success" : "bg-secondary")">@(i.ApprovedAt.HasValue ? $"Aprobado {i.ApprovedAt.Value:dd/MM/yyyy}" : "Sin aprobación")</span></td>
                                <td><span class="badge @GetIndicatorActionBadgeClass(i) me-2">@GetIndicatorActionStatusLabel(i)</span><div class="d-flex flex-wrap gap-2 mt-1"><button class="btn btn-sm btn-outline-primary" @onclick="() => EditIndicator(i)">Editar</button><button class="btn btn-sm btn-outline-success" @onclick="() => ApproveIndicator(i)">Aprobar</button><button class="btn btn-sm btn-outline-dark" @onclick="() => ExportIndicatorReport(i)">Informe</button><button class="btn btn-sm btn-outline-secondary" @onclick='() => ShowHistory("QualityIndicator", i.Id, $"{i.Name} {i.Period}")'>Historial</button></div></td>
                            </tr>
                        }
                        </tbody>
                    </TableCard>
                </div>
            </section>
        }

        @if (activeTab == "suppliers")
        {
            <section class="row g-4">
                <div class="col-lg-4">
                    <div class="improvement-form">
                        <h5 class="fw-bold mb-3">Evaluar proveedor</h5>
                        <label class="form-label small fw-semibold text-secondary mb-1">Proveedor</label>
                        <select class="form-select mb-2" @bind="supplierEvalModel.SupplierId">
                            <option value="@Guid.Empty">Seleccione proveedor</option>
                            @foreach (var s in suppliers) { <option value="@s.Id">@s.Name</option> }
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Periodo evaluado</label>
                        <input class="form-control mb-2" placeholder="Periodo evaluado" @bind="supplierEvalModel.EvaluatedPeriod" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Alcance / producto o servicio evaluado</label>
                        <input class="form-control mb-2" placeholder="Alcance/producto o servicio evaluado" @bind="supplierEvalModel.Scope" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Evaluador</label>
                        <input class="form-control mb-2" placeholder="Evaluador" @bind="supplierEvalModel.EvaluatorName" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Criticidad</label>
                        <select class="form-select mb-2" @bind="supplierEvalModel.Criticality">
                            <option>Baja</option>
                            <option>Media</option>
                            <option>Alta</option>
                            <option>Crítica</option>
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha de evaluación</label>
                        <input type="date" class="form-control mb-2" @bind="supplierEvalModel.EvaluationDate" />
                        <div class="row g-2 mb-2">
                            <div class="col">
                                <label class="form-label small fw-semibold text-secondary mb-1">Plazos</label>
                                <input type="number" min="1" max="5" class="form-control" @bind="supplierEvalModel.ScorePlazos" />
                            </div>
                            <div class="col">
                                <label class="form-label small fw-semibold text-secondary mb-1">Calidad</label>
                                <input type="number" min="1" max="5" class="form-control" @bind="supplierEvalModel.ScoreCalidad" />
                            </div>
                            <div class="col">
                                <label class="form-label small fw-semibold text-secondary mb-1">Servicio</label>
                                <input type="number" min="1" max="5" class="form-control" @bind="supplierEvalModel.ScoreServicio" />
                            </div>
                            <div class="col">
                                <label class="form-label small fw-semibold text-secondary mb-1">Incidencias</label>
                                <input type="number" min="1" max="5" class="form-control" @bind="supplierEvalModel.ScoreIncidencias" />
                            </div>
                        </div>
                        <label class="form-label small fw-semibold text-secondary mb-1">Decisión</label>
                        <select class="form-select mb-2" @bind="supplierEvalModel.Decision">
                            <option>Aprobado</option>
                            <option>Aprobado con restricciones</option>
                            <option>Reevaluar</option>
                            <option>No aprobado</option>
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Acciones derivadas</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Acciones derivadas si hay restricciones/no aprobación" @bind="supplierEvalModel.CorrectiveActions"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Próxima evaluación</label>
                        <input type="date" class="form-control mb-2" @bind="supplierEvalModel.NextEvaluationDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Observaciones</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Observaciones" @bind="supplierEvalModel.Observations"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Evidencia documental vinculada</label>
                        <select class="form-select mb-3" value="@GetNullableGuidValue(supplierEvalModel.EvidenceDocumentId)" @onchange="e => supplierEvalModel.EvidenceDocumentId = ParseNullableGuid(e.Value?.ToString())">
                            <option value="">Sin documento vinculado</option>
                            @foreach (var d in evidenceDocuments) { <option value="@d.Id">@GetDocumentLabel(d)</option> }
                        </select>
                        <button class="btn btn-primary w-100" @onclick="SaveSupplierEvaluation" disabled="@(supplierEvalModel.SupplierId == Guid.Empty)">@(supplierEvalModel.Id == Guid.Empty ? "Registrar evaluación" : "Actualizar evaluación")</button>
                        @if (supplierEvalModel.Id != Guid.Empty)
                        {
                            <button class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelSupplierEvaluationEdit">Cancelar edicion</button>
                        }
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="mb-4">
                        <TableCard Title="Seguimiento de proveedores">
                            <thead><tr><th>Proveedor</th><th>Tipo</th><th>Estado actual</th><th>Ultima evaluacion</th><th>Proxima evaluacion</th><th>Seguimiento</th></tr></thead>
                            <tbody>
                            @foreach (var supplier in suppliers)
                            {
                                <tr>
                                    <td>@supplier.Name</td>
                                    <td>@GetSupplierTypeLabel(supplier.Type)</td>
                                    <td><span class="badge @GetSupplierStatusBadgeClass(supplier.QualityStatus)">@GetSupplierQualityStatusLabel(supplier.QualityStatus)</span></td>
                                    <td>@(supplier.LastEvaluationDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td>@(supplier.NextEvaluationDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    <td><span class="badge @GetSupplierMonitoringBadgeClass(supplier)">@GetSupplierMonitoringLabel(supplier)</span></td>
                                </tr>
                            }
                            </tbody>
                        </TableCard>
                    </div>
                    <TableCard Title="Evaluaciones de proveedores">
                        <thead><tr><th>Fecha</th><th>Proveedor</th><th>Periodo</th><th>Criticidad</th><th>Media</th><th>Decisión</th><th>Próxima</th><th>Acción</th></tr></thead>
                        <tbody>
                        @foreach (var e in supplierEvaluations)
                        {
                            <tr>
                                <td>@e.EvaluationDate.ToString("dd/MM/yyyy")</td>
                                <td>@e.Supplier?.Name</td>
                                <td>@e.EvaluatedPeriod</td>
                                <td>@e.Criticality</td>
                                <td>@e.AverageScore.ToString("N1")</td>
                                <td><span class="badge @GetSupplierDecisionBadgeClass(e.Decision)">@e.Decision</span></td>
                                <td>@(e.NextEvaluationDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>
                                    <div><small>@GetDocumentLabel(e.EvidenceDocumentId)</small></div>
                                    <div class="d-flex flex-wrap gap-2 mt-1">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditSupplierEvaluation(e)">Editar</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick='() => ShowHistory("SupplierEvaluation", e.Id, e.Supplier?.Name ?? "Proveedor")'>Historial</button>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </TableCard>
                </div>
            </section>
        }

        @if (activeTab == "control")
        {
            <section class="row g-4">
                <div class="col-lg-5">
                    <div class="improvement-form">
                        <h5 class="fw-bold mb-3">Matriz de riesgos configurable</h5>
                        <p class="small text-muted">El score se calcula como probabilidad x impacto. Estos umbrales definen la clasificación y pueden adaptarse al criterio del laboratorio.</p>
                        <div class="row g-2 mb-2">
                            <div class="col">
                                <label class="form-label small fw-semibold text-secondary mb-1">Máximo bajo</label>
                                <input type="number" class="form-control" @bind="riskMatrix.LowMax" />
                            </div>
                            <div class="col">
                                <label class="form-label small fw-semibold text-secondary mb-1">Máximo medio</label>
                                <input type="number" class="form-control" @bind="riskMatrix.MediumMax" />
                            </div>
                            <div class="col">
                                <label class="form-label small fw-semibold text-secondary mb-1">Máximo alto</label>
                                <input type="number" class="form-control" @bind="riskMatrix.HighMax" />
                            </div>
                        </div>
                        <label class="form-label small fw-semibold text-secondary mb-1">Criterios de probabilidad</label>
                        <textarea class="form-control mb-2" rows="4" @bind="riskMatrix.LikelihoodCriteria"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Criterios de impacto</label>
                        <textarea class="form-control mb-2" rows="4" @bind="riskMatrix.ImpactCriteria"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Criterio de aceptación/revisión residual</label>
                        <textarea class="form-control mb-3" rows="3" @bind="riskMatrix.AcceptanceCriteria"></textarea>
                        <button class="btn btn-primary w-100" @onclick="SaveRiskMatrixSettings" disabled="@(!isAdmin)">Guardar matriz</button>
                        @if (!isAdmin)
                        {
                            <div class="small text-muted mt-2">Solo Administrador puede modificar la matriz.</div>
                        }
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="p-3 border rounded-3 bg-white mb-4">
                        <h5 class="fw-bold mb-3">Informes exportables</h5>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-outline-dark" @onclick="ExportRiskMatrixReport">Matriz de riesgos</button>
                            <button class="btn btn-outline-dark" @onclick="ExportAnnualAuditProgramReport">Plan anual auditorías</button>
                            <button class="btn btn-outline-dark" @onclick="ExportSupplierEvaluationReport">Evaluación proveedores</button>
                            <button class="btn btn-outline-dark" @onclick="ExportIndicatorSummaryReport">Indicadores</button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(lastExportUrl))
                        {
                            <div class="alert alert-success mt-3 mb-0 py-2">
                                Informe generado: <a href="@lastExportUrl" target="_blank">@lastExportTitle (HTML)</a>
                                @if (!string.IsNullOrWhiteSpace(lastExportWordUrl))
                                {
                                    <span class="mx-1">|</span>
                                    <a href="@lastExportWordUrl" target="_blank">Word</a>
                                }
                            </div>
                        }
                    </div>

                    <TableCard Title="Historial visible del registro seleccionado">
                        <thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Detalle</th></tr></thead>
                        <tbody>
                        @if (!visibleHistory.Any())
                        {
                            <tr><td colspan="4" class="text-muted">Seleccione Historial en un riesgo, auditoría, hallazgo, revisión, indicador o proveedor.</td></tr>
                        }
                        else
                        {
                            @foreach (var h in visibleHistory)
                            {
                                <tr><td>@h.Timestamp.ToString("dd/MM/yyyy HH:mm")</td><td>@h.UserName</td><td>@h.Action</td><td>@h.Details</td></tr>
                            }
                        }
                        </tbody>
                    </TableCard>
                </div>
            </section>
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool isAuthorized;
    private bool isAdmin;
    private bool canApproveImprovement;
    private string activeTab = "risks";
    private string? successMessage;
    private string? errorMessage;
    private string? lastExportUrl;
    private string? lastExportWordUrl;
    private string? lastExportTitle;
    private string? approvalPassword;
    private Guid? currentUserId;
    private string currentUserName = "Sistema";

    private List<Risk> risks = new();
    private List<ImpartialityDeclaration> impartialityDeclarations = new();
    private List<AuditPlan> audits = new();
    private List<AuditFinding> auditFindings = new();
    private List<ManagementReview> reviews = new();
    private List<QualityIndicator> qualityIndicators = new();
    private List<Supplier> suppliers = new();
    private List<SupplierEvaluation> supplierEvaluations = new();
    private List<Document> evidenceDocuments = new();
    private List<AuditLog> visibleHistory = new();
    private RiskMatrixSettings riskMatrix = RiskMatrixSettings.Default();

    private int activeRiskCount;
    private int highRiskCount;
    private int openNcCount;
    private int openComplaintCount;
    private int openCapaCount;
    private int overdueCapaCount;
    private int equipmentAttentionCount;
    private int eqaAttentionCount;
    private int openEqaDeviationCount;
    private int indicatorOutOfTargetCount;
    private int plannedOrInProgressAuditCount;
    private int pendingAuditNcFindingCount;
    private int failedSupplierEvaluationCount;
    private int supplierAttentionCount;
    private int overdueSupplierReevaluationCount;
    private int overdueRiskActionCount;
    private int overdueIndicatorActionCount;
    private int openReviewActionCount;
    private int overdueReviewActionCount;
    private int overdueAuditFindingCount;

    private Risk riskModel = NewRisk();
    private ImpartialityDeclaration impartialityModel = new();
    private AuditPlan auditModel = NewAudit();
    private AuditFinding findingModel = NewFinding();
    private ManagementReview reviewModel = NewReview();
    private QualityIndicator indicatorModel = NewQualityIndicator();
    private SupplierEvaluation supplierEvalModel = NewSupplierEvaluation();

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var user = (await AuthStateTask).User;
            currentUserName = user.Identity?.Name ?? "Usuario";
            if (Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId))
                currentUserId = userId;
            var qualityPermissions = await PermissionService.GetPermissionsForUserAsync(user, "Quality");
            var hasQualityRole = qualityPermissions.CanRead;
            isAdmin = user.IsInRole("Administrador");
            canApproveImprovement = isAdmin || user.IsInRole("Director") || user.IsInRole("Responsable calidad") || qualityPermissions.CanApprove;
            isAuthorized = isAdmin || user.IsInRole("Director") || user.IsInRole("Responsable calidad") || hasQualityRole;
        }

        if (isAuthorized)
        {
            await LoadRiskMatrixSettings();
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        risks = await DbContext.Risks
            .OrderByDescending(r => (int)r.Likelihood * (int)r.Impact)
            .ThenBy(r => r.Title)
            .ToListAsync();
        impartialityDeclarations = await DbContext.ImpartialityDeclarations.OrderByDescending(d => d.DeclaredAt).ToListAsync();
        audits = await DbContext.AuditPlans.OrderByDescending(a => a.ScheduledDate).ToListAsync();
        auditFindings = await DbContext.AuditFindings.OrderBy(f => f.AuditPlanId).ThenBy(f => f.Type).ToListAsync();
        reviews = await DbContext.ManagementReviews.OrderByDescending(r => r.ReviewDate).ToListAsync();
        qualityIndicators = await DbContext.QualityIndicators.OrderByDescending(i => i.CreatedAt).ThenBy(i => i.Name).ToListAsync();
        suppliers = await DbContext.Suppliers.OrderBy(s => s.Name).ToListAsync();
        supplierEvaluations = await DbContext.SupplierEvaluations.Include(e => e.Supplier).OrderByDescending(e => e.EvaluationDate).ToListAsync();
        evidenceDocuments = await DbContext.Documents
            .AsNoTracking()
            .Where(d => !d.IsDeleted)
            .OrderBy(d => d.DocCode)
            .ThenBy(d => d.Title)
            .Take(500)
            .ToListAsync();

        var today = DateTime.Today;
        activeRiskCount = risks.Count(r => r.Status == RiskStatus.ACTIVE);
        highRiskCount = risks.Count(r => r.Status == RiskStatus.ACTIVE && IsHighOrCriticalRisk(r.RiskScore));
        openNcCount = await DbContext.Nonconformities.CountAsync(nc => !nc.IsDeleted && nc.Status != NCStatus.CLOSED);
        openComplaintCount = await DbContext.Complaints.CountAsync(c => !c.IsDeleted && c.Status != ComplaintStatus.CLOSED);
        openCapaCount = await DbContext.CapaActions.CountAsync(ca => !ca.IsDeleted && ca.Status != CAPAStatus.DONE && ca.Status != CAPAStatus.VERIFIED && ca.Status != CAPAStatus.CANCELLED);
        overdueCapaCount = await DbContext.CapaActions.CountAsync(ca => !ca.IsDeleted && ca.DueDate.HasValue && ca.DueDate.Value.Date < today && ca.Status != CAPAStatus.DONE && ca.Status != CAPAStatus.VERIFIED && ca.Status != CAPAStatus.CANCELLED);
        equipmentAttentionCount = await DbContext.Equipments.CountAsync(e => !e.IsDeleted && (e.Aptitude != EquipmentAptitude.APTO || e.Status == EquipmentStatus.OUT_OF_SERVICE || e.Status == EquipmentStatus.IN_SERVICE_WITH_RESTRICTIONS || e.Status == EquipmentStatus.QC_NON_CONFORMING || e.Status == EquipmentStatus.IN_REPAIR || e.Status == EquipmentStatus.IN_QUARANTINE));
        eqaAttentionCount = await DbContext.EQARounds.CountAsync(r => !r.IsDeleted && (r.RequiresAction || r.GlobalOutcome == EQAPerformance.UNSATISFACTORY || r.GlobalOutcome == EQAPerformance.PENDING_REVIEW));
        openEqaDeviationCount = await DbContext.EQADeviations.CountAsync(d => !d.IsDeleted && d.Status != "Cerrada" && d.Status != "Eficaz");
        indicatorOutOfTargetCount = qualityIndicators.Count(i => !i.MeetsTarget);
        plannedOrInProgressAuditCount = audits.Count(a => a.Status is AuditStatus.PLANNED or AuditStatus.IN_PROGRESS);
        pendingAuditNcFindingCount = auditFindings.Count(f => IsNonconformityFinding(f.Type) && !f.RelatedNCId.HasValue);
        failedSupplierEvaluationCount = supplierEvaluations.Count(e => SupplierNeedsManagementAttention(e));
        supplierAttentionCount = suppliers.Count(SupplierNeedsCurrentAttention);
        overdueSupplierReevaluationCount = suppliers.Count(SupplierReevaluationIsOverdue);
        overdueRiskActionCount = risks.Count(IsRiskActionOverdue);
        overdueIndicatorActionCount = qualityIndicators.Count(IsIndicatorActionOverdue);
        openReviewActionCount = reviews.Count(ReviewHasOpenAction);
        overdueReviewActionCount = reviews.Count(IsReviewActionOverdue);
        overdueAuditFindingCount = auditFindings.Count(IsAuditFindingOverdue);
    }

    private async Task SaveImpartiality()
    {
        if (string.IsNullOrWhiteSpace(impartialityModel.DeclarantName) || string.IsNullOrWhiteSpace(impartialityModel.Scope) || string.IsNullOrWhiteSpace(impartialityModel.Description))
        {
            SetError("Indique declarante, ámbito y descripción del riesgo de imparcialidad.");
            return;
        }

        impartialityModel.Id = Guid.NewGuid();
        impartialityModel.DeclaredAt = DateTime.UtcNow;
        DbContext.ImpartialityDeclarations.Add(impartialityModel);
        AddAuditLog("CREATE", "ImpartialityDeclaration", impartialityModel.Id, $"Declaración de imparcialidad registrada: {impartialityModel.Scope}");
        await SaveAndReload("Declaración de imparcialidad registrada.");
        impartialityModel = new ImpartialityDeclaration();
    }

    private async Task ReviewImpartiality(ImpartialityDeclaration declaration)
    {
        if (!canApproveImprovement)
        {
            SetError("Solo Dirección, Calidad o Administración puede revisar declaraciones de imparcialidad.");
            return;
        }

        declaration.ReviewerName = currentUserName;
        declaration.ReviewedAt = DateTime.UtcNow;
        declaration.NextReviewDate = DateTime.UtcNow.AddYears(1);
        declaration.Status = ImpartialityStatus.MITIGATED;
        declaration.Decision = "Revisada y mitigada; revisión periódica programada.";
        AddAuditLog("REVIEW", "ImpartialityDeclaration", declaration.Id, $"Declaración revisada por {currentUserName}; próxima revisión {declaration.NextReviewDate:yyyy-MM-dd}");
        await SaveAndReload("Declaración de imparcialidad revisada y seguimiento programado.");
    }

    private async Task SaveRisk()
    {
        if (string.IsNullOrWhiteSpace(riskModel.Title)) return;
        if (riskModel.ResidualLikelihood.HasValue != riskModel.ResidualImpact.HasValue)
        {
            SetError("Para calcular el riesgo residual debe seleccionar probabilidad residual e impacto residual.");
            return;
        }
        if (IsHighOrCriticalRisk(riskModel.RiskScore) && string.IsNullOrWhiteSpace(riskModel.ActionPlan) && string.IsNullOrWhiteSpace(riskModel.MitigationPlan))
        {
            SetError("Los riesgos altos o críticos deben tener acción o mitigación planificada.");
            return;
        }
        if (IsHighOrCriticalRisk(riskModel.RiskScore) && (string.IsNullOrWhiteSpace(riskModel.Responsible) || !riskModel.DueDate.HasValue))
        {
            SetError("Los riesgos altos o criticos deben incluir responsable y fecha limite.");
            return;
        }
        if (riskModel.Id == Guid.Empty)
        {
            riskModel.Id = Guid.NewGuid();
            riskModel.CreatedAt = DateTime.UtcNow;
            riskModel.UpdatedAt = DateTime.UtcNow;
            DbContext.Risks.Add(riskModel);
            AddAuditLog("CREATE", "Risk", riskModel.Id, $"Riesgo registrado: {riskModel.Title}");
            await SaveAndReload("Riesgo registrado.");
        }
        else
        {
            var existing = await DbContext.Risks.FindAsync(riskModel.Id);
            if (existing == null)
            {
                SetError("No se encontro el riesgo que se intenta actualizar.");
                return;
            }

            CopyRiskFields(riskModel, existing);
            existing.UpdatedAt = DateTime.UtcNow;
            AddAuditLog("EDIT", "Risk", existing.Id, $"Riesgo actualizado: {existing.Title}");
            await SaveAndReload("Riesgo actualizado.");
        }
        riskModel = NewRisk();
    }

