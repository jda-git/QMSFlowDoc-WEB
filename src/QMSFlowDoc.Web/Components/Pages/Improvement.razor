    private static string GetNullableEnumValue<TEnum>(TEnum? value) where TEnum : struct, Enum
    {
        return value.HasValue ? Convert.ToInt32(value.Value).ToString() : string.Empty;
    }

    private static TEnum? TryParseNullableEnum<TEnum>(string? rawValue) where TEnum : struct, Enum
    {
        if (int.TryParse(rawValue, out var numericValue) && Enum.IsDefined(typeof(TEnum), numericValue))
        {
            return (TEnum)Enum.ToObject(typeof(TEnum), numericValue);
        }

        return null;
    }

