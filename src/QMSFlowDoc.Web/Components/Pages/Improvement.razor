                <div class="col-lg-8">
                    <div class="mb-4">
                        <TableCard Title="Seguimiento de proveedores">
                            <thead><tr><th>Proveedor</th><th>Tipo</th><th>Estado actual</th><th>Ultima evaluacion</th><th>Proxima evaluacion</th><th>Seguimiento</th></tr></thead>
                            <tbody>
