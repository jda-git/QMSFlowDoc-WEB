    private async Task<bool> CanApproveFormalRecord()
    {
        if (!canApproveImprovement)
        {
            SetError("Solo Administrador, Direccion, Responsable calidad o usuarios con permiso de aprobacion en Calidad pueden aprobar/cerrar formalmente registros de mejora.");
            return false;
        }

        if (string.IsNullOrWhiteSpace(approvalPassword))
        {
            SetError("Introduzca su contraseña para firmar electronicamente la aprobacion/cierre.");
            return false;
        }

        ApplicationUser? user = null;
        if (currentUserId.HasValue)
        {
            user = await UserManager.FindByIdAsync(currentUserId.Value.ToString());
        }

        user ??= await UserManager.FindByNameAsync(currentUserName);
        if (user == null || !await UserManager.CheckPasswordAsync(user, approvalPassword))
        {
            SetError("La contraseña de firma no es valida para el usuario actual.");
            return false;
        }

        return true;
    }

