                        @foreach (var e in supplierEvaluations)
                        {
                            <tr><td>@e.EvaluationDate.ToString("dd/MM/yyyy")</td><td>@e.Supplier?.Name</td><td>@e.EvaluatedPeriod</td><td>@e.Criticality</td><td>@e.AverageScore.ToString("N1")</td><td><span class="badge @GetSupplierDecisionBadgeClass(e.Decision)">@e.Decision</span></td><td>@(e.NextEvaluationDate?.ToString("dd/MM/yyyy") ?? "-")</td><td><button class="btn btn-sm btn-outline-primary" @onclick="() => EditSupplierEvaluation(e)">Editar</button></td></tr>
                        }
                        </tbody>
                    </TableCard>
                </div>
            </section>
        }
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool isAuthorized;
    private string activeTab = "risks";
    private string? successMessage;
    private string? errorMessage;
    private Guid? currentUserId;
    private string currentUserName = "Sistema";

    private List<Risk> risks = new();
    private List<AuditPlan> audits = new();
    private List<AuditFinding> auditFindings = new();
    private List<ManagementReview> reviews = new();
    private List<QualityIndicator> qualityIndicators = new();
    private List<Supplier> suppliers = new();
    private List<SupplierEvaluation> supplierEvaluations = new();

    private int activeRiskCount;
    private int highRiskCount;
    private int openNcCount;
    private int openComplaintCount;
    private int openCapaCount;
    private int overdueCapaCount;
    private int equipmentAttentionCount;
    private int eqaAttentionCount;
    private int openEqaDeviationCount;
    private int indicatorOutOfTargetCount;
    private int plannedOrInProgressAuditCount;
    private int pendingAuditNcFindingCount;
    private int failedSupplierEvaluationCount;
    private int supplierAttentionCount;
    private int overdueSupplierReevaluationCount;
    private int overdueRiskActionCount;
    private int overdueIndicatorActionCount;
    private int openReviewActionCount;
    private int overdueReviewActionCount;
    private int overdueAuditFindingCount;

    private Risk riskModel = NewRisk();
    private AuditPlan auditModel = NewAudit();
    private AuditFinding findingModel = NewFinding();
    private ManagementReview reviewModel = NewReview();
    private QualityIndicator indicatorModel = NewQualityIndicator();
    private SupplierEvaluation supplierEvalModel = NewSupplierEvaluation();

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var user = (await AuthStateTask).User;
            currentUserName = user.Identity?.Name ?? "Usuario";
            if (Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId))
                currentUserId = userId;
            var hasQualityRole = (await PermissionService.GetPermissionsForUserAsync(user, "Quality")).CanRead;
            isAuthorized = user.IsInRole("Administrador") || user.IsInRole("Director") || user.IsInRole("Responsable calidad") || hasQualityRole;
        }

        if (isAuthorized)
            await LoadData();
    }

    private async Task LoadData()
    {
        risks = await DbContext.Risks
            .OrderByDescending(r => (int)r.Likelihood * (int)r.Impact)
            .ThenBy(r => r.Title)
            .ToListAsync();
        audits = await DbContext.AuditPlans.OrderByDescending(a => a.ScheduledDate).ToListAsync();
        auditFindings = await DbContext.AuditFindings.OrderBy(f => f.AuditPlanId).ThenBy(f => f.Type).ToListAsync();
        reviews = await DbContext.ManagementReviews.OrderByDescending(r => r.ReviewDate).ToListAsync();
        qualityIndicators = await DbContext.QualityIndicators.OrderByDescending(i => i.CreatedAt).ThenBy(i => i.Name).ToListAsync();
        suppliers = await DbContext.Suppliers.OrderBy(s => s.Name).ToListAsync();
        supplierEvaluations = await DbContext.SupplierEvaluations.Include(e => e.Supplier).OrderByDescending(e => e.EvaluationDate).ToListAsync();

        var today = DateTime.Today;
        activeRiskCount = risks.Count(r => r.Status == RiskStatus.ACTIVE);
        highRiskCount = risks.Count(r => r.Status == RiskStatus.ACTIVE && r.RiskScore >= 12);
        openNcCount = await DbContext.Nonconformities.CountAsync(nc => !nc.IsDeleted && nc.Status != NCStatus.CLOSED);
        openComplaintCount = await DbContext.Complaints.CountAsync(c => !c.IsDeleted && c.Status != ComplaintStatus.CLOSED);
        openCapaCount = await DbContext.CapaActions.CountAsync(ca => !ca.IsDeleted && ca.Status != CAPAStatus.DONE && ca.Status != CAPAStatus.VERIFIED && ca.Status != CAPAStatus.CANCELLED);
        overdueCapaCount = await DbContext.CapaActions.CountAsync(ca => !ca.IsDeleted && ca.DueDate.HasValue && ca.DueDate.Value.Date < today && ca.Status != CAPAStatus.DONE && ca.Status != CAPAStatus.VERIFIED && ca.Status != CAPAStatus.CANCELLED);
        equipmentAttentionCount = await DbContext.Equipments.CountAsync(e => !e.IsDeleted && (e.Aptitude != EquipmentAptitude.APTO || e.Status == EquipmentStatus.OUT_OF_SERVICE || e.Status == EquipmentStatus.IN_SERVICE_WITH_RESTRICTIONS || e.Status == EquipmentStatus.QC_NON_CONFORMING || e.Status == EquipmentStatus.IN_REPAIR || e.Status == EquipmentStatus.IN_QUARANTINE));
        eqaAttentionCount = await DbContext.EQARounds.CountAsync(r => !r.IsDeleted && (r.RequiresAction || r.GlobalOutcome == EQAPerformance.UNSATISFACTORY || r.GlobalOutcome == EQAPerformance.PENDING_REVIEW));
        openEqaDeviationCount = await DbContext.EQADeviations.CountAsync(d => !d.IsDeleted && d.Status != "Cerrada" && d.Status != "Eficaz");
        indicatorOutOfTargetCount = qualityIndicators.Count(i => !i.MeetsTarget);
        plannedOrInProgressAuditCount = audits.Count(a => a.Status is AuditStatus.PLANNED or AuditStatus.IN_PROGRESS);
        pendingAuditNcFindingCount = auditFindings.Count(f => IsNonconformityFinding(f.Type) && !f.RelatedNCId.HasValue);
        failedSupplierEvaluationCount = supplierEvaluations.Count(e => SupplierNeedsManagementAttention(e));
        supplierAttentionCount = suppliers.Count(SupplierNeedsCurrentAttention);
        overdueSupplierReevaluationCount = suppliers.Count(SupplierReevaluationIsOverdue);
        overdueRiskActionCount = risks.Count(IsRiskActionOverdue);
        overdueIndicatorActionCount = qualityIndicators.Count(IsIndicatorActionOverdue);
        openReviewActionCount = reviews.Count(ReviewHasOpenAction);
        overdueReviewActionCount = reviews.Count(IsReviewActionOverdue);
        overdueAuditFindingCount = auditFindings.Count(IsAuditFindingOverdue);
    }

    private async Task SaveRisk()
    {
        if (string.IsNullOrWhiteSpace(riskModel.Title)) return;
        if (riskModel.ResidualLikelihood.HasValue != riskModel.ResidualImpact.HasValue)
        {
            SetError("Para calcular el riesgo residual debe seleccionar probabilidad residual e impacto residual.");
            return;
        }
        if (riskModel.RiskScore >= 12 && string.IsNullOrWhiteSpace(riskModel.ActionPlan) && string.IsNullOrWhiteSpace(riskModel.MitigationPlan))
        {
            SetError("Los riesgos altos o críticos deben tener acción o mitigación planificada.");
            return;
        }
        if (riskModel.RiskScore >= 12 && (string.IsNullOrWhiteSpace(riskModel.Responsible) || !riskModel.DueDate.HasValue))
        {
            SetError("Los riesgos altos o criticos deben incluir responsable y fecha limite.");
            return;
        }
        if (riskModel.Id == Guid.Empty)
        {
            riskModel.Id = Guid.NewGuid();
            riskModel.CreatedAt = DateTime.UtcNow;
            riskModel.UpdatedAt = DateTime.UtcNow;
            DbContext.Risks.Add(riskModel);
            AddAuditLog("CREATE", "Risk", riskModel.Id, $"Riesgo registrado: {riskModel.Title}");
            await SaveAndReload("Riesgo registrado.");
        }
        else
        {
            var existing = await DbContext.Risks.FindAsync(riskModel.Id);
            if (existing == null)
            {
                SetError("No se encontro el riesgo que se intenta actualizar.");
                return;
            }

            CopyRiskFields(riskModel, existing);
            existing.UpdatedAt = DateTime.UtcNow;
            AddAuditLog("EDIT", "Risk", existing.Id, $"Riesgo actualizado: {existing.Title}");
            await SaveAndReload("Riesgo actualizado.");
        }
        riskModel = NewRisk();
    }

    private void EditRisk(Risk risk)
    {
        riskModel = new Risk
        {
            Id = risk.Id,
            Title = risk.Title,
            Description = risk.Description,
            Category = risk.Category,
            Likelihood = risk.Likelihood,
            Impact = risk.Impact,
            MitigationPlan = risk.MitigationPlan,
            Opportunity = risk.Opportunity,
            ActionPlan = risk.ActionPlan,
            Responsible = risk.Responsible,
            DueDate = risk.DueDate,
            ResidualLikelihood = risk.ResidualLikelihood,
            ResidualImpact = risk.ResidualImpact,
            EffectivenessReview = risk.EffectivenessReview,
            EffectivenessReviewDate = risk.EffectivenessReviewDate,
            OwnerUserId = risk.OwnerUserId,
            OwnerName = risk.OwnerName,
            Status = risk.Status,
            CreatedAt = risk.CreatedAt,
            UpdatedAt = risk.UpdatedAt
        };
        successMessage = null;
        errorMessage = null;
    }

    private void CancelRiskEdit()
    {
        riskModel = NewRisk();
        successMessage = null;
        errorMessage = null;
    }

    private static void CopyRiskFields(Risk source, Risk target)
    {
        target.Title = source.Title;
        target.Description = source.Description;
        target.Category = source.Category;
        target.Likelihood = source.Likelihood;
        target.Impact = source.Impact;
        target.MitigationPlan = source.MitigationPlan;
        target.Opportunity = source.Opportunity;
        target.ActionPlan = source.ActionPlan;
        target.Responsible = source.Responsible;
        target.DueDate = source.DueDate;
        target.ResidualLikelihood = source.ResidualLikelihood;
        target.ResidualImpact = source.ResidualImpact;
        target.EffectivenessReview = source.EffectivenessReview;
        target.EffectivenessReviewDate = source.EffectivenessReviewDate;
    }

    private void OnResidualLikelihoodChanged(ChangeEventArgs e)
    {
        riskModel.ResidualLikelihood = TryParseNullableEnum<RiskLikelihood>(e.Value?.ToString());
    }

    private void OnResidualImpactChanged(ChangeEventArgs e)
    {
        riskModel.ResidualImpact = TryParseNullableEnum<RiskImpact>(e.Value?.ToString());
    }

    private async Task SaveAudit()
    {
        if (string.IsNullOrWhiteSpace(auditModel.Title)) return;
        if (string.IsNullOrWhiteSpace(auditModel.Scope) ||
            string.IsNullOrWhiteSpace(auditModel.Criteria) ||
            string.IsNullOrWhiteSpace(auditModel.LeadAuditor))
        {
            SetError("La auditoria debe incluir alcance, criterios/requisitos auditados y auditor lider.");
            return;
        }

        if (auditModel.Id == Guid.Empty)
        {
            auditModel.Id = Guid.NewGuid();
            auditModel.Status = AuditStatus.PLANNED;
            DbContext.AuditPlans.Add(auditModel);
            AddAuditLog("CREATE", "AuditPlan", auditModel.Id, $"Plan de auditoría registrado: {auditModel.Title}");
            await SaveAndReload("Plan de auditoría registrado.");
        }
        else
        {
            var existing = await DbContext.AuditPlans.FindAsync(auditModel.Id);
            if (existing == null)
            {
                SetError("No se encontro la auditoria que se intenta actualizar.");
                return;
            }

            CopyAuditFields(auditModel, existing);
            AddAuditLog("EDIT", "AuditPlan", existing.Id, $"Plan de auditoría actualizado: {existing.Title}");
            await SaveAndReload("Plan de auditoría actualizado.");
        }
        auditModel = NewAudit();
    }

    private void EditAudit(AuditPlan audit)
    {
        auditModel = new AuditPlan
        {
            Id = audit.Id,
            Title = audit.Title,
            ScheduledDate = audit.ScheduledDate,
            Scope = audit.Scope,
            Objectives = audit.Objectives,
            Criteria = audit.Criteria,
            LeadAuditor = audit.LeadAuditor,
            Status = audit.Status,
            SummaryReport = audit.SummaryReport,
            Conclusions = audit.Conclusions,
            FollowUpActions = audit.FollowUpActions,
            CompletedAt = audit.CompletedAt,
            ReportDocumentId = audit.ReportDocumentId,
            ChecklistJson = audit.ChecklistJson
        };
        successMessage = null;
        errorMessage = null;
    }

    private void CancelAuditEdit()
    {
        auditModel = NewAudit();
        successMessage = null;
        errorMessage = null;
    }

    private static void CopyAuditFields(AuditPlan source, AuditPlan target)
    {
        target.Title = source.Title;
        target.ScheduledDate = source.ScheduledDate;
        target.Scope = source.Scope;
        target.Objectives = source.Objectives;
        target.Criteria = source.Criteria;
        target.LeadAuditor = source.LeadAuditor;
        target.SummaryReport = source.SummaryReport;
        target.Conclusions = source.Conclusions;
        target.FollowUpActions = source.FollowUpActions;
        target.ChecklistJson = source.ChecklistJson;
        target.ReportDocumentId = source.ReportDocumentId;
    }

    private async Task SaveAuditFinding()
    {
        if (findingModel.AuditPlanId == Guid.Empty || string.IsNullOrWhiteSpace(findingModel.Description)) return;
        if (IsNonconformityFinding(findingModel.Type) &&
            (string.IsNullOrWhiteSpace(findingModel.IsoRequirement) ||
             string.IsNullOrWhiteSpace(findingModel.Responsible) ||
             !findingModel.DueDate.HasValue))
        {
            SetError("Los hallazgos de no conformidad deben incluir requisito ISO, responsable y fecha prevista de cierre.");
            return;
        }

        if (findingModel.Id == Guid.Empty)
        {
            findingModel.Id = Guid.NewGuid();
            DbContext.AuditFindings.Add(findingModel);

            var audit = await DbContext.AuditPlans.FindAsync(findingModel.AuditPlanId);
            if (audit != null && audit.Status == AuditStatus.PLANNED)
            {
                audit.Status = AuditStatus.IN_PROGRESS;
            }

            AddAuditLog("CREATE", "AuditFinding", findingModel.Id, $"Hallazgo de auditoría registrado: {findingModel.Description}");
            await SaveAndReload("Hallazgo de auditoría registrado.");
        }
        else
        {
            var existing = await DbContext.AuditFindings.FindAsync(findingModel.Id);
            if (existing == null)
            {
                SetError("No se encontro el hallazgo de auditoría seleccionado.");
                return;
            }

            CopyAuditFindingFields(findingModel, existing);
            AddAuditLog("UPDATE", "AuditFinding", existing.Id, $"Hallazgo de auditoría actualizado: {existing.Description}");
            await SaveAndReload("Hallazgo de auditoría actualizado.");
        }

        findingModel = NewFinding();
    }

