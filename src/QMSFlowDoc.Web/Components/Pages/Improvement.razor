    private async Task SyncSupplierFromLatestEvaluation(Guid supplierId, SupplierEvaluation? pendingEvaluation = null)
    {
        var supplier = await DbContext.Suppliers.FirstOrDefaultAsync(s => s.Id == supplierId);
        if (supplier == null) return;

        var evaluations = await DbContext.SupplierEvaluations
            .AsNoTracking()
            .Where(e => e.SupplierId == supplierId)
            .Where(e => pendingEvaluation == null || e.Id != pendingEvaluation.Id)
            .OrderByDescending(e => e.EvaluationDate)
            .ThenByDescending(e => e.CreatedAt)
            .ToListAsync();
        if (pendingEvaluation != null && pendingEvaluation.SupplierId == supplierId)
        {
            evaluations.Add(pendingEvaluation);
        }

        var latestEvaluation = evaluations
            .OrderByDescending(e => e.EvaluationDate)
            .ThenByDescending(e => e.CreatedAt)
            .FirstOrDefault();

        if (latestEvaluation == null)
        {
            supplier.LastEvaluationDate = null;
            supplier.NextEvaluationDate = null;
            supplier.QualityStatus = SupplierQualityStatus.PENDIENTE;
            supplier.UpdatedAt = DateTime.UtcNow;
            return;
        }

        supplier.LastEvaluationDate = latestEvaluation.EvaluationDate;
        supplier.NextEvaluationDate = latestEvaluation.NextEvaluationDate;
        supplier.QualityStatus = MapSupplierEvaluationToQualityStatus(latestEvaluation);
        supplier.UpdatedAt = DateTime.UtcNow;
    }

