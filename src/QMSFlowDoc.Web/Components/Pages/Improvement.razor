    private static bool SupplierEvaluationIsApproved(SupplierEvaluation evaluation)
    {
        return evaluation.AverageScore >= 3.5 &&
               (evaluation.Decision == "Aprobado" || evaluation.Decision == "Aprobado con restricciones");
    }

    private static bool SupplierNeedsManagementAttention(SupplierEvaluation evaluation)
    {
        return !evaluation.IsApproved || evaluation.Decision == "Aprobado con restricciones";
    }

    private static SupplierQualityStatus MapSupplierEvaluationToQualityStatus(SupplierEvaluation evaluation)
    {
        if (evaluation.Decision == "Aprobado con restricciones" && evaluation.IsApproved)
        {
            return SupplierQualityStatus.EN_OBSERVACION;
        }

        if (!evaluation.IsApproved && evaluation.Decision == "Reevaluar")
        {
            return SupplierQualityStatus.EVALUACION_CADUCADA;
        }

        if (!evaluation.IsApproved)
        {
            return SupplierQualityStatus.NO_APTO;
        }

        return MapSupplierDecisionToQualityStatus(evaluation.Decision);
    }

    private static SupplierQualityStatus MapSupplierDecisionToQualityStatus(string? decision) => decision switch
    {
        "Aprobado" => SupplierQualityStatus.APTO,
        "Aprobado con restricciones" => SupplierQualityStatus.EN_OBSERVACION,
        "Reevaluar" => SupplierQualityStatus.EVALUACION_CADUCADA,
        "No aprobado" => SupplierQualityStatus.NO_APTO,
        _ => SupplierQualityStatus.PENDIENTE
    };

    private static string GetSupplierDecisionBadgeClass(string? decision)
    {
        return MapSupplierDecisionToQualityStatus(decision) switch
        {
            SupplierQualityStatus.APTO => "bg-success",
            SupplierQualityStatus.EN_OBSERVACION => "bg-warning text-dark",
            SupplierQualityStatus.EVALUACION_CADUCADA => "bg-warning text-dark",
            SupplierQualityStatus.NO_APTO => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private static bool IndicatorMeetsTarget(QualityIndicator indicator)
    {
        return indicator.TargetRule switch
        {
            "Minimo" => indicator.ActualValue >= indicator.TargetValue,
            "Igual" => indicator.ActualValue == indicator.TargetValue,
            _ => indicator.ActualValue <= indicator.TargetValue
        };
    }

    private static bool AuditHasCompletionEvidence(AuditPlan audit)
    {
        return !string.IsNullOrWhiteSpace(audit.ChecklistJson) &&
               !string.IsNullOrWhiteSpace(audit.SummaryReport) &&
               !string.IsNullOrWhiteSpace(audit.Conclusions);
    }

    private string GetAuditTitle(Guid auditPlanId)
    {
        return audits.FirstOrDefault(a => a.Id == auditPlanId)?.Title ?? "Auditoría no encontrada";
    }

    private static bool IsNonconformityFinding(FindingType value)
    {
        return value == FindingType.MINOR_NC || value == FindingType.MAJOR_NC;
    }

    private bool AuditHasUnlinkedNonconformityFindings(Guid auditPlanId)
    {
        return auditFindings.Any(f =>
            f.AuditPlanId == auditPlanId &&
            IsNonconformityFinding(f.Type) &&
            !f.RelatedNCId.HasValue);
    }
