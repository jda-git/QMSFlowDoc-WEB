                        <button class="btn btn-primary w-100" @onclick="SaveSupplierEvaluation" disabled="@(supplierEvalModel.SupplierId == Guid.Empty)">@(supplierEvalModel.Id == Guid.Empty ? "Registrar evaluación" : "Actualizar evaluación")</button>
