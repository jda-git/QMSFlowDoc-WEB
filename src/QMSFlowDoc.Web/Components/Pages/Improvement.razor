    private async Task CreateSupplierEvaluation()
    {
        if (supplierEvalModel.SupplierId == Guid.Empty) return;
        ClampSupplierScores();
        supplierEvalModel.EvaluatorUserId = currentUserId;
        supplierEvalModel.EvaluatorName = string.IsNullOrWhiteSpace(supplierEvalModel.EvaluatorName) ? currentUserName : supplierEvalModel.EvaluatorName;
        if (!supplierEvalModel.NextEvaluationDate.HasValue)
        {
            SetError("Toda evaluacion de proveedor debe incluir proxima fecha de evaluacion.");
            return;
        }

        if (supplierEvalModel.AverageScore < 3.5 &&
            (supplierEvalModel.Decision == "Aprobado" || supplierEvalModel.Decision == "Aprobado con restricciones"))
        {
            SetError("Una evaluacion con media inferior a 3,5 no puede quedar como aprobada. Seleccione Reevaluar o No aprobado.");
            return;
        }

        if (supplierEvalModel.Decision == "Aprobado con restricciones" &&
            string.IsNullOrWhiteSpace(supplierEvalModel.CorrectiveActions))
        {
            SetError("Un proveedor aprobado con restricciones debe incluir las restricciones o acciones derivadas.");
            return;
        }

        supplierEvalModel.Id = Guid.NewGuid();
        supplierEvalModel.IsApproved = SupplierEvaluationIsApproved(supplierEvalModel);
        if (!supplierEvalModel.IsApproved && string.IsNullOrWhiteSpace(supplierEvalModel.CorrectiveActions))
        {
            SetError("Si el proveedor no queda aprobado debe registrar acciones derivadas.");
            return;
        }
        supplierEvalModel.CreatedAt = DateTime.UtcNow;
        DbContext.SupplierEvaluations.Add(supplierEvalModel);
        await SyncSupplierFromEvaluation(supplierEvalModel);
        AddAuditLog("CREATE", "SupplierEvaluation", supplierEvalModel.Id, $"Evaluación de proveedor registrada. Media: {supplierEvalModel.AverageScore:N1}");
        await SaveAndReload("Evaluación de proveedor registrada.");
        supplierEvalModel = NewSupplierEvaluation();
    }

    private async Task SyncSupplierFromEvaluation(SupplierEvaluation evaluation)
    {
        var supplier = await DbContext.Suppliers.FirstOrDefaultAsync(s => s.Id == evaluation.SupplierId);
        if (supplier == null) return;

        supplier.LastEvaluationDate = evaluation.EvaluationDate;
        supplier.NextEvaluationDate = evaluation.NextEvaluationDate;
        supplier.QualityStatus = MapSupplierEvaluationToQualityStatus(evaluation);
        supplier.UpdatedAt = DateTime.UtcNow;
    }

    private async Task SaveQualityIndicator()
    {
        if (string.IsNullOrWhiteSpace(indicatorModel.Name) || string.IsNullOrWhiteSpace(indicatorModel.Period))
        {
            SetError("El indicador debe incluir nombre y periodo.");
            return;
        }

        indicatorModel.MeetsTarget = IndicatorMeetsTarget(indicatorModel);
        if (!indicatorModel.MeetsTarget && string.IsNullOrWhiteSpace(indicatorModel.ActionPlan))
        {
            SetError("Los indicadores fuera de objetivo deben incluir análisis/acción.");
            return;
        }

        if (indicatorModel.Id == Guid.Empty)
        {
            indicatorModel.Id = Guid.NewGuid();
            indicatorModel.CreatedAt = DateTime.UtcNow;
            DbContext.QualityIndicators.Add(indicatorModel);
            AddAuditLog("CREATE", "QualityIndicator", indicatorModel.Id, $"Indicador registrado: {indicatorModel.Name} {indicatorModel.Period}");
            await SaveAndReload("Indicador de calidad registrado.");
        }
        else
        {
            var existing = await DbContext.QualityIndicators.FindAsync(indicatorModel.Id);
            if (existing == null)
            {
                SetError("No se encontro el indicador que se intenta actualizar.");
                return;
            }

            CopyIndicatorFields(indicatorModel, existing);
            AddAuditLog("EDIT", "QualityIndicator", existing.Id, $"Indicador actualizado: {existing.Name} {existing.Period}");
            await SaveAndReload("Indicador de calidad actualizado.");
        }

        indicatorModel = NewQualityIndicator();
    }

