        {
            SupplierQualityStatus.APTO => "bg-success",
            SupplierQualityStatus.EN_OBSERVACION => "bg-warning text-dark",
            SupplierQualityStatus.EVALUACION_CADUCADA => "bg-warning text-dark",
            SupplierQualityStatus.NO_APTO => "bg-danger",
            _ => "bg-secondary"
        };
    }

