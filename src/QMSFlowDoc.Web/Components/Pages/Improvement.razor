    };

    private static string GetRiskScoreLevel(int score) => score switch
    {
        >= 16 => "Crítico",
        >= 12 => "Alto",
        >= 6 => "Medio",
        _ => "Bajo"
    };

    private static string GetRiskScoreBadgeClass(int score) => score switch
    {
        >= 16 => "bg-danger",
        >= 12 => "bg-warning text-dark",
        >= 6 => "bg-info text-dark",
        _ => "bg-success"
    };

    private static string GetWarningBadgeClass(int count)
    {
        return count > 0 ? "bg-warning text-dark" : "bg-success";
    }

    private static string GetSupplierResultBadgeClass(bool isApproved)
    {
        return isApproved ? "bg-success" : "bg-warning text-dark";
    }

    private string GetAuditTitle(Guid auditPlanId)
    {
        return audits.FirstOrDefault(a => a.Id == auditPlanId)?.Title ?? "Auditoría no encontrada";
    }

    private static bool IsNonconformityFinding(FindingType value)
    {
        return value == FindingType.MINOR_NC || value == FindingType.MAJOR_NC;
    }

    private bool AuditHasUnlinkedNonconformityFindings(Guid auditPlanId)
    {
        return auditFindings.Any(f =>
            f.AuditPlanId == auditPlanId &&
            IsNonconformityFinding(f.Type) &&
            !f.RelatedNCId.HasValue);
    }
}
