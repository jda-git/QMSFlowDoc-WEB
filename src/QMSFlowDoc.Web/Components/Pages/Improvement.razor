                   SectionHtml("Entradas y decisiones", $"<p><b>Resumen:</b> {E(review.Summary)}<br><b>Decisiones:</b> {E(review.Decisions)}<br><b>Acciones:</b> {E(review.Actions)}<br><b>Responsable/plazo:</b> {E(review.ActionOwner)} {review.ActionDueDate:dd/MM/yyyy}</p>") +
                   SectionHtml("Control formal", $"<p><b>Acta/evidencia:</b> {E(GetDocumentLabel(review.MinutesDocumentId))}<br><b>Aprobacion:</b> {E(ApprovalText(review.ApprovedByName, review.ApprovedAt))}<br><b>Notas:</b> {Nl(review.ApprovalNotes)}</p>");
        await WriteExport($"Acta revision direccion - {review.ReviewDate:dd-MM-yyyy}", "acta-revision-direccion", BuildHtmlReport($"Acta revision direccion - {review.ReviewDate:dd/MM/yyyy}", body));
    }

    private async Task ExportIndicatorReport(QualityIndicator indicator)
    {
        var body = SectionHtml("Indicador", $"<p><b>Periodo:</b> {E(indicator.Period)}<br><b>Area:</b> {E(indicator.Area)}<br><b>Objetivo:</b> {indicator.TargetValue:N2} {E(indicator.Unit)}<br><b>Resultado:</b> {indicator.ActualValue:N2} {E(indicator.Unit)}<br><b>Seguimiento:</b> {E(GetIndicatorActionStatusLabel(indicator))}</p>") +
                   SectionHtml("Analisis y eficacia", $"<p>{Nl(indicator.Analysis)}<br>{Nl(indicator.ActionPlan)}<br>{Nl(indicator.EffectivenessReview)}</p>") +
                   SectionHtml("Control formal", $"<p><b>Plazo:</b> {indicator.DueDate:dd/MM/yyyy}<br><b>Evidencia:</b> {E(GetDocumentLabel(indicator.EvidenceDocumentId))}<br><b>Aprobacion:</b> {E(ApprovalText(indicator.ApprovedByName, indicator.ApprovedAt))}<br><b>Notas:</b> {Nl(indicator.ApprovalNotes)}</p>");
        await WriteExport($"Informe indicador - {indicator.Name}", "informe-indicador", BuildHtmlReport($"Informe indicador - {indicator.Name}", body));
