    private sealed class RiskMatrixSettings
    {
        public int LowMax { get; set; } = 5;
        public int MediumMax { get; set; } = 11;
        public int HighMax { get; set; } = 15;
        public string LikelihoodCriteria { get; set; } = string.Empty;
        public string ImpactCriteria { get; set; } = string.Empty;
        public string AcceptanceCriteria { get; set; } = string.Empty;

        public static RiskMatrixSettings Default() => new()
        {
            LowMax = 5,
            MediumMax = 11,
            HighMax = 15,
            LikelihoodCriteria = "1 Rara: evento excepcional.\n2 Improbable: poco frecuente.\n3 Posible: puede ocurrir.\n4 Probable: ocurre de forma recurrente.\n5 Casi segura: se espera que ocurra.",
            ImpactCriteria = "1 Insignificante: sin impacto en resultados o pacientes.\n2 Menor: impacto limitado y controlable.\n3 Moderado: afecta proceso o requiere accion correctiva.\n4 Mayor: posible impacto en resultados o servicio.\n5 Catastrofico: impacto grave en seguridad del paciente o acreditacion.",
            AcceptanceCriteria = "Riesgo residual bajo: aceptable. Medio: requiere seguimiento. Alto o critico: requiere aprobacion formal, plan de accion y revision de eficacia."
        };

        public void Normalize()
        {
            LowMax = Math.Clamp(LowMax, 1, 24);
            MediumMax = Math.Clamp(Math.Max(MediumMax, LowMax + 1), 2, 25);
            HighMax = Math.Clamp(Math.Max(HighMax, MediumMax + 1), 3, 25);
        }
    }
}
