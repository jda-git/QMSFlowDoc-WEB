            return;
        }

        riskMatrix.Normalize();
        await UpsertSetting("Improvement.RiskMatrix.LowMax", riskMatrix.LowMax.ToString());
        await UpsertSetting("Improvement.RiskMatrix.MediumMax", riskMatrix.MediumMax.ToString());
        await UpsertSetting("Improvement.RiskMatrix.HighMax", riskMatrix.HighMax.ToString());
        await UpsertSetting("Improvement.RiskMatrix.LikelihoodCriteria", riskMatrix.LikelihoodCriteria);
        await UpsertSetting("Improvement.RiskMatrix.ImpactCriteria", riskMatrix.ImpactCriteria);
        await UpsertSetting("Improvement.RiskMatrix.AcceptanceCriteria", riskMatrix.AcceptanceCriteria);
        AddAuditLog("CONFIG_UPDATE", "RiskMatrix", Guid.Empty, "Matriz de riesgos configurable actualizada.");
        await DbContext.SaveChangesAsync();
        await LoadData();
        successMessage = "Matriz de riesgos actualizada.";
        errorMessage = null;
    }

    private async Task LoadRiskMatrixSettings()
    {
        var settings = await DbContext.SystemSettings.AsNoTracking()
            .Where(s => s.Key.StartsWith("Improvement.RiskMatrix."))
            .ToDictionaryAsync(s => s.Key, s => s.Value);

        riskMatrix = RiskMatrixSettings.Default();
        riskMatrix.LowMax = ParseSettingInt(settings, "Improvement.RiskMatrix.LowMax", riskMatrix.LowMax);
        riskMatrix.MediumMax = ParseSettingInt(settings, "Improvement.RiskMatrix.MediumMax", riskMatrix.MediumMax);
        riskMatrix.HighMax = ParseSettingInt(settings, "Improvement.RiskMatrix.HighMax", riskMatrix.HighMax);
        riskMatrix.LikelihoodCriteria = settings.GetValueOrDefault("Improvement.RiskMatrix.LikelihoodCriteria", riskMatrix.LikelihoodCriteria);
        riskMatrix.ImpactCriteria = settings.GetValueOrDefault("Improvement.RiskMatrix.ImpactCriteria", riskMatrix.ImpactCriteria);
        riskMatrix.AcceptanceCriteria = settings.GetValueOrDefault("Improvement.RiskMatrix.AcceptanceCriteria", riskMatrix.AcceptanceCriteria);
        riskMatrix.Normalize();
    }

    private async Task UpsertSetting(string key, string value)
    {
        var setting = await DbContext.SystemSettings.FindAsync(key);
        if (setting == null)
        {
            DbContext.SystemSettings.Add(new SystemSetting { Key = key, Value = value });
        }
        else
        {
            setting.Value = value;
        }
    }

