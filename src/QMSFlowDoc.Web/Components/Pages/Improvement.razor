    private async Task CreateNCFromFinding(AuditFinding finding)
    {
        if (!IsNonconformityFinding(finding.Type) || finding.RelatedNCId.HasValue) return;

        var severity = finding.Type == FindingType.MAJOR_NC
            ? QMSFlowDoc.Shared.Models.NCSeverity.HIGH
            : QMSFlowDoc.Shared.Models.NCSeverity.MEDIUM;

        var request = new CreateNCRequest(
            $"Hallazgo auditoría: {GetAuditTitle(finding.AuditPlanId)}",
            $"{finding.Description}\n\nRequisito ISO 15189: {finding.IsoRequirement ?? "No especificado"}",
            severity,
            QMSFlowDoc.Shared.Models.NCStatus.OPEN,
            ImpactPatient: false,
            Containment: "Pendiente de definir tras análisis del hallazgo de auditoría.",
            Origin: "Auditoría interna",
            DueDate: null,
            RootCauseAnalysis: null,
            DetectedByUserId: currentUserId
        );

        var ncId = await QualityService.CreateNCAsync(request, currentUserId, currentUserName);
        finding.RelatedNCId = ncId;
        AddAuditLog("LINK", "AuditFinding", finding.Id, $"Hallazgo vinculado a NC {ncId}");
        await SaveAndReload("NC creada y vinculada al hallazgo.");
    }

    private async Task UpdateRiskStatus(Risk risk, string? rawStatus)
    {
        if (!Enum.TryParse<RiskStatus>(rawStatus, out var status) || risk.Status == status) return;
        if ((status == RiskStatus.MITIGATED || status == RiskStatus.ACCEPTED) && string.IsNullOrWhiteSpace(risk.EffectivenessReview))
        {
            SetError("Para mitigar o aceptar un riesgo debe registrarse revisión de eficacia/aceptación.");
            return;
        }
        if ((status == RiskStatus.MITIGATED || status == RiskStatus.ACCEPTED) &&
            (!risk.ResidualRiskScore.HasValue || !risk.EffectivenessReviewDate.HasValue))
        {
            SetError("Para mitigar o aceptar un riesgo debe registrarse riesgo residual calculado y fecha de revision de eficacia.");
            return;
        }
        risk.Status = status;
        risk.UpdatedAt = DateTime.UtcNow;
        AddAuditLog("STATUS_CHANGE", "Risk", risk.Id, $"Estado de riesgo cambiado a {GetRiskStatusLabel(status)}: {risk.Title}");
        await SaveAndReload("Estado de riesgo actualizado.");
    }

    private async Task UpdateAuditStatus(AuditPlan audit, string? rawStatus)
    {
        if (!Enum.TryParse<AuditStatus>(rawStatus, out var status) || audit.Status == status) return;

        if (status == AuditStatus.COMPLETED && AuditHasUnlinkedNonconformityFindings(audit.Id))
        {
            errorMessage = "No se puede completar la auditoría: existen hallazgos NC menor/mayor sin una no conformidad vinculada.";
            successMessage = null;
            return;
        }
        if (status == AuditStatus.COMPLETED && !AuditHasCompletionEvidence(audit))
        {
            SetError("No se puede completar la auditoria sin alcance, criterios, auditor, checklist, informe y conclusiones.");
            return;
        }
        if (status == AuditStatus.COMPLETED &&
            auditFindings.Any(f => f.AuditPlanId == audit.Id) &&
            string.IsNullOrWhiteSpace(audit.FollowUpActions))
        {
            SetError("No se puede completar la auditoria con hallazgos sin registrar seguimiento de acciones.");
            return;
        }

        audit.Status = status;
        if (status == AuditStatus.COMPLETED)
            audit.CompletedAt = DateTime.UtcNow;
        AddAuditLog("STATUS_CHANGE", "AuditPlan", audit.Id, $"Estado de auditoría cambiado a {GetAuditStatusLabel(status)}: {audit.Title}");
        await SaveAndReload("Estado de auditoría actualizado.");
    }

    private async Task SaveReview()
    {
        if (string.IsNullOrWhiteSpace(reviewModel.Participants) ||
            string.IsNullOrWhiteSpace(reviewModel.Agenda))
        {
            SetError("La revision por direccion debe incluir participantes y agenda.");
            return;
        }

        if (string.IsNullOrWhiteSpace(reviewModel.Summary) ||
            string.IsNullOrWhiteSpace(reviewModel.Decisions) ||
            string.IsNullOrWhiteSpace(reviewModel.Actions))
        {
            SetError("La revisión por dirección debe incluir resumen, decisiones y acciones acordadas.");
            return;
        }
        if (!string.IsNullOrWhiteSpace(reviewModel.Actions) &&
            (string.IsNullOrWhiteSpace(reviewModel.ActionOwner) || !reviewModel.ActionDueDate.HasValue))
        {
            SetError("Las acciones de revision por direccion deben incluir responsable y fecha limite.");
            return;
        }

        if (reviewModel.Id == Guid.Empty)
        {
            reviewModel.Id = Guid.NewGuid();
            DbContext.ManagementReviews.Add(reviewModel);
            AddAuditLog("CREATE", "ManagementReview", reviewModel.Id, $"Revisión por dirección registrada: {reviewModel.ReviewDate:yyyy-MM-dd}");
            await SaveAndReload("Revisión por dirección registrada.");
        }
        else
        {
            var existing = await DbContext.ManagementReviews.FindAsync(reviewModel.Id);
            if (existing == null)
            {
                SetError("No se encontro la revision que se intenta actualizar.");
                return;
            }

            CopyReviewFields(reviewModel, existing);
            AddAuditLog("EDIT", "ManagementReview", existing.Id, $"Revisión por dirección actualizada: {existing.ReviewDate:yyyy-MM-dd}");
            await SaveAndReload("Revisión por dirección actualizada.");
        }

        reviewModel = NewReview();
    }

