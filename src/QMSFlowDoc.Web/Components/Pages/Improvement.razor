@page "/improvement"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using QMSFlowDoc.Application.Services.Identity
@using QMSFlowDoc.Application.Services.Quality
@using QMSFlowDoc.Domain.Entities
@using QMSFlowDoc.Infrastructure.Persistence
@using QMSFlowDoc.Shared.DTOs
@inject QmsDbContext DbContext
@inject IPermissionService PermissionService
@inject IQualityService QualityService

<PageTitle>Mejora Continua ISO - QMSFlowDoc</PageTitle>

<div class="container-fluid py-4 px-4">
    @if (!isAuthorized)
    {
        <div class="alert alert-danger rounded-4 shadow-sm p-4">
            <h4 class="fw-bold mb-1">Acceso denegado</h4>
            <p class="mb-0">Solo perfiles de calidad, dirección o administración pueden gestionar mejora continua ISO 15189.</p>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h2 class="fw-bold text-dark mb-1"><i class="bi bi-clipboard2-check text-primary me-2"></i>Mejora Continua ISO</h2>
                <p class="text-muted mb-0">Riesgos, auditorías internas, revisión por dirección y evaluación de proveedores.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="alert alert-success py-2 small">@successMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger py-2 small">@errorMessage</div>
        }

        <ul class="nav nav-tabs custom-tabs mb-4 border-bottom-0">
            <li class="nav-item"><button class="nav-link @(activeTab == "risks" ? "active" : "")" @onclick='() => activeTab = "risks"'>Riesgos</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "audits" ? "active" : "")" @onclick='() => activeTab = "audits"'>Auditorías internas</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "reviews" ? "active" : "")" @onclick='() => activeTab = "reviews"'>Revisión dirección</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "indicators" ? "active" : "")" @onclick='() => activeTab = "indicators"'>Indicadores</button></li>
            <li class="nav-item"><button class="nav-link @(activeTab == "suppliers" ? "active" : "")" @onclick='() => activeTab = "suppliers"'>Proveedores</button></li>
        </ul>

        @if (activeTab == "risks")
        {
            <section class="row g-4">
                <div class="col-lg-4">
                    <div class="p-3 border rounded-3 bg-light">
                        <h5 class="fw-bold mb-3">Nuevo riesgo</h5>
                        <label class="form-label small fw-semibold text-secondary mb-1">Título del riesgo</label>
                        <input class="form-control mb-2" placeholder="Título" @bind="riskModel.Title" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Descripción</label>
                        <textarea class="form-control mb-2" rows="3" placeholder="Descripción" @bind="riskModel.Description"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Categoría</label>
                        <input class="form-control mb-2" placeholder="Categoría" @bind="riskModel.Category" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Probabilidad</label>
                        <select class="form-select mb-2" @bind="riskModel.Likelihood">
                            @foreach (var v in Enum.GetValues<RiskLikelihood>()) { <option value="@v">@GetRiskLikelihoodLabel(v)</option> }
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Impacto</label>
                        <select class="form-select mb-2" @bind="riskModel.Impact">
                            @foreach (var v in Enum.GetValues<RiskImpact>()) { <option value="@v">@GetRiskImpactLabel(v)</option> }
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Plan de mitigación</label>
                        <textarea class="form-control mb-3" rows="2" placeholder="Plan de mitigación" @bind="riskModel.MitigationPlan"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Oportunidad de mejora asociada</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Oportunidad de mejora asociada" @bind="riskModel.Opportunity"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Acción planificada</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Acción planificada" @bind="riskModel.ActionPlan"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Responsable</label>
                        <input class="form-control mb-2" placeholder="Responsable" @bind="riskModel.Responsible" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha límite</label>
                        <input type="date" class="form-control mb-2" @bind="riskModel.DueDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Riesgo residual</label>
                        <div class="row g-2 mb-2">
                            <div class="col">
                                <select class="form-select" value="@GetNullableEnumValue(riskModel.ResidualLikelihood)" @onchange="OnResidualLikelihoodChanged">
                                    <option value="">Probabilidad residual</option>
                                    @foreach (var v in Enum.GetValues<RiskLikelihood>()) { <option value="@((int)v)">@GetRiskLikelihoodLabel(v)</option> }
                                </select>
                            </div>
                            <div class="col">
                                <select class="form-select" value="@GetNullableEnumValue(riskModel.ResidualImpact)" @onchange="OnResidualImpactChanged">
                                    <option value="">Impacto residual</option>
                                    @foreach (var v in Enum.GetValues<RiskImpact>()) { <option value="@((int)v)">@GetRiskImpactLabel(v)</option> }
                                </select>
                            </div>
                        </div>
                        @if (riskModel.ResidualRiskScore.HasValue)
                        {
                            <div class="small mb-2">
                                Riesgo residual calculado:
                                <span class="badge @GetRiskScoreBadgeClass(riskModel.ResidualRiskScore.Value)">
                                    @riskModel.ResidualRiskScore.Value - @GetRiskScoreLevel(riskModel.ResidualRiskScore.Value)
                                </span>
                            </div>
                        }
                        <label class="form-label small fw-semibold text-secondary mb-1">Revisión de eficacia / aceptación</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Revisión de eficacia / aceptación" @bind="riskModel.EffectivenessReview"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha de revisión de eficacia</label>
                        <input type="date" class="form-control mb-3" @bind="riskModel.EffectivenessReviewDate" />
                        <button class="btn btn-primary w-100" @onclick="SaveRisk">@(riskModel.Id == Guid.Empty ? "Registrar riesgo" : "Actualizar riesgo")</button>
                        @if (riskModel.Id != Guid.Empty)
                        {
                            <button class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelRiskEdit">Cancelar edicion</button>
                        }
                    </div>
                </div>
                <div class="col-lg-8">
                    <TableCard Title="Matriz de riesgos">
                        <thead><tr><th>Riesgo</th><th>Categoría</th><th>Score</th><th>Residual</th><th>Responsable</th><th>Plazo</th><th>Estado</th><th>Acción/Eficacia</th><th>Actualizar</th></tr></thead>
                        <tbody>
                        @foreach (var r in risks)
                        {
                            <tr>
                                <td>@r.Title</td>
                                <td>@r.Category</td>
                                <td><span class="badge @GetRiskScoreBadgeClass(r.RiskScore)">@r.RiskScore - @GetRiskScoreLevel(r.RiskScore)</span></td>
                                <td>@(r.ResidualRiskScore.HasValue ? $"{r.ResidualRiskScore} - {GetRiskScoreLevel(r.ResidualRiskScore.Value)}" : "Pendiente")</td>
                                <td>@(r.Responsible ?? r.OwnerName)</td>
                                <td>@(r.DueDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@GetRiskStatusLabel(r.Status)</td>
                                <td>
                                    <span class="badge @GetRiskActionBadgeClass(r) mb-1">@GetRiskActionStatusLabel(r)</span>
                                    <div>@(string.IsNullOrWhiteSpace(r.ActionPlan) ? r.MitigationPlan : r.ActionPlan)</div>
                                    @if (!string.IsNullOrWhiteSpace(r.EffectivenessReview))
                                    {
                                        <small class="text-success">@r.EffectivenessReview</small>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditRisk(r)">Editar</button>
                                        <select class="form-select form-select-sm" value="@r.Status" @onchange="e => UpdateRiskStatus(r, e.Value?.ToString())">
                                            @foreach (var v in Enum.GetValues<RiskStatus>()) { <option value="@v">@GetRiskStatusLabel(v)</option> }
                                        </select>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </TableCard>
                </div>
            </section>
        }

        @if (activeTab == "audits")
        {
            <section class="row g-4">
                <div class="col-lg-4">
                    <div class="p-3 border rounded-3 bg-light">
                        <h5 class="fw-bold mb-3">Planificar auditoría</h5>
                        <label class="form-label small fw-semibold text-secondary mb-1">Título de la auditoría</label>
                        <input class="form-control mb-2" placeholder="Título" @bind="auditModel.Title" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha programada</label>
                        <input type="date" class="form-control mb-2" @bind="auditModel.ScheduledDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Alcance</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Alcance" @bind="auditModel.Scope"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Objetivos de la auditoría</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Objetivos de la auditoría" @bind="auditModel.Objectives"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Criterios / requisitos auditados</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Criterios / requisitos auditados" @bind="auditModel.Criteria"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Checklist o puntos verificados</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Checklist o puntos verificados" @bind="auditModel.ChecklistJson"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Auditor líder</label>
                        <input class="form-control mb-3" placeholder="Auditor líder" @bind="auditModel.LeadAuditor" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Informe / resumen de auditoría</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Informe/resumen de auditoría" @bind="auditModel.SummaryReport"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Conclusiones</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Conclusiones" @bind="auditModel.Conclusions"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Seguimiento de acciones</label>
                        <textarea class="form-control mb-3" rows="2" placeholder="Seguimiento de acciones" @bind="auditModel.FollowUpActions"></textarea>
                        <button class="btn btn-primary w-100" @onclick="SaveAudit">@(auditModel.Id == Guid.Empty ? "Crear plan" : "Actualizar auditoria")</button>
                        @if (auditModel.Id != Guid.Empty)
                        {
                            <button class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelAuditEdit">Cancelar edicion</button>
                        }

                        <hr class="my-4" />

                        <h5 class="fw-bold mb-3">Registrar hallazgo</h5>
                        <label class="form-label small fw-semibold text-secondary mb-1">Auditoría asociada</label>
                        <select class="form-select mb-2" @bind="findingModel.AuditPlanId">
                            <option value="@Guid.Empty">Seleccione auditoría</option>
                            @foreach (var a in audits) { <option value="@a.Id">@a.Title</option> }
                        </select>
                        <label class="form-label small fw-semibold text-secondary mb-1">Descripción del hallazgo</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Descripción del hallazgo" @bind="findingModel.Description"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Requisito ISO 15189</label>
                        <input class="form-control mb-2" placeholder="Requisito ISO 15189, ej. 8.8" @bind="findingModel.IsoRequirement" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Responsable del seguimiento</label>
                        <input class="form-control mb-2" placeholder="Responsable del seguimiento" @bind="findingModel.Responsible" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha prevista de cierre</label>
                        <input type="date" class="form-control mb-2" @bind="findingModel.DueDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Revisión de eficacia del hallazgo / acción</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Revisión de eficacia del hallazgo/acción" @bind="findingModel.EffectivenessReview"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Tipo de hallazgo</label>
                        <select class="form-select mb-3" @bind="findingModel.Type">
                            @foreach (var v in Enum.GetValues<FindingType>()) { <option value="@v">@GetFindingTypeLabel(v)</option> }
                        </select>
                        <button class="btn btn-outline-primary w-100" @onclick="SaveAuditFinding" disabled="@(findingModel.AuditPlanId == Guid.Empty)">@(findingModel.Id == Guid.Empty ? "Registrar hallazgo" : "Actualizar hallazgo")</button>
                        @if (findingModel.Id != Guid.Empty)
                        {
                            <button class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelFindingEdit">Cancelar edicion</button>
                        }
                    </div>
                </div>
                <div class="col-lg-8">
                    <TableCard Title="Programa de auditorías">
                        <thead><tr><th>Fecha</th><th>Título</th><th>Alcance</th><th>Auditor</th><th>Evidencia</th><th>Estado</th><th>Actualizar</th></tr></thead>
                        <tbody>
                        @foreach (var a in audits)
                        {
                            <tr>
                                <td>@a.ScheduledDate.ToString("dd/MM/yyyy")</td>
                                <td>@a.Title</td>
                                <td>@a.Scope</td>
                                <td>@a.LeadAuditor</td>
                                <td>
                                    @if (AuditHasCompletionEvidence(a))
                                    {
                                        <span class="badge bg-success">Completa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                </td>
                                <td>
                                    @GetAuditStatusLabel(a.Status)
                                    @if (AuditHasUnlinkedNonconformityFindings(a.Id))
                                    {
                                        <span class="badge bg-danger ms-2">NC pendiente</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditAudit(a)">Editar</button>
                                        <select class="form-select form-select-sm" value="@a.Status" @onchange="e => UpdateAuditStatus(a, e.Value?.ToString())">
                                            @foreach (var v in Enum.GetValues<AuditStatus>()) { <option value="@v">@GetAuditStatusLabel(v)</option> }
                                        </select>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </TableCard>

                    <div class="mt-4">
                        <TableCard Title="Hallazgos de auditoría">
                            <thead><tr><th>Auditoría</th><th>Tipo</th><th>ISO</th><th>Descripción</th><th>NC vinculada</th><th>Seguimiento</th><th>Acción</th></tr></thead>
                            <tbody>
                            @foreach (var f in auditFindings)
                            {
                                <tr>
                                    <td>@GetAuditTitle(f.AuditPlanId)</td>
                                    <td>@GetFindingTypeLabel(f.Type)</td>
                                    <td>@f.IsoRequirement</td>
                                    <td>@f.Description</td>
                                    <td>
                                        @if (f.RelatedNCId.HasValue)
                                        {
                                            <span class="badge bg-success">NC creada</span>
                                        }
                                        else if (IsNonconformityFinding(f.Type))
                                        {
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No aplica</span>
                                        }
                                    </td>
                                    <td><span class="badge @GetAuditFindingBadgeClass(f)">@GetAuditFindingStatusLabel(f)</span></td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => EditAuditFinding(f)">Editar</button>
                                            @if (IsNonconformityFinding(f.Type) && !f.RelatedNCId.HasValue)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => CreateNCFromFinding(f)">Crear NC</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </TableCard>
                    </div>
                </div>
            </section>
        }

        @if (activeTab == "reviews")
        {
            <section class="row g-4">
                <div class="col-lg-4">
                    <div class="p-3 border rounded-3 bg-light">
                        <h5 class="fw-bold mb-3">Nueva revisión por dirección</h5>
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha de revisión</label>
                        <input type="date" class="form-control mb-2" @bind="reviewModel.ReviewDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Participantes</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Participantes" @bind="reviewModel.Participants"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Agenda</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Agenda" @bind="reviewModel.Agenda"></textarea>
                        <button type="button" class="btn btn-outline-secondary btn-sm w-100 mb-2" @onclick="UseIsoInputsInReviewAgenda">Usar entradas ISO en agenda</button>
                        <label class="form-label small fw-semibold text-secondary mb-1">Seguimiento de acciones previas</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Seguimiento de acciones previas" @bind="reviewModel.PreviousActionsReview"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Cambios que afectan al SGC</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Cambios que afectan al SGC" @bind="reviewModel.ChangesAffectingQms"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Necesidades de recursos</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Necesidades de recursos" @bind="reviewModel.ResourceNeeds"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Revisión de indicadores de calidad</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Revisión de indicadores de calidad" @bind="reviewModel.QualityIndicatorsReview"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Desempeño de proveedores externos</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Desempeño de proveedores externos" @bind="reviewModel.ExternalProviderPerformance"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Resumen</label>
                        <textarea class="form-control mb-2" rows="3" placeholder="Resumen" @bind="reviewModel.Summary"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Decisiones y conclusiones</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Decisiones y conclusiones" @bind="reviewModel.Decisions"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Oportunidades de mejora aprobadas</label>
                        <textarea class="form-control mb-2" rows="2" placeholder="Oportunidades de mejora aprobadas" @bind="reviewModel.ImprovementOpportunities"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Acciones acordadas</label>
                        <textarea class="form-control mb-3" rows="2" placeholder="Acciones acordadas" @bind="reviewModel.Actions"></textarea>
                        <label class="form-label small fw-semibold text-secondary mb-1">Responsable de acciones</label>
                        <input class="form-control mb-2" placeholder="Responsable de acciones" @bind="reviewModel.ActionOwner" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Fecha límite de acciones</label>
                        <input type="date" class="form-control mb-2" @bind="reviewModel.ActionDueDate" />
                        <label class="form-label small fw-semibold text-secondary mb-1">Seguimiento / eficacia de acciones de dirección</label>
                        <textarea class="form-control mb-3" rows="2" placeholder="Seguimiento / eficacia de acciones de dirección" @bind="reviewModel.EffectivenessReview"></textarea>
                        <button class="btn btn-primary w-100" @onclick="SaveReview">@(reviewModel.Id == Guid.Empty ? "Registrar revision" : "Actualizar revision")</button>
                        @if (reviewModel.Id != Guid.Empty)
                        {
                            <button class="btn btn-outline-secondary w-100 mt-2" @onclick="CancelReviewEdit">Cancelar edicion</button>
                        }
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="mb-4">
                        <TableCard Title="Entradas ISO para revisión">
                            <thead><tr><th>Entrada</th><th>Situación actual</th></tr></thead>
                            <tbody>
                                <tr><td>Riesgos activos</td><td><span class="badge bg-secondary">@activeRiskCount</span></td></tr>
                                <tr><td>Riesgos altos o críticos</td><td><span class="badge @GetWarningBadgeClass(highRiskCount)">@highRiskCount</span></td></tr>
                                <tr><td>Acciones de riesgo vencidas</td><td><span class="badge @GetWarningBadgeClass(overdueRiskActionCount)">@overdueRiskActionCount</span></td></tr>
                                <tr><td>No conformidades abiertas</td><td><span class="badge @GetWarningBadgeClass(openNcCount)">@openNcCount</span></td></tr>
                                <tr><td>Reclamaciones abiertas</td><td><span class="badge @GetWarningBadgeClass(openComplaintCount)">@openComplaintCount</span></td></tr>
                                <tr><td>CAPA abiertas / vencidas</td><td><span class="badge @GetWarningBadgeClass(openCapaCount)">@openCapaCount / @overdueCapaCount</span></td></tr>
                                <tr><td>Indicadores fuera de objetivo</td><td><span class="badge @GetWarningBadgeClass(indicatorOutOfTargetCount)">@indicatorOutOfTargetCount</span></td></tr>
                                <tr><td>Acciones de indicadores vencidas</td><td><span class="badge @GetWarningBadgeClass(overdueIndicatorActionCount)">@overdueIndicatorActionCount</span></td></tr>
                                <tr><td>Acciones de direccion abiertas / vencidas</td><td><span class="badge @GetWarningBadgeClass(openReviewActionCount)">@openReviewActionCount / @overdueReviewActionCount</span></td></tr>
                                <tr><td>Equipos no aptos o restringidos</td><td><span class="badge @GetWarningBadgeClass(equipmentAttentionCount)">@equipmentAttentionCount</span></td></tr>
                                <tr><td>EQA con revisión o acción pendiente</td><td><span class="badge @GetWarningBadgeClass(eqaAttentionCount)">@eqaAttentionCount</span></td></tr>
                                <tr><td>Desviaciones EQA abiertas</td><td><span class="badge @GetWarningBadgeClass(openEqaDeviationCount)">@openEqaDeviationCount</span></td></tr>
                                <tr><td>Auditorías planificadas/en curso</td><td><span class="badge bg-info text-dark">@plannedOrInProgressAuditCount</span></td></tr>
                                <tr><td>Hallazgos NC sin vincular</td><td><span class="badge @GetWarningBadgeClass(pendingAuditNcFindingCount)">@pendingAuditNcFindingCount</span></td></tr>
                                <tr><td>Hallazgos de auditoría vencidos</td><td><span class="badge @GetWarningBadgeClass(overdueAuditFindingCount)">@overdueAuditFindingCount</span></td></tr>
                                <tr><td>Proveedores con atencion</td><td><span class="badge @GetWarningBadgeClass(supplierAttentionCount)">@supplierAttentionCount</span></td></tr>
                                <tr><td>Reevaluaciones de proveedores vencidas</td><td><span class="badge @GetWarningBadgeClass(overdueSupplierReevaluationCount)">@overdueSupplierReevaluationCount</span></td></tr>
                            </tbody>
                        </TableCard>
                    </div>
                    <TableCard Title="Revisiones por dirección">
