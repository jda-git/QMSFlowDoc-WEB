    private void OnBarcodeScanned()
    {
        lotError = string.Empty;
        if (string.IsNullOrWhiteSpace(scannedBarcode)) return;

        var result = InventoryHelpers.ParseBarcode(scannedBarcode);
        if (!result.Success)
        {
            lotError = result.ErrorMessage;
            return;
        }

        if (targetReagent == null)
        {
            lotError = "No hay ningún reactivo destino seleccionado.";
            return;
        }

        if (!InventoryHelpers.IsReferenceMatch(result.Reference, targetReagent.Reference))
        {
            lotError = $"El código de barras contiene la referencia '{result.Reference}', que no coincide con la referencia del reactivo seleccionado '{targetReagent.Reference}'.";
            return;
        }

        lotModel.LotNumber = result.Lot;

        if (result.ExpirationDate.HasValue)
        {
            lotModel.ExpiryDate = result.ExpirationDate.Value;
        }
    }

    private async Task AdjustStock()
    {
        adjustError = string.Empty;
        if (!canEdit)
        {
            adjustError = "No tiene permisos para ajustar stock.";
            return;
        }
        if (targetReagentForAdjust == null) return;

        var lotId = targetLotForAdjust?.Id ?? adjustModel.ReagentLotId;
        if (lotId == Guid.Empty)
        {
            adjustError = "Debe seleccionar un lote.";
            return;
        }

        try
        {
            // Adjust sign for OUT/WASTE
            var qty = adjustModel.Qty;
            if (adjustModel.MovementType == QMSFlowDoc.Shared.Models.InventoryMovementType.OUT || adjustModel.MovementType == QMSFlowDoc.Shared.Models.InventoryMovementType.WASTE)
            {
                qty = -Math.Abs(qty);
            }
            else
            {
                qty = Math.Abs(qty);
            }

            var req = new AdjustStockRequest(
                targetReagentForAdjust.Id,
                lotId,
                (QMSFlowDoc.Shared.Models.InventoryMovementType)adjustModel.MovementType,
                qty,
                adjustModel.Reason,
                "Ajuste manual",
                currentUserId
            );

            var ok = await InventoryService.AdjustStockAsync(req);
            if (!ok)
            {
                adjustError = "Error al realizar el ajuste de inventario.";
            }
            else
            {
                showAdjustStockModal = false;
                await LoadInventoryDataAsync();
                if (selectedReagent != null && selectedReagent.Id == targetReagentForAdjust.Id)
                {
                    await SelectReagent(selectedReagent.Id);
                }
            }
        }
        catch (Exception ex)
        {
            adjustError = SafeError(ex, "adjusting inventory");
        }
    }

