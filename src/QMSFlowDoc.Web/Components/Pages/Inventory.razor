    private async Task ExecutePrint()
    {
        printExportBusy = true;
        StateHasChanged();
        try
        {
            var html = await BuildReportHtmlAsync();
            await InventoryHelpers.PrintAsync(JS, html);
        }
        finally { printExportBusy = false; }
    }

    private async Task ExecuteDownloadCsv()
    {
        printExportBusy = true;
        StateHasChanged();
        try
        {
            var (csv, filename) = await BuildReportCsvAsync();
            await InventoryHelpers.DownloadCsvAsync(JS, csv, filename);
        }
        finally { printExportBusy = false; }
    }

    private async Task<string> BuildReportHtmlAsync()
    {
        switch (printExportType)
        {
            case "IN":
            {
                var (data, title, sub) = await FetchMovements(outOnly: false);
                return InventoryHelpers.BuildMovementsHtml(data, title, sub);
            }
            case "OUT":
            {
                var (data, title, sub) = await FetchMovements(outOnly: true);
                return InventoryHelpers.BuildMovementsHtml(data, title, sub);
            }
            case "ORDER":
                return InventoryHelpers.BuildOrderListHtml(GetOrderList());
            default:
                return InventoryHelpers.BuildFullReagentListHtml(reagentsList);
        }
    }

    private async Task<(string csv, string filename)> BuildReportCsvAsync()
    {
        switch (printExportType)
        {
            case "IN":
            {
                var (data, _, _) = await FetchMovements(outOnly: false);
                return (InventoryHelpers.BuildMovementsCsv(data),
                        $"entradas_{printDateFrom:yyyyMMdd}_{printDateTo:yyyyMMdd}.csv");
            }
            case "OUT":
            {
                var (data, _, _) = await FetchMovements(outOnly: true);
                return (InventoryHelpers.BuildMovementsCsv(data),
                        $"salidas_{printDateFrom:yyyyMMdd}_{printDateTo:yyyyMMdd}.csv");
            }
            case "ORDER":
                return (InventoryHelpers.BuildOrderListCsv(GetOrderList()),
                        $"pedidos_{DateTime.Today:yyyyMMdd}.csv");
            default:
                return (InventoryHelpers.BuildFullReagentListCsv(reagentsList),
                        $"reactivos_completo_{DateTime.Today:yyyyMMdd}.csv");
        }
    }

    private async Task<(List<InventoryMovementDto> data, string title, string subtitle)> FetchMovements(bool outOnly)
    {
        var from = printDateFrom.ToUniversalTime();
        var to = printDateTo.ToUniversalTime().AddDays(1).AddSeconds(-1);
        if (outOnly)
        {
            var all = await InventoryService.GetMovementsAsync(from, to, null, null);
            var data = all.Where(m => m.AdjustmentType == "OUT" || m.AdjustmentType == "WASTE").ToList();
            var sub = $"Del {printDateFrom:dd/MM/yyyy} al {printDateTo:dd/MM/yyyy} — {data.Count} movimientos";
            return (data, "Listado de Salidas", sub);
        }
        else
        {
            var data = await InventoryService.GetMovementsAsync(from, to, InventoryMovementType.IN, null);
            var sub = $"Del {printDateFrom:dd/MM/yyyy} al {printDateTo:dd/MM/yyyy} — {data.Count} movimientos";
            return (data, "Listado de Entradas", sub);
        }
    }

    private List<ReagentListDto> GetOrderList()
        => reagentsList
            .Where(r => (int)r.Status == (int)QMSFlowDoc.Shared.Models.ReagentStatus.ACTIVO 
                && r.TotalStock <= r.ReorderQty 
                && (r.TargetStock - r.TotalStock) > 0)
            .OrderBy(r => r.InternalCode ?? r.Name)
            .ToList();

    // SAVING LOGIC

    private async Task SaveSupplier()
    {
        supplierError = string.Empty;
        if (isEditingSupplier && !canEdit)
        {
            supplierError = "No tiene permisos para modificar proveedores.";
            return;
        }
        if (!isEditingSupplier && !canCreate)
        {
            supplierError = "No tiene permisos para crear proveedores.";
            return;
        }

        try
        {
            var supplier = new Supplier
            {
                Id = supplierModel.Id ?? Guid.Empty,
                Name = supplierModel.Name,
                ContactName = supplierModel.ContactName,
                Email = supplierModel.Email,
                Phone = supplierModel.Phone,
                Address = supplierModel.Address,
                Notes = supplierModel.Notes,
                Type = supplierModel.Type
            };

            if (isEditingSupplier && supplierModel.Id.HasValue)
            {
                var ok = await InventoryService.UpdateSupplierAsync(supplier);
                if (!ok)
                {
                    supplierError = "No se pudo actualizar el proveedor.";
                    return;
                }
            }
            else
            {
                var created = await InventoryService.CreateSupplierAsync(supplier);
                if (created == null)
                {
                    supplierError = "No se pudo crear el proveedor.";
                    return;
                }

                if (selectCreatedSupplierForReagent)
                {
                    reagentModel.SupplierId = created.Id;
                    showSupplierModal = false;
                    selectCreatedSupplierForReagent = false;
                }
            }

            await ReloadSuppliersAsync();
            await LoadInventoryDataAsync();
            ResetSupplierForm();
        }
        catch (Exception ex)
        {
            supplierError = SafeError(ex, "saving supplier");
        }
    }

    private async Task ConfirmDeleteSupplier(Supplier supplier)
    {
        if (!canDelete)
        {
            await JS.InvokeVoidAsync("alert", "Error: No tiene permisos para eliminar proveedores.");
            return;
        }

        var confirmResult = await JS.InvokeAsync<object>("confirm", $"¿Está seguro de que desea eliminar el proveedor '{supplier.Name}'? Se ocultará de nuevas selecciones, conservando la trazabilidad histórica.");
        bool confirm = confirmResult is bool b
            ? b
            : confirmResult is System.Text.Json.JsonElement j && j.GetBoolean();
        if (!confirm)
        {
            return;
        }

        try
        {
            var success = await InventoryService.DeleteSupplierAsync(supplier.Id);
            if (!success)
            {
                supplierError = "No se pudo eliminar el proveedor.";
                return;
            }

            if (reagentModel.SupplierId == supplier.Id)
            {
                reagentModel.SupplierId = null;
            }

            await ReloadSuppliersAsync();
            await LoadInventoryDataAsync();
            ResetSupplierForm();
        }
        catch (Exception ex)
        {
            supplierError = SafeError(ex, "deleting supplier");
        }
    }

    private async Task SaveReagent()
    {
        reagentError = string.Empty;
        if (isEditingReagent && !canEdit)
        {
            reagentError = "No tiene permisos para modificar reactivos.";
            return;
        }
        if (!isEditingReagent && !canCreate)
        {
            reagentError = "No tiene permisos para registrar nuevos reactivos.";
            return;
        }
        try
        {
            var req = new CreateReagentRequest(
                reagentModel.Name,
                reagentModel.Manufacturer,
                reagentModel.SupplierId,
                reagentModel.ManufacturerCode,
                reagentModel.InternalCode,
                reagentModel.Fluorescence,
                reagentModel.ReagentType,
                reagentModel.Reference ?? string.Empty,
                reagentModel.Classification,
                reagentModel.StorageConditions,
                reagentModel.DefaultLocationId,
                reagentModel.OpenShelfLifeDays,
                reagentModel.MinStock,
                reagentModel.TargetStock,
                reagentModel.ReorderQty
            );

            if (isEditingReagent && reagentModel.Id.HasValue)
            {
                var ok = await InventoryService.UpdateReagentAsync(reagentModel.Id.Value, req);
                if (!ok) reagentError = "Error al actualizar el reactivo.";
            }
            else
            {
                var created = await InventoryService.CreateReagentAsync(req);
                if (created == null) reagentError = "Error al registrar el reactivo.";
            }

            if (string.IsNullOrEmpty(reagentError))
            {
                showReagentModal = false;
                await LoadInventoryDataAsync();
                if (selectedReagent != null)
                {
                    await SelectReagent(selectedReagent.Id);
                }
            }
        }
        catch (Exception ex)
        {
            reagentError = SafeError(ex, "saving reagent");
        }
    }

