@code {
    private bool canRead = false;
    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;
    private bool canPrint = false;
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string stockFilter = "all";
    private List<ReagentListDto> reagentsList = new();
    private Reagent? selectedReagent = null;
    private bool showAllLots = false;
    private Guid? currentUserId = null;
    private string currentUsername = "Usuario Web";

    // Active Reagents Tab state
    private string activeTab = "catalog";
    private DateTime activeReagentDate = DateTime.Today;
    private string activeReagentSearchTerm = "";
    private List<ActiveReagentDto> activeReagentsList = new();
    private bool isActiveReagentsLoading = false;

    // Selections / Lookups
    private List<StorageLocation> storageLocations = new();
    private List<Supplier> suppliers = new();
    private List<InventoryMovementDto> movements = new();

    // Stats
    private int lowStockCount = 0;
    private int expiredOrNearExpiryCount = 0;

    // Modals visibility
    private bool showReagentModal = false;
    private bool isEditingReagent = false;
    private bool showRegisterLotModal = false;
    private bool showAdjustStockModal = false;
    private bool showMovementsModal = false;
    private bool showReleaseLotModal = false;
    private bool showSupplierModal = false;
    private bool isEditingSupplier = false;
    private bool selectCreatedSupplierForReagent = false;

    // Print / Export modal state
    private bool showPrintExportModal = false;
    private string printExportType = "ALL"; // ALL | IN | OUT | ORDER
    private DateTime printDateFrom = DateTime.Today.AddMonths(-1);
    private DateTime printDateTo = DateTime.Today;
    private bool printExportBusy = false;

    // Form Models
    private ReagentFormModel reagentModel = new();
    private LotFormModel lotModel = new();
    private AdjustFormModel adjustModel = new();
    private SupplierFormModel supplierModel = new();

    private string scannedBarcode = string.Empty;
    private bool barcodeSetupDone = false;

    // Validation Errors
    private string reagentError = string.Empty;
    private string lotError = string.Empty;
    private string adjustError = string.Empty;
    private string supplierError = string.Empty;

    // Context for lot modal/adjust modal
    private ReagentListDto? targetReagent = null;
    private ReagentListDto? targetReagentForAdjust = null;
    private ReagentLot? targetLotForAdjust = null;
    private ReagentLot? targetLotForRelease = null;

    private string releaseCriteria = string.Empty;
    private string releaseNotes = string.Empty;
    private string releaseError = string.Empty;
    
    private Dictionary<Guid, string> userNames = new();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showRegisterLotModal && !barcodeSetupDone)
        {
            barcodeSetupDone = true;
            try
            {
                await Task.Delay(50);
                await JS.InvokeVoidAsync("setupBarcodeSubmitPrevention", "barcodeInput");
            }
            catch
            {
                // Ignorar si JS no está listo o en pre-renderizado
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;
            currentUsername = user.Identity?.Name ?? "Usuario Web";
            var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && Guid.TryParse(userIdClaim.Value, out var uId))
            {
                currentUserId = uId;
            }

            var userPermissions = await PermissionService.GetPermissionsForUserAsync(user, "Inventory");
            canRead = userPermissions.CanRead;
            canCreate = userPermissions.CanCreate;
            canEdit = userPermissions.CanEdit;
            canDelete = userPermissions.CanDelete;
            canPrint = userPermissions.CanPrint;
        }

        try
        {
            var usersList = await UserService.GetUsersAsync();
            userNames = usersList.ToDictionary(u => u.Id, u => u.FullName);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading user names lookup: {ex.Message}");
        }

        await LoadInventoryDataAsync();
        storageLocations = (await InventoryService.GetStorageLocationsAsync()).ToList();
        await ReloadSuppliersAsync();
    }

    private async Task LoadInventoryDataAsync()
    {
        isLoading = true;
        try
        {
            var list = await InventoryService.GetReagentsAsync();
            reagentsList = list.ToList();
            
            // Calculate statistics
            lowStockCount = reagentsList.Count(r => r.TotalStock <= r.MinStock);
            expiredOrNearExpiryCount = reagentsList.Count(r => r.ExpiryStatus > 0);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error charging reagents: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SetActiveTab(string tab)
    {
        activeTab = tab;
        if (activeTab == "active")
        {
            selectedReagent = null; // Clear selection when switching tabs
            await LoadActiveReagentsAsync();
        }
    }

    private async Task OnActiveReagentDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            activeReagentDate = dt;
            await LoadActiveReagentsAsync();
        }
    }

    private async Task LoadActiveReagentsAsync()
    {
        isActiveReagentsLoading = true;
        try
        {
            activeReagentsList = await InventoryService.GetActiveReagentsAsync(activeReagentDate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading active reagents: {ex.Message}");
        }
        finally
        {
            isActiveReagentsLoading = false;
        }
    }

    private IEnumerable<ActiveReagentDto> FilteredActiveReagents
    {
        get
        {
            if (string.IsNullOrWhiteSpace(activeReagentSearchTerm))
                return activeReagentsList;

            var term = activeReagentSearchTerm.ToLowerInvariant();
            return activeReagentsList.Where(r => 
                r.ReagentName.ToLowerInvariant().Contains(term) ||
                (r.InternalCode != null && r.InternalCode.ToLowerInvariant().Contains(term)) ||
                (r.LotNumber != null && r.LotNumber.ToLowerInvariant().Contains(term)) ||
                (r.Manufacturer != null && r.Manufacturer.ToLowerInvariant().Contains(term))
            );
        }
    }

    private async Task PrintActiveReagents()
    {
        if (isActiveReagentsLoading || !activeReagentsList.Any()) return;
        var html = InventoryHelpers.BuildActiveReagentsHtml(activeReagentsList, activeReagentDate);
        await InventoryHelpers.PrintAsync(JS, html);
    }

    private async Task DownloadActiveReagentsCsv()
    {
        if (isActiveReagentsLoading || !activeReagentsList.Any()) return;
        var csv = InventoryHelpers.BuildActiveReagentsCsv(activeReagentsList);
        await InventoryHelpers.DownloadCsvAsync(JS, csv, $"reactivos_activos_{activeReagentDate:yyyyMMdd}.csv");
    }

    private string currentSortColumn = "name";
    private bool isSortAscending = true;

    private void SortTable(string column)
    {
        if (currentSortColumn == column)
        {
            isSortAscending = !isSortAscending;
        }
        else
        {
            currentSortColumn = column;
            isSortAscending = true;
        }
    }

    private string GetSortIcon(string column)
    {
        if (currentSortColumn != column) return "bi-arrow-down-up opacity-50";
        return isSortAscending ? "bi-caret-up-fill text-success" : "bi-caret-down-fill text-success";
    }

    private IEnumerable<ReagentListDto> FilteredReagents
    {
        get
        {
            var query = reagentsList.Where(r => 
                (string.IsNullOrEmpty(searchTerm) || 
                 r.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || 
                 (r.InternalCode != null && r.InternalCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                 (r.Manufacturer != null && r.Manufacturer.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
                && (stockFilter == "all" || 
                    (stockFilter == "active" && r.Status == QMSFlowDoc.Shared.Models.ReagentStatus.ACTIVO) || 
                    (stockFilter == "low" && r.TotalStock <= r.MinStock) ||
                    (stockFilter == "order" && r.Status == QMSFlowDoc.Shared.Models.ReagentStatus.ACTIVO && r.TotalStock <= r.ReorderQty && (r.TargetStock - r.TotalStock) > 0))
            );

            return currentSortColumn switch
            {
                "code" => isSortAscending ? query.OrderBy(r => r.InternalCode ?? "") : query.OrderByDescending(r => r.InternalCode ?? ""),
                "name" => isSortAscending ? query.OrderBy(r => r.Name) : query.OrderByDescending(r => r.Name),
                "fluorescence" => isSortAscending ? query.OrderBy(r => r.Fluorescence ?? "") : query.OrderByDescending(r => r.Fluorescence ?? ""),
                "type" => isSortAscending ? query.OrderBy(r => r.ReagentType) : query.OrderByDescending(r => r.ReagentType),
                "supplier" => isSortAscending ? query.OrderBy(r => r.SupplierName ?? "") : query.OrderByDescending(r => r.SupplierName ?? ""),
                "stock" => isSortAscending ? query.OrderBy(r => r.TotalStock) : query.OrderByDescending(r => r.TotalStock),
                "expiry" => isSortAscending ? query.OrderBy(r => r.NearestExpiry ?? DateTime.MaxValue) : query.OrderByDescending(r => r.NearestExpiry ?? DateTime.MinValue),
                _ => query
            };
        }
    }

    private async Task SelectReagent(Guid reagentId)
    {
        selectedReagent = await InventoryService.GetReagentByIdAsync(reagentId);
    }

    private async Task ReloadSuppliersAsync()
    {
        suppliers = (await InventoryService.GetSuppliersAsync()).ToList();
    }

    private string GetExpiryBadgeClass(int status) => status switch
    {
        2 => "bg-danger text-white",
        1 => "bg-warning text-dark",
        _ => "bg-success text-white"
    };

    private string GetLotStatusColorClass(LotStatus status) => status switch
    {
        LotStatus.RELEASED => "status-released",
        LotStatus.QUARANTINE => "status-quarantine",
        LotStatus.IN_USE => "status-in-use",
        LotStatus.BLOCKED => "status-blocked",
        LotStatus.CONSUMED => "status-consumed",
        LotStatus.EXPIRED => "status-expired",
        LotStatus.RECALLED => "status-recalled",
        _ => "bg-light text-dark"
    };

    private async Task UpdateLotStatus(ReagentLot lot, string? newStatusStr)
    {
        if (!canEdit) return;
        if (Enum.TryParse<LotStatus>(newStatusStr, out var status))
        {
            var success = await InventoryService.UpdateLotStatusAsync(lot.Id, (QMSFlowDoc.Domain.Entities.LotStatus)status, currentUserId, currentUsername);
            if (success)
            {
                if (selectedReagent != null)
                {
                    await SelectReagent(selectedReagent.Id);
                }
                await LoadInventoryDataAsync();
            }
        }
    }

    private async Task QuickConsumeLot(ReagentLot lot, decimal quantity)
    {
        if (!canEdit) return;
        var request = new AdjustStockRequest(
            lot.ReagentId,
            lot.Id,
            QMSFlowDoc.Shared.Models.InventoryMovementType.OUT,
            -quantity,
            "Descuento rápido por consumo clínico",
            "Consumo rápido",
            currentUserId
        );

        var success = await InventoryService.AdjustStockAsync(request);
        if (success)
        {
            if (selectedReagent != null)
            {
                await SelectReagent(selectedReagent.Id);
            }
            await LoadInventoryDataAsync();
        }
    }

