    private async Task ReleaseLot()
    {
        if (targetLotForRelease == null) return;
        if (!canEdit)
        {
            releaseError = "No tiene permisos para liberar lotes.";
            return;
        }

        if (string.IsNullOrWhiteSpace(releaseCriteria))
        {
            releaseError = "Los criterios de aceptación son obligatorios para liberar el lote.";
            return;
        }

        try
        {
            var req = new ReleaseLotRequest(
                targetLotForRelease.Id,
                currentUserId ?? Guid.Empty,
                currentUsername,
                releaseCriteria.Trim(),
                null,
                null,
                string.IsNullOrWhiteSpace(releaseNotes) ? null : releaseNotes.Trim()
            );

            var success = await InventoryService.ReleaseLotAsync(req);
            if (success)
            {
                showReleaseLotModal = false;
                if (selectedReagent != null)
                {
                    // Recargar datos del reactivo seleccionado
                    selectedReagent = await InventoryService.GetReagentByIdAsync(selectedReagent.Id);
                }
                await LoadInventoryDataAsync();
            }
            else
            {
                releaseError = "No se pudo liberar el lote.";
            }
        }
        catch (Exception ex)
        {
            releaseError = SafeError(ex, "releasing reagent lot");
        }
    }

    private async Task ConfirmDeleteReagent(ReagentListDto reagent)
    {
        if (!canDelete)
        {
            await JS.InvokeVoidAsync("alert", "Error: No tiene permisos para eliminar reactivos.");
            return;
        }
        var confirmResult = await JS.InvokeAsync<object>("confirm", $"¿Está seguro de que desea eliminar el reactivo '{reagent.Name}'?");
        bool confirm = confirmResult is System.Text.Json.JsonElement j && j.GetBoolean();
        if (confirm)
        {
            var success = await InventoryService.DeleteReagentAsync(reagent.Id);
            if (success)
            {
                if (selectedReagent?.Id == reagent.Id)
                {
                    selectedReagent = null;
                }
                await LoadInventoryDataAsync();
            }
        }
    }

