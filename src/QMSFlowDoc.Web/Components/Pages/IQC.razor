    private async Task HandleAddResult()
    {
        if (newResultModel.SD <= 0)
        {
            modalError = "La Desviación Estándar (DE) Diana debe ser mayor que 0.";
            return;
        }

        var result = new IQCResult
        {
            Id = Guid.NewGuid(),
            EquipmentName = newResultModel.EquipmentName,
            AnalyteName = newResultModel.AnalyteName,
            Level = newResultModel.Level,
            Value = newResultModel.Value,
            Mean = newResultModel.Mean,
            SD = newResultModel.SD,
            Date = newResultModel.Date.ToUniversalTime(),
            Comments = newResultModel.Comments
        };

        // Determine Westgard status for the newly added result relative to existing points
        var tempHistory = allResults
            .Where(r => r.EquipmentName == result.EquipmentName && r.AnalyteName == result.AnalyteName && r.Level == result.Level)
            .Concat(new[] { result })
            .OrderBy(r => r.Date)
            .ToList();

        RunWestgardValidation(tempHistory);

        // Copy computed status to our new result
        var computedForSelf = tempHistory.First(h => h.Id == result.Id);
        result.Status = computedForSelf.Status;
        result.WestgardRule = computedForSelf.WestgardRule;

        DbContext.IQCResults.Add(result);

        // Audit Log
        var audit = new AuditLog
        {
            Id = Guid.NewGuid(),
            Action = "CREATE",
            EntityType = "IQCResult",
            EntityId = result.Id,
            Details = $"Resultado IQC '{result.AnalyteName}' registrado. Valor: {result.Value} (Diana: {result.Mean}±{result.SD}). Estado: {result.Status}. Regla: {result.WestgardRule ?? "Ninguna"}",
            UserId = currentUserId ?? Guid.Empty,
            UserName = currentUserName ?? "Sistema",
            Timestamp = DateTime.UtcNow,
            MachineName = Environment.MachineName,
            Result = "Success"
        };
        DbContext.AuditLogs.Add(audit);

        await DbContext.SaveChangesAsync();

        statusMessage = $"Resultado de IQC guardado. Estado: {result.Status} (Z-Score: {((result.Value - result.Mean)/result.SD):F2} DE)";
        showAddModal = false;

        // Keep selections so user views their new result
        selectedEquipment = result.EquipmentName;
        selectedAnalyte = result.AnalyteName;
        selectedLevel = result.Level;

        await LoadData();
    }

    private async Task DeleteResult(IQCResult result)
    {
        DbContext.IQCResults.Remove(result);

        var audit = new AuditLog
        {
            Id = Guid.NewGuid(),
            Action = "DELETE",
            EntityType = "IQCResult",
            EntityId = result.Id,
            Details = $"Resultado IQC '{result.AnalyteName}' eliminado. Valor: {result.Value} del {result.Date:dd/MM/yyyy}",
            UserId = currentUserId ?? Guid.Empty,
            UserName = currentUserName ?? "Sistema",
            Timestamp = DateTime.UtcNow,
            MachineName = Environment.MachineName,
            Result = "Success"
        };
        DbContext.AuditLogs.Add(audit);

        await DbContext.SaveChangesAsync();
        statusMessage = "Registro de IQC eliminado del historial.";
        
        await LoadData();
    }

    private void RunWestgardValidation(List<IQCResult> points)
    {
        for (int i = 0; i < points.Count; i++)
        {
            var current = points[i];
            if (current.SD <= 0)
            {
                current.Status = IQCStatus.OK;
                current.WestgardRule = null;
                continue;
            }

            double z = (current.Value - current.Mean) / current.SD;
            double absZ = Math.Abs(z);

            current.Status = IQCStatus.OK;
            current.WestgardRule = null;

            // 1. 1-3s Rule (Rejection)
            if (absZ >= 3.0)
            {
                current.Status = IQCStatus.REJECTED;
                current.WestgardRule = "1-3s";
                continue;
            }

            // 2. 2-2s Rule (Rejection)
            if (i >= 1)
            {
                var prev = points[i - 1];
                double prevZ = (prev.Value - prev.Mean) / prev.SD;
                if ((z >= 2.0 && prevZ >= 2.0) || (z <= -2.0 && prevZ <= -2.0))
                {
                    current.Status = IQCStatus.REJECTED;
                    current.WestgardRule = "2-2s";
                    continue;
                }
            }

            // 3. R-4s Rule (Rejection)
            if (i >= 1)
            {
                var prev = points[i - 1];
                double prevZ = (prev.Value - prev.Mean) / prev.SD;
                if ((z >= 2.0 && prevZ <= -2.0) || (z <= -2.0 && prevZ >= 2.0))
                {
                    current.Status = IQCStatus.REJECTED;
                    current.WestgardRule = "R-4s";
                    continue;
                }
            }

            // 4. 4-1s Rule (Rejection)
            if (i >= 3)
            {
                var p1 = points[i - 1];
                var p2 = points[i - 2];
                var p3 = points[i - 3];
                double z1 = (p1.Value - p1.Mean) / p1.SD;
                double z2 = (p2.Value - p2.Mean) / p2.SD;
                double z3 = (p3.Value - p3.Mean) / p3.SD;

                if ((z >= 1.0 && z1 >= 1.0 && z2 >= 1.0 && z3 >= 1.0) ||
                    (z <= -1.0 && z1 <= -1.0 && z2 <= -1.0 && z3 <= -1.0))
                {
                    current.Status = IQCStatus.REJECTED;
                    current.WestgardRule = "4-1s";
                    continue;
                }
            }

            // 5. 10-x Rule (Rejection)
            if (i >= 9)
            {
                bool allAbove = true;
                bool allBelow = true;
                for (int k = 0; k < 10; k++)
                {
                    var p = points[i - k];
                    double pZ = (p.Value - p.Mean) / p.SD;
                    if (pZ < 0) allAbove = false;
                    if (pZ > 0) allBelow = false;
                }
                if (allAbove || allBelow)
                {
                    current.Status = IQCStatus.REJECTED;
                    current.WestgardRule = "10-x";
                    continue;
                }
            }

            // 6. 1-2s Rule (Warning)
            if (absZ >= 2.0)
            {
                current.Status = IQCStatus.WARNING;
                current.WestgardRule = "1-2s";
                continue;
            }
        }
    }

    private async Task GenerateDemoData()
    {
        // Add 16 points for Hemoglobina, Normal, target mean 14.0, SD 0.4
        string eqName = "Citómetro Hematología Sysmex";
        string anName = "Hemoglobina";
        string lvlName = "Normal Lot A";
        double mean = 14.0;
        double sd = 0.4;

        // Clear existing demo records if any, to start fresh
        var existing = allResults.Where(r => r.EquipmentName == eqName && r.AnalyteName == anName && r.Level == lvlName);
        DbContext.IQCResults.RemoveRange(existing);

        var now = DateTime.UtcNow.AddDays(-16);
        
        // Mock values demonstrating various rules:
        // 1-10: In control, minor fluctuations
        // 11: 1-2s Warning (value = 14.85, z = +2.125)
        // 12: Back in control (value = 14.1)
        // 13: 1-3s Rejection (value = 15.3, z = +3.25)
        // 14: Back in control (value = 13.9)
        // 15-16: 2-2s Rejection (values = 14.85, 14.90, both z > +2.0)
        double[] values = new double[] {
            13.95, 14.12, 13.88, 14.05, 14.22, 13.90, 14.01, 14.10, 13.98, 14.03, // 1-10 OK
            14.85, // 11: 1-2s Warning
            14.10, // 12: OK
            15.30, // 13: 1-3s Rejection
            13.90, // 14: OK
            14.85, 14.90 // 15-16: 2-2s Rejection
        };

        for (int i = 0; i < values.Length; i++)
        {
            var result = new IQCResult
            {
                Id = Guid.NewGuid(),
                EquipmentName = eqName,
                AnalyteName = anName,
                Level = lvlName,
                Value = values[i],
                Mean = mean,
                SD = sd,
                Date = now.AddDays(i).AddHours(i),
                Comments = i switch
                {
                    10 => "Advertencia 1-2s simulada",
                    12 => "Regla 1-3s violada (Rechazo analítico)",
                    15 => "2-2s violada - punto 1",
                    16 => "2-2s violada - punto 2 (Rechazo analítico)",
                    _ => "Simulación de control en rango"
                }
            };
            DbContext.IQCResults.Add(result);
        }

        await DbContext.SaveChangesAsync();

        selectedEquipment = eqName;
        selectedAnalyte = anName;
        selectedLevel = lvlName;

        statusMessage = "Datos de simulación para Hemoglobina generados correctamente.";
        await LoadData();
    }

