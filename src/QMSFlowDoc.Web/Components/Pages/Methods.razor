@page "/methods"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using QMSFlowDoc.Domain.Entities
@using QMSFlowDoc.Infrastructure.Persistence
@attribute [Authorize]
@inject QmsDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Métodos y validación - QMSFlowDoc</PageTitle>
<div class="container py-4"><h2 class="fw-bold">Métodos, validación e incertidumbre</h2><p class="text-muted">Registros ISO 15189 de verificación/validación de métodos e incertidumbre de medida.</p>
@if (!string.IsNullOrWhiteSpace(message)) { <div class="alert alert-info">@message</div> }
<div class="row g-4"><div class="col-lg-4"><div class="card"><div class="card-body"><h5>Nuevo método</h5><input class="form-control mb-2" placeholder="Código" @bind="method.Code" /><input class="form-control mb-2" placeholder="Nombre" @bind="method.Name" /><input class="form-control mb-2" placeholder="Categoría" @bind="method.Category" /><button class="btn btn-primary" @onclick="SaveMethod">Guardar método</button></div></div><div class="card mt-3"><div class="card-body"><h5>Incertidumbre de medida</h5><select class="form-select mb-2" @bind="uncertainty.MethodId"><option value="@Guid.Empty">Método</option>@foreach(var item in methods){<option value="@item.Id">@item.Code - @item.Name</option>}</select><input class="form-control mb-2" placeholder="Analito" @bind="uncertainty.AnalyteName" /><input type="number" step="0.0001" class="form-control mb-2" placeholder="Valor" @bind="uncertainty.Value" /><input class="form-control mb-2" placeholder="Unidad" @bind="uncertainty.Unit" /><button class="btn btn-outline-primary" @onclick="SaveUncertainty">Registrar incertidumbre</button></div></div></div>
<div class="col-lg-8"><table class="table"><thead><tr><th>Código</th><th>Nombre</th><th>Estado</th><th>Incertidumbres</th></tr></thead><tbody>@foreach(var item in methods){<tr><td>@item.Code</td><td>@item.Name</td><td>@item.Status</td><td>@uncertainties.Count(u=>u.MethodId==item.Id)</td></tr>}</tbody></table><div class="card mb-3"><div class="card-body"><h5>Nueva versión</h5><select class="form-select mb-2" @bind="version.MethodId"><option value="@Guid.Empty">Método</option>@foreach(var item in methods){<option value="@item.Id">@item.Code - @item.Name</option>}</select><input class="form-control mb-2" placeholder="Versión" @bind="version.Version" /><textarea class="form-control mb-2" placeholder="Descripción del cambio" @bind="version.ChangeDescription"></textarea><button class="btn btn-outline-primary" @onclick="SaveVersion">Registrar versión</button></div></div><div class="card"><div class="card-body"><h5>Verificación / validación</h5><p class="small text-muted">Seleccione una versión de método existente e introduzca el parámetro evaluado, resultado y número de experimentos.</p><select class="form-select mb-2" @bind="validation.MethodVersionId"><option value="@Guid.Empty">Versión de método</option>@foreach(var v in versions){<option value="@v.Id">@v.Version (@v.Status)</option>}</select><input class="form-control mb-2" placeholder="Parámetro (precisión, sesgo, linealidad...)" @bind="validation.Parameter" /><input class="form-control mb-2" placeholder="Resultado / criterio de aceptación" @bind="validation.Result" /><input type="number" class="form-control mb-2" @bind="validation.ExperimentCount" /><button class="btn btn-outline-success" @onclick="SaveValidation">Registrar validación</button></div></div></div></div></div>
<div class="container pb-4"><div class="card"><div class="card-body"><h5>Versiones pendientes de aprobación</h5>
@foreach (var pendingVersion in versions.Where(v => v.Status == "DRAFT"))
{
    <div class="d-flex align-items-center gap-3 border-bottom py-2"><span>@pendingVersion.Version</span><span class="text-muted">@pendingVersion.ChangeDescription</span><button class="btn btn-sm btn-outline-success" @onclick="() => ApproveVersion(pendingVersion)">Aprobar versión</button></div>
}
</div></div></div>

@code {
private List<Method> methods = new(); private List<MethodVersion> versions = new(); private List<MeasurementUncertainty> uncertainties = new(); private Method method = new(); private MethodVersion version = new(); private MeasurementUncertainty uncertainty = new(){EstimatedDate=DateTime.Today}; private MethodValidation validation = new(); private string? message;
protected override async Task OnInitializedAsync()=>await Load();
private async Task Load(){methods=await DbContext.Methods.OrderBy(m=>m.Code).ToListAsync(); versions=await DbContext.MethodVersions.OrderByDescending(v=>v.CreatedAt).ToListAsync(); uncertainties=await DbContext.MeasurementUncertainties.ToListAsync();}
private async Task SaveMethod(){if(string.IsNullOrWhiteSpace(method.Code)||string.IsNullOrWhiteSpace(method.Name)){message="Código y nombre son obligatorios.";return;} method.Id=Guid.NewGuid();method.CreatedAt=DateTime.UtcNow;DbContext.Methods.Add(method);var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;DbContext.AuditLogs.Add(new AuditLog{Id=Guid.NewGuid(),Timestamp=DateTime.UtcNow,UserName=user.Identity?.Name??"Sistema",Action="CREATE",EntityType="Method",EntityId=method.Id,Details=$"Método registrado: {method.Code} - {method.Name}",Result="OK",MachineName=Environment.MachineName});await DbContext.SaveChangesAsync();message="Método registrado.";method=new();await Load();}
private async Task SaveUncertainty(){if(uncertainty.MethodId==Guid.Empty||string.IsNullOrWhiteSpace(uncertainty.AnalyteName)||string.IsNullOrWhiteSpace(uncertainty.Unit)){message="Método, analito y unidad son obligatorios.";return;} uncertainty.Id=Guid.NewGuid();DbContext.MeasurementUncertainties.Add(uncertainty);await AddAuditAsync("MeasurementUncertainty",uncertainty.Id,$"Incertidumbre registrada: {uncertainty.AnalyteName} = {uncertainty.Value} {uncertainty.Unit}");await DbContext.SaveChangesAsync();message="Incertidumbre registrada.";uncertainty=new(){EstimatedDate=DateTime.Today};await Load();}
private async Task SaveVersion(){if(version.MethodId==Guid.Empty||string.IsNullOrWhiteSpace(version.Version)){message="Método y versión son obligatorios.";return;}version.Id=Guid.NewGuid();version.CreatedAt=DateTime.UtcNow;version.CreatedBy=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name??"Sistema";DbContext.MethodVersions.Add(version);await AddAuditAsync("MethodVersion",version.Id,$"Versión registrada: {version.Version}");await DbContext.SaveChangesAsync();message="Versión registrada.";version=new();await Load();}
private async Task SaveValidation(){if(validation.MethodVersionId==Guid.Empty||string.IsNullOrWhiteSpace(validation.Parameter)||string.IsNullOrWhiteSpace(validation.Result)){message="Versión, parámetro y resultado son obligatorios.";return;}validation.Id=Guid.NewGuid();DbContext.MethodValidations.Add(validation);await AddAuditAsync("MethodValidation",validation.Id,$"Validación registrada: {validation.Parameter}");await DbContext.SaveChangesAsync();message="Validación registrada.";validation=new();}
private async Task ApproveVersion(MethodVersion item)
{
    var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "Sistema";
    item.Status = "APPROVED"; item.ApprovedBy = user; item.ApprovedAt = DateTime.UtcNow;
    await AddAuditAsync("MethodVersion", item.Id, $"Version approved: {item.Version}");
    await DbContext.SaveChangesAsync(); message = "Versión aprobada formalmente."; await Load();
}
private async Task AddAuditAsync(string entityType,Guid entityId,string details){var user=(await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;DbContext.AuditLogs.Add(new AuditLog{Id=Guid.NewGuid(),Timestamp=DateTime.UtcNow,UserName=user.Identity?.Name??"Sistema",Action="CREATE",EntityType=entityType,EntityId=entityId,Details=details,Result="OK",MachineName=Environment.MachineName});}
}
