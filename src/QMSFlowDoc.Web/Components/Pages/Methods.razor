    private static string VersionStatusLabel(string status) => status switch { "DRAFT" => "Borrador", "UNDER_EVALUATION" => "En evaluación", "READY_FOR_APPROVAL" => "Pendiente de aprobación", "APPROVED" => "Aprobada", "OBSOLETE" => "Obsoleta", _ => status };
    private static readonly MethodValidationCharacteristic[] ValidationCharacteristics = Enum.GetValues<MethodValidationCharacteristic>();

    private void OpenMethodDetail(Guid methodId) => Navigation.NavigateTo($"/methods/{methodId}");
    private static string ValidationCharacteristicLabel(MethodValidationCharacteristic characteristic) => characteristic switch { MethodValidationCharacteristic.PRECISION => "Precisión", MethodValidationCharacteristic.COMPARISON_OR_TRUENESS => "Comparación / veracidad", MethodValidationCharacteristic.ANALYTICAL_SENSITIVITY => "Sensibilidad analítica", MethodValidationCharacteristic.ANALYTICAL_SPECIFICITY => "Especificidad analítica", MethodValidationCharacteristic.LINEARITY_OR_REPORTABLE_RANGE => "Linealidad / intervalo reportable", MethodValidationCharacteristic.SAMPLE_STABILITY => "Estabilidad de la muestra", MethodValidationCharacteristic.GATING_REPRODUCIBILITY => "Reproducibilidad de gating", MethodValidationCharacteristic.INSTRUMENT_QC => "Cualificación / QC del instrumento", _ => "Sin clasificar" };

    private async Task<string?> GetApprovalBlockingIssueAsync(Method methodToApprove, MethodVersion versionToApprove)
    {
        if (methodToApprove.DocumentId is not Guid procedureDocumentId
            || !await DbContext.Documents.AnyAsync(d => d.Id == procedureDocumentId && !d.IsDeleted && d.Status == DocumentStatus.APPROVED && d.DocumentType!.TypeCode == "PRO"))
            return "Debe vincularse un PNT vigente de tipo Procedimiento antes de aprobar la versión.";
        if (versionToApprove.ValidationReportDocumentId is not Guid reportDocumentId
            || !await DbContext.Documents.AnyAsync(d => d.Id == reportDocumentId && !d.IsDeleted && d.Status == DocumentStatus.APPROVED && d.DocumentType!.TypeCode == "VAL"))
            return "Debe vincularse un informe vigente de tipo 'Informe de validación/verificación' antes de aprobar.";
        if (string.IsNullOrWhiteSpace(versionToApprove.EvaluationScope) || string.IsNullOrWhiteSpace(versionToApprove.AcceptanceCriteria)
            || string.IsNullOrWhiteSpace(versionToApprove.StudyDesign) || string.IsNullOrWhiteSpace(versionToApprove.DataSources))
            return "La versión no contiene alcance, criterios, diseño y fuentes de datos completos.";
        if (methodToApprove.RegulatoryClassification == MethodRegulatoryClassification.CE_IVD_VERIFICATION
            && (string.IsNullOrWhiteSpace(versionToApprove.Manufacturer) || string.IsNullOrWhiteSpace(versionToApprove.InstructionsForUseVersion)))
            return "Para un método CE-IVD deben registrarse fabricante/kit y versión de la IFU.";
        var checks = await DbContext.MethodValidations.Where(v => v.MethodVersionId == versionToApprove.Id).ToListAsync();
        if (checks.Count == 0) return "Debe registrar al menos un parámetro de verificación/validación antes de aprobar.";
        if (checks.Any(v => !string.Equals(v.Conclusion, "CUMPLE", StringComparison.OrdinalIgnoreCase)))
            return "Todos los parámetros de verificación/validación deben tener conclusión 'CUMPLE' antes de aprobar.";
        var requiredCharacteristics = new List<MethodValidationCharacteristic>
        {
            MethodValidationCharacteristic.PRECISION,
            MethodValidationCharacteristic.COMPARISON_OR_TRUENESS,
            MethodValidationCharacteristic.GATING_REPRODUCIBILITY,
            MethodValidationCharacteristic.INSTRUMENT_QC
        };
        if (methodToApprove.RegulatoryClassification is MethodRegulatoryClassification.IN_HOUSE_VALIDATION or MethodRegulatoryClassification.MODIFIED_CE_IVD_VALIDATION)
        {
            requiredCharacteristics.Add(MethodValidationCharacteristic.ANALYTICAL_SENSITIVITY);
            requiredCharacteristics.Add(MethodValidationCharacteristic.ANALYTICAL_SPECIFICITY);
        }
        if (methodToApprove.ResultType == ExaminationResultType.QUANTITATIVE)
            requiredCharacteristics.Add(MethodValidationCharacteristic.LINEARITY_OR_REPORTABLE_RANGE);
        var missing = requiredCharacteristics.Where(c => !checks.Any(v => v.Characteristic == c && string.Equals(v.Conclusion, "CUMPLE", StringComparison.OrdinalIgnoreCase))).ToList();
        if (missing.Count > 0)
            return $"Faltan características obligatorias con resultado 'CUMPLE': {string.Join(", ", missing.Select(ValidationCharacteristicLabel))}.";
        return null;
    }

