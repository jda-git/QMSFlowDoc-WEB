    private static string ResultTypeLabel(ExaminationResultType resultType) => resultType switch { ExaminationResultType.QUANTITATIVE => "Cuantitativo", ExaminationResultType.SEMI_QUANTITATIVE => "Semicuantitativo", ExaminationResultType.QUALITATIVE => "Cualitativo", ExaminationResultType.INTERPRETATIVE => "Interpretativo", _ => "Sin clasificar" };
