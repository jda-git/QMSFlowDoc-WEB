@page "/environmental"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using QMSFlowDoc.Application.Services.Environmental
@using QMSFlowDoc.Domain.Entities
@using QMSFlowDoc.Infrastructure.Persistence
@using QMSFlowDoc.Infrastructure.Services.Environmental
@attribute [Authorize]
@inject EnvironmentalImportService ImportService
@inject QmsDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Environmental> Logger
@inject QMSFlowDoc.Web.Services.EnvironmentalPdfReportService PdfReportService
@inject IJSRuntime JS

<PageTitle>Monitorización ambiental - QMSFlowDoc</PageTitle>

<div class="container py-4">
    <h2 class="fw-bold"><i class="bi bi-thermometer-half text-primary me-2"></i>Monitorización ambiental</h2>
    <p class="text-muted">Importación mensual de nevera, congelador, temperatura y humedad ambiental (ISO 15189 §6.3).</p>

    @if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger">@error</div> }
    @if (summary is not null) { <div class="alert alert-success">Importación completada: @summary.ImportedReadings lecturas, @summary.CentralEvents eventos CENTRAL, @summary.OutOfRangeReadings fuera de rango, @summary.DisconnectedSensors sondas NC y @summary.Duplicates duplicados omitidos. Periodo: @summary.PeriodStart.ToString("d") - @summary.PeriodEnd.ToString("d").</div> }

    <div class="card shadow-sm mb-4"><div class="card-body">
        <h5>Importar fichero mensual</h5>
        <p class="small text-muted">Formato: <code>fecha;hora;NEVERA;temp;tempCongelador/NC</code>, <code>HABITACION;temp;humedad</code> y eventos <code>CENTRAL</code>.</p>
        <InputFile OnChange="ImportAsync" accept=".txt,text/plain" class="form-control" />
        <div class="mt-3"><label class="small me-2">Lote mensual</label><select class="form-select d-inline-block w-auto" @bind="selectedBatchId">@foreach (var batch in batches) { <option value="@batch">@batch</option> }</select>
        <button class="btn btn-outline-primary ms-2" @onclick="DownloadReportAsync" disabled="@(string.IsNullOrWhiteSpace(selectedBatchId))"><i class="bi bi-file-earmark-pdf me-2"></i>Generar informe PDF</button></div>
    </div></div>

    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card"><div class="card-body"><strong>Nevera</strong><br />2 a 8 °C</div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><strong>Congelador</strong><br />−25 a −15 °C</div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><strong>Habitación</strong><br />18 a 25 °C</div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><strong>Humedad</strong><br />40 a 60 %</div></div></div>
    </div>

    <table class="table table-sm"><thead><tr><th>Fecha/hora</th><th>Origen</th><th>Temperatura</th><th>Humedad</th><th>Estado</th></tr></thead><tbody>
    @foreach (var reading in recentReadings) { <tr class="@(reading.IsOutOfRange ? "table-danger" : "")"><td>@reading.RecordedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@reading.Source</td><td>@(reading.SensorNotConnected ? "NC" : reading.TemperatureCelsius?.ToString("N1"))</td><td>@reading.HumidityPercent?.ToString("N0")</td><td>@(reading.IsOutOfRange ? "Fuera de rango" : "Correcto")</td></tr> }
    </tbody></table>
</div>

@code {
    private string? error;
    private EnvironmentalImportSummary? summary;
    private List<EnvironmentalReading> recentReadings = new();
    private List<string> batches = new();
    private string? selectedBatchId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        try
        {
            error = null;
            var file = args.File;
            if (!file.Name.EndsWith(".txt", StringComparison.OrdinalIgnoreCase)) throw new InvalidOperationException("Seleccione un fichero .txt.");
            await using var stream = file.OpenReadStream(20 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "Usuario";
            summary = await ImportService.ImportAsync(await reader.ReadToEndAsync(), user, await ImportService.GetRangesAsync());
            await LoadAsync();
        }
        catch (Exception ex)
        {
            var incidentId = Guid.NewGuid().ToString("N")[..8].ToUpperInvariant();
            Logger.LogError(ex, "Environmental import error. IncidentId: {IncidentId}", incidentId);
            error = $"No se ha podido importar el fichero. Indique la incidencia {incidentId} al administrador.";
        }
    }

    private async Task LoadAsync()
    {
        recentReadings = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(DbContext.EnvironmentalReadings.OrderByDescending(r => r.RecordedAt).Take(100));
        batches = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(DbContext.EnvironmentalReadings.Select(r => r.ImportBatchId).Distinct().OrderByDescending(b => b));
        selectedBatchId ??= batches.FirstOrDefault();
    }

    private async Task DownloadReportAsync()
    {
        var readings = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(DbContext.EnvironmentalReadings.Where(r => r.ImportBatchId == selectedBatchId).OrderBy(r => r.RecordedAt));
        var report = EnvironmentalMonthlyReportBuilder.Build(readings);
        var pdf = PdfReportService.Create(report, "QMSFlowDoc");
        var base64 = Convert.ToBase64String(pdf);
        await JS.InvokeVoidAsync("open", $"data:application/pdf;base64,{base64}", "_blank");
    }
}
