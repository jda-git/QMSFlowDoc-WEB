@page "/environmental"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using QMSFlowDoc.Application.Services.Environmental
@using QMSFlowDoc.Domain.Entities
@using QMSFlowDoc.Infrastructure.Persistence
@using QMSFlowDoc.Infrastructure.Services.Environmental
@attribute [Authorize]
@inject EnvironmentalImportService ImportService
@inject QmsDbContext DbContext
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<Environmental> Logger
@inject QMSFlowDoc.Web.Services.EnvironmentalPdfReportService PdfReportService
@inject IJSRuntime JS

<PageTitle>Monitorización ambiental - QMSFlowDoc</PageTitle>

<div class="container py-4">
    <h2 class="fw-bold"><i class="bi bi-thermometer-half text-primary me-2"></i>Monitorización ambiental</h2>
    <p class="text-muted">Importación mensual de nevera, congelador, temperatura y humedad ambiental (ISO 15189 §6.3).</p>

    @if (!string.IsNullOrWhiteSpace(error)) { <div class="alert alert-danger">@error</div> }
    @if (summary is not null) { <div class="alert alert-success">Importación completada: @summary.ImportedReadings lecturas, @summary.CentralEvents eventos CENTRAL, @summary.OutOfRangeReadings fuera de rango, @summary.DisconnectedSensors sondas NC y @summary.Duplicates duplicados omitidos. Periodo: @summary.PeriodStart.ToString("d") - @summary.PeriodEnd.ToString("d").</div> }

    <div class="card shadow-sm mb-4"><div class="card-body">
        <h5>Importar fichero mensual</h5>
        <p class="small text-muted">Formato: <code>fecha;hora;NEVERA;temp;tempCongelador/NC</code>, <code>HABITACION;temp;humedad</code> y eventos <code>CENTRAL</code>.</p>
        <InputFile OnChange="ImportAsync" accept=".txt,text/plain" class="form-control" />
        <div class="mt-3"><label class="small me-2">Lote mensual</label><select class="form-select d-inline-block w-auto" @bind="selectedBatchId" @bind:after="LoadAsync">@foreach (var batch in batches) { <option value="@batch.Id">@batch.Label</option> }</select>
        <button class="btn btn-outline-primary ms-2" @onclick="DownloadReportAsync" disabled="@(string.IsNullOrWhiteSpace(selectedBatchId))"><i class="bi bi-file-earmark-pdf me-2"></i>Generar informe PDF</button>
        <button class="btn btn-outline-success ms-2" @onclick="DownloadCsvAsync" disabled="@(string.IsNullOrWhiteSpace(selectedBatchId))"><i class="bi bi-filetype-csv me-2"></i>Descargar CSV mensual</button></div>
    </div></div>

    @if (chartMinDate.HasValue)
    {
        <div class="card mb-3"><div class="card-body d-flex align-items-end gap-3 flex-wrap"><div><label class="form-label mb-1">Semana representada (día de inicio)</label><input type="date" class="form-control" min="@chartMinDate.Value.ToString("yyyy-MM-dd")" max="@chartMaxDate.Value.ToString("yyyy-MM-dd")" @bind="chartStartDate" @bind:format="yyyy-MM-dd" /></div><div class="small text-muted pb-2">Se muestran todas las lecturas horarias desde las 00:00 del día elegido hasta las 23:59 del sexto día siguiente.</div></div></div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="card"><div class="card-body"><strong>Nevera</strong><br />2 a 8 °C</div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><strong>Congelador</strong><br />−25 a −15 °C</div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><strong>Habitación</strong><br />18 a 25 °C</div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><strong>Humedad</strong><br />40 a 60 %</div></div></div>
    </div>

    <div class="d-flex flex-column">
    <div class="card mt-4 order-2"><div class="card-body"><h5>Datos del lote mensual (@chartReadings.Count lecturas)</h5><div style="max-height: 620px; overflow-y: auto;" class="border rounded"><table class="table table-sm mb-0"><thead class="table-light sticky-top"><tr><th>Fecha/hora</th><th>Origen</th><th>Temperatura</th><th>Humedad</th><th>Estado</th></tr></thead><tbody>
    @foreach (var reading in chartReadings) { <tr class="@(reading.IsOutOfRange ? "table-danger" : reading.SensorNotConnected ? "table-warning" : "")"><td>@reading.RecordedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@reading.Source</td><td>@(reading.SensorNotConnected ? "NC" : reading.TemperatureCelsius?.ToString("N1"))</td><td>@reading.HumidityPercent?.ToString("N0")</td><td>@(reading.SensorNotConnected ? "Sonda no conectada" : reading.IsOutOfRange ? "Fuera de rango" : "Correcto")</td></tr> }
    </tbody></table></div></div></div>

    @*
