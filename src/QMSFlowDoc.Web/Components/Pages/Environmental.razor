    *@
    @if (TemperatureData.Any())
    {
        <div class="card mt-4"><div class="card-body"><h5>Temperaturas — semana seleccionada</h5><p class="small text-muted">Todas las lecturas horarias. Eje Y: temperatura (°C). Eje X: días de la semana.</p><canvas id="environmental-temperature-chart" class="w-100" style="height:360px" aria-label="Gráfico horario de temperaturas de la semana"></canvas></div></div>
    }
    @if (RoomTemperatureData.Any() || HumidityData.Any())
    {
        <div class="card mt-4"><div class="card-body"><h5>Habitación: temperatura y humedad — semana seleccionada</h5><p class="small text-muted">Lecturas horarias. Temperatura en naranja (eje izquierdo, °C) y humedad en azul (eje derecho, %).</p><canvas id="environmental-room-chart" class="w-100" style="height:360px" aria-label="Gráfico horario combinado de temperatura y humedad"></canvas></div></div>
    }
    </div>
</div>

@code {
    private string? error;
    private EnvironmentalImportSummary? summary;
    private List<EnvironmentalReading> recentReadings = new();
    private List<EnvironmentalReading> chartReadings = new();
    private DateTime? chartStartDate;
    private DateTime? chartMinDate => chartReadings.Count == 0 ? null : chartReadings.Min(r => r.RecordedAt).Date;
    private DateTime? chartMaxDate => chartReadings.Count == 0 ? null : chartReadings.Max(r => r.RecordedAt).Date;
    private List<EnvironmentalBatchOption> batches = new();
    private string? selectedBatchId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task ImportAsync(InputFileChangeEventArgs args)
    {
        try
        {
            error = null;
            var file = args.File;
            if (!file.Name.EndsWith(".txt", StringComparison.OrdinalIgnoreCase)) throw new InvalidOperationException("Seleccione un fichero .txt.");
            await using var stream = file.OpenReadStream(20 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User.Identity?.Name ?? "Usuario";
            summary = await ImportService.ImportAsync(await reader.ReadToEndAsync(), user, await ImportService.GetRangesAsync());
            await LoadAsync();
        }
        catch (Exception ex)
        {
            var incidentId = Guid.NewGuid().ToString("N")[..8].ToUpperInvariant();
            Logger.LogError(ex, "Environmental import error. IncidentId: {IncidentId}", incidentId);
            error = $"No se ha podido importar el fichero. Indique la incidencia {incidentId} al administrador.";
        }
    }

    private async Task LoadAsync()
    {
        recentReadings = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(DbContext.EnvironmentalReadings.OrderByDescending(r => r.RecordedAt).Take(100));
        var batchData = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(DbContext.EnvironmentalReadings
            .GroupBy(r => r.ImportBatchId)
            .Select(group => new { Id = group.Key, Start = group.Min(r => r.RecordedAt), End = group.Max(r => r.RecordedAt), Count = group.Count() })
            .OrderByDescending(batch => batch.End));
        batches = batchData.Select(batch => new EnvironmentalBatchOption(batch.Id, $"{batch.Start.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))} - {batch.Start:dd/MM} a {batch.End:dd/MM/yyyy} ({batch.Count} lecturas)")).ToList();
        selectedBatchId ??= batches.FirstOrDefault()?.Id;
        chartReadings = string.IsNullOrWhiteSpace(selectedBatchId)
            ? new List<EnvironmentalReading>()
            : await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(DbContext.EnvironmentalReadings.Where(r => r.ImportBatchId == selectedBatchId).OrderBy(r => r.RecordedAt));
        if (chartMinDate.HasValue && (!chartStartDate.HasValue || chartStartDate < chartMinDate || chartStartDate > chartMaxDate)) chartStartDate = chartMinDate;
    }

    private async Task DownloadReportAsync()
    {
        var readings = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions.ToListAsync(DbContext.EnvironmentalReadings.Where(r => r.ImportBatchId == selectedBatchId).OrderBy(r => r.RecordedAt));
        var report = EnvironmentalMonthlyReportBuilder.Build(readings);
        var pdf = PdfReportService.Create(report, "QMSFlowDoc");
        var base64 = Convert.ToBase64String(pdf);
        await JS.InvokeVoidAsync("downloadBase64File", base64, $"Informe_ambiental_{report.PeriodStart:yyyy_MM}.pdf", "application/pdf");
    }

    private async Task DownloadCsvAsync()
    {
        if (chartReadings.Count == 0) return;
        var csv = new System.Text.StringBuilder("Fecha;Hora;Origen;Temperatura_C;Humedad_pct;Estado;Evento\r\n");
        foreach (var reading in chartReadings.OrderBy(r => r.RecordedAt).ThenBy(r => r.Source))
        {
            var state = reading.SensorNotConnected ? "Sonda no conectada" : reading.IsOutOfRange ? "Fuera de rango" : "Correcto";
            csv.Append(reading.RecordedAt.ToString("dd/MM/yyyy")).Append(';')
                .Append(reading.RecordedAt.ToString("HH:mm:ss")).Append(';')
                .Append(reading.Source).Append(';')
                .Append(reading.SensorNotConnected ? "NC" : reading.TemperatureCelsius?.ToString(System.Globalization.CultureInfo.InvariantCulture)).Append(';')
                .Append(reading.HumidityPercent?.ToString(System.Globalization.CultureInfo.InvariantCulture)).Append(';')
                .Append(CsvValue(state)).Append(';').Append(CsvValue(reading.Event)).Append("\r\n");
        }
        var month = chartReadings.Min(r => r.RecordedAt).ToString("yyyy_MM");
        await JS.InvokeVoidAsync("downloadFile", csv.ToString(), $"Datos_ambientales_{month}.csv", "text/csv");
    }

    private static string CsvValue(string? value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        const string quote = "\"";
        return quote + value.Replace(quote, quote + quote) + quote;
    }

    private sealed record EnvironmentalBatchOption(string Id, string Label);

    private IEnumerable<EnvironmentalReading> WeekReadings => chartStartDate.HasValue ? chartReadings.Where(r => r.RecordedAt >= chartStartDate.Value.Date && r.RecordedAt < chartStartDate.Value.Date.AddDays(7)) : Enumerable.Empty<EnvironmentalReading>();
    private List<EnvironmentalReading> TemperatureData => WeekReadings.Where(r => r.TemperatureCelsius.HasValue).OrderBy(r => r.RecordedAt).ToList();
    private List<EnvironmentalReading> RoomTemperatureData => WeekReadings.Where(r => r.Source == EnvironmentalSource.ROOM && r.TemperatureCelsius.HasValue).OrderBy(r => r.RecordedAt).ToList();
    private List<EnvironmentalReading> HumidityData => WeekReadings.Where(r => r.Source == EnvironmentalSource.ROOM && r.HumidityPercent.HasValue).OrderBy(r => r.RecordedAt).ToList();

    private IEnumerable<(double X, double Y, string Color)> TemperaturePoints(EnvironmentalSource source, string color)
    {
        var all = TemperatureData;
        var range = AxisRange(all.Select(r => r.TemperatureCelsius!.Value));
        return all.Where(r => r.Source == source).Select(r => (TimeX(r.RecordedAt, all), ValueY(r.TemperatureCelsius!.Value, range), color));
    }

    private IEnumerable<(double X, double Y)> HumidityPoints()
    {
        var all = HumidityData;
        var range = AxisRange(all.Select(r => r.HumidityPercent!.Value));
        return all.Select(r => (TimeX(r.RecordedAt, all), ValueY(r.HumidityPercent!.Value, range)));
    }

    private IEnumerable<(double Y, string Label)> TemperatureTicks() => ValueTicks(AxisRange(TemperatureData.Select(r => r.TemperatureCelsius!.Value)), "N1");
    private IEnumerable<(double Y, string Label)> HumidityTicks() => ValueTicks(AxisRange(HumidityData.Select(r => r.HumidityPercent!.Value)), "N0");
    private IEnumerable<(double X, string Label)> TemperatureDateTicks() => DateTicks(TemperatureData);
    private IEnumerable<(double X, string Label)> HumidityDateTicks() => DateTicks(HumidityData);

    private static (decimal Min, decimal Max) AxisRange(IEnumerable<decimal> values)
    {
        var list = values.ToList();
        if (list.Count == 0) return (0m, 1m);
        var min = list.Min(); var max = list.Max();
        var padding = Math.Max(1m, (max - min) * 0.1m);
        return (min - padding, max + padding);
    }

    private static double ValueY(decimal value, (decimal Min, decimal Max) range) => 190d - (double)((value - range.Min) / (range.Max - range.Min)) * 170d;
    private static double TimeX(DateTime value, IReadOnlyList<EnvironmentalReading> data)
    {
        if (data.Count < 2) return 484d;
        var span = (data[^1].RecordedAt - data[0].RecordedAt).TotalSeconds;
        return span <= 0 ? 484d : 88d + 792d * (value - data[0].RecordedAt).TotalSeconds / span;
    }

    private static IEnumerable<(double Y, string Label)> ValueTicks((decimal Min, decimal Max) range, string format) => Enumerable.Range(0, 5).Select(index =>
    {
        var value = range.Min + (range.Max - range.Min) * index / 4m;
        return (190d - index * 42.5d, value.ToString(format));
    });

    private static IEnumerable<(double X, string Label)> DateTicks(IReadOnlyList<EnvironmentalReading> data)
    {
        if (data.Count == 0) return Enumerable.Empty<(double, string)>();
        var first = data[0].RecordedAt; var last = data[^1].RecordedAt;
        return Enumerable.Range(0, 3).Select(index =>
        {
            var timestamp = first.AddTicks((last - first).Ticks * index / 2);
            return (TimeX(timestamp, data), timestamp.ToString("dd/MM HH:mm"));
        });
    }

    private static Microsoft.AspNetCore.Components.MarkupString SvgLabel(double x, double y, string label, string anchor = "start", string? transform = null)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(label);
        var transformAttribute = string.IsNullOrWhiteSpace(transform) ? string.Empty : $" transform=\"{transform}\"";
        return new Microsoft.AspNetCore.Components.MarkupString($"<text x=\"{x:F1}\" y=\"{y:F1}\" text-anchor=\"{anchor}\" font-size=\"11\" fill=\"#495057\"{transformAttribute}>{encoded}</text>");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (TemperatureData.Any())
            await JS.InvokeVoidAsync("qmsEnvironmentalCharts.draw", "environmental-temperature-chart", new
            {
                leftUnit = "°C", rightUnit = (string?)null,
                series = new[]
                {
                    ChartSeries("Nevera", "#0d6efd", TemperatureData.Where(r => r.Source == EnvironmentalSource.REFRIGERATOR), "left", r => r.TemperatureCelsius),
                    ChartSeries("Congelador", "#6f42c1", TemperatureData.Where(r => r.Source == EnvironmentalSource.FREEZER), "left", r => r.TemperatureCelsius),
                    ChartSeries("Habitación", "#198754", TemperatureData.Where(r => r.Source == EnvironmentalSource.ROOM), "left", r => r.TemperatureCelsius)
                }
            });

        if (RoomTemperatureData.Any() || HumidityData.Any())
            await JS.InvokeVoidAsync("qmsEnvironmentalCharts.draw", "environmental-room-chart", new
            {
                leftUnit = "°C", rightUnit = "%",
                series = new[]
                {
                    ChartSeries("Temperatura habitación", "#f97316", RoomTemperatureData, "left", r => r.TemperatureCelsius),
                    ChartSeries("Humedad habitación", "#0ea5e9", HumidityData, "right", r => r.HumidityPercent)
                }
            });
    }

    private static object ChartSeries(string name, string color, IEnumerable<EnvironmentalReading> readings, string axis, Func<EnvironmentalReading, decimal?> value) => new
    {
        name, color, axis,
        points = readings.Where(r => value(r).HasValue).OrderBy(r => r.RecordedAt).Select(r => new { date = r.RecordedAt.ToString("yyyy-MM-ddTHH:mm:ss"), value = value(r)!.Value })
    };
}
