@page "/eqa"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using QMSFlowDoc.Domain.Entities
@using QMSFlowDoc.Application.Services.EQA
@using QMSFlowDoc.Application.Services.Identity
@using QMSFlowDoc.Application.Services.Equipment
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@inject IEQAService EQAService
@inject IPermissionService PermissionService
@inject IEquipmentService EquipmentService
@inject IJSRuntime JS
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject QMSFlowDoc.Infrastructure.Persistence.QmsDbContext DbContext
@inject QMSFlowDoc.Application.Services.Quality.IQualityService QualityService


<PageTitle>Evaluación Externa de la Calidad (EQA) — QMSFlowDoc</PageTitle>

<div class="container-fluid py-4 px-4">
    @if (!isAuthorized)
    {
        <div class="alert alert-danger rounded-4 shadow-sm p-4 d-flex align-items-center" role="alert">
            <i class="bi bi-shield-lock-fill fs-1 me-4"></i>
            <div>
                <h4 class="alert-heading fw-bold mb-1">Acceso Denegado</h4>
                <p class="mb-0">No tiene los permisos de lectura suficientes para acceder a la gestión de EQA (ISO 15189 §7.3.7.3).</p>
            </div>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h2 class="fw-bold text-dark mb-1">
                    <i class="bi bi-globe text-primary me-2"></i>Evaluación Externa de la Calidad (EQA)
                </h2>
                <p class="text-muted mb-0">Control interlaboratorios y aseguramiento de la validez de los resultados clínicos (ISO 15189:2022 §7.3.7.3).</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary rounded-pill px-3" @onclick="() => LoadData()">
                    <i class="bi bi-arrow-clockwise me-1"></i>Actualizar
                </button>
                @if (canCreate)
                {
                    <button class="btn btn-primary rounded-pill px-4" @onclick="OpenCreateProgramModal">
                        <i class="bi bi-plus-circle me-2"></i>Nuevo Programa
                    </button>
                }
            </div>
        </div>

        <!-- Navigation Tabs -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 pt-3 pb-0 px-4">
                <ul class="nav nav-tabs nav-tabs-premium border-0" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "dashboard" ? "active" : "")" @onclick='() => ChangeTab("dashboard")'>
                            <i class="bi bi-grid-1x2-fill me-2"></i>Dashboard y Alertas
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "programs" ? "active" : "")" @onclick='() => ChangeTab("programs")'>
                            <i class="bi bi-card-list me-2"></i>Catálogo de Programas
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "enrollments" ? "active" : "")" @onclick='() => ChangeTab("enrollments")'>
                            <i class="bi bi-journal-check me-2"></i>Inscripciones y Calendario
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "rounds" ? "active" : "")" @onclick='() => ChangeTab("rounds")'>
                            <i class="bi bi-calendar-event me-2"></i>Gestión de Rondas
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "deviations" ? "active" : "")" @onclick='() => ChangeTab("deviations")'>
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Desviaciones y CAPA
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <!-- TAB CONTENT -->
        <div class="tab-content">
            @if (activeTab == "dashboard")
            {
                <!-- DASHBOARD -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-4 h-100 position-relative overflow-hidden">
                            <h6 class="text-white-50 fw-semibold mb-1">Inscripciones Activas</h6>
                            <h2 class="fw-bold mb-0">@programs?.Count(p => p.Status == EQAStatus.ACTIVE) / @programs?.Count</h2>
                            <p class="small text-white-50 mt-2 mb-0">Programas de citometría en curso</p>
                            <i class="bi bi-award-fill position-absolute end-0 bottom-0 opacity-10 fs-1 me-3 mb-2" style="font-size: 5rem !important;"></i>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 bg-success text-white p-4 h-100 position-relative overflow-hidden">
                            <h6 class="text-white-50 fw-semibold mb-1">Satisfactorios (2026)</h6>
                            <h2 class="fw-bold mb-0">
                                @(rounds?.Count(r => r.Year == 2026 && r.GlobalOutcome == EQAPerformance.SATISFACTORY) ?? 0)
                            </h2>
                            <p class="small text-white-50 mt-2 mb-0">Rondas con desempeño óptimo</p>
                            <i class="bi bi-shield-check position-absolute end-0 bottom-0 opacity-10 fs-1 me-3 mb-2" style="font-size: 5rem !important;"></i>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 bg-warning text-dark p-4 h-100 position-relative overflow-hidden">
                            <h6 class="text-dark-50 fw-semibold mb-1">Acciones Pendientes</h6>
                            <h2 class="fw-bold mb-0">@deviations?.Count(d => d.Status == "Abierta")</h2>
                            <p class="small text-dark-50 mt-2 mb-0">Desviaciones con CAPA abiertas</p>
                            <i class="bi bi-clock-history position-absolute end-0 bottom-0 opacity-10 fs-1 me-3 mb-2" style="font-size: 5rem !important;"></i>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card border-0 shadow-sm rounded-4 bg-danger text-white p-4 h-100 position-relative overflow-hidden">
                            <h6 class="text-white-50 fw-semibold mb-1">No Satisfactorios</h6>
                            <h2 class="fw-bold mb-0">
                                @(rounds?.Count(r => r.GlobalOutcome == EQAPerformance.UNSATISFACTORY) ?? 0)
                            </h2>
                            <p class="small text-white-50 mt-2 mb-0">Rondas fuera de criterio</p>
                            <i class="bi bi-x-circle-fill position-absolute end-0 bottom-0 opacity-10 fs-1 me-3 mb-2" style="font-size: 5rem !important;"></i>
                        </div>
                    </div>
                </div>

                <!-- Alert cards / ISO checklist -->
                <div class="row g-4">
                    <div class="col-md-8">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-bell-fill text-warning me-2"></i>Alertas de Calidad y Plazos</h5>
                                <div class="list-group list-group-flush">
                                    @if (alerts.Any())
                                    {
                                        @foreach (var alert in alerts)
                                        {
                                            <div class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom border-light">
                                                <div class="d-flex align-items-start">
                                                    <i class="bi @alert.Icon fs-5 me-3 @alert.ColorClass"></i>
                                                    <div>
                                                        <h6 class="fw-semibold mb-1">@alert.Title</h6>
                                                        <p class="text-muted small mb-0">@alert.Description</p>
                                                    </div>
                                                </div>
                                                <span class="badge rounded-pill px-2.5 py-1.5 @alert.BadgeClass">@alert.Type</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-center py-5 text-muted">
                                            <i class="bi bi-check-circle-fill text-success fs-1 mb-2 d-block"></i>
                                            <h6 class="fw-semibold">Sin alertas de plazos o desviaciones</h6>
                                            <p class="small mb-0">Todas las rondas e inscripciones cumplen la planificación ISO 15189.</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 bg-light-subtle">
                            <div class="card-body p-4">
                                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-bookmark-star-fill text-primary me-2"></i>ISO 15189 Checklist</h5>
                                <div class="d-flex flex-column gap-3">
                                    @{ var criticalProgramsMetric = CriticalProgramsMetric; }
                                    <div class="p-3 bg-white rounded-3 border">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="small fw-bold">Programas Críticos Inscritos</span>
                                            <span class="badge @GetMetricBadgeClass(criticalProgramsMetric, "success")">@criticalProgramsMetric.Label</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @GetMetricBarClass(criticalProgramsMetric, "success")" style="width: @criticalProgramsMetric.Percentage%;"></div>
                                        </div>
                                    </div>
                                    @{ var roundsOnTimeMetric = RoundsOnTimeMetric; }
                                    <div class="p-3 bg-white rounded-3 border">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="small fw-bold">Rondas en Plazo</span>
                                            <span class="badge @GetMetricBadgeClass(roundsOnTimeMetric, "primary")">@roundsOnTimeMetric.Label</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @GetMetricBarClass(roundsOnTimeMetric, "primary")" style="width: @roundsOnTimeMetric.Percentage%;"></div>
                                        </div>
                                    </div>
                                    @{ var capaEffectivenessMetric = CapaEffectivenessMetric; }
                                    <div class="p-3 bg-white rounded-3 border">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="small fw-bold">Eficacia CAPAs EQA</span>
                                            <span class="badge @GetMetricBadgeClass(capaEffectivenessMetric, "info")">@capaEffectivenessMetric.Label</span>
                                        </div>
                                        <div class="progress" style="height: 6px;">
                                            <div class="progress-bar @GetMetricBarClass(capaEffectivenessMetric, "info")" style="width: @capaEffectivenessMetric.Percentage%;"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (activeTab == "programs")
            {
                <!-- PROGRAMS CATALOG -->
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light small fw-bold text-secondary">
                                <tr>
                                    <th>Código</th>
                                    <th>Programa</th>
                                    <th>Proveedor</th>
                                    <th>Subárea</th>
                                    <th>Tipo Muestra</th>
                                    <th>Periodicidad</th>
                                    <th>Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @if (programs == null)
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-4">Cargando catálogo...</td>
                                    </tr>
                                }
                                else if (!programs.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-4 text-muted">No hay programas de control externo registrados.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var prog in programs)
                                    {
                                        <tr>
                                            <td class="fw-bold">@prog.InternalCode</td>
                                            <td>
                                                <div class="fw-bold text-dark">@prog.Name</div>
                                                <div class="text-muted small">@prog.CoordinatorEntity</div>
                                            </td>
                                            <td>@prog.Provider</td>
                                            <td>
                                                <span class="badge bg-secondary-subtle text-secondary rounded-pill">
                                                    @GetSubAreaName(prog.SubArea)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-info-subtle text-info rounded-pill">
                                                    @prog.SampleType
                                                </span>
                                            </td>
                                            <td>@prog.Periodicity</td>
                                            <td>
                                                <span class="badge rounded-pill @(prog.Status == EQAStatus.ACTIVE ? "bg-success" : "bg-danger")">
                                                    @prog.Status
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                @if (canEdit)
                                                {
                                                    <button class="btn btn-outline-primary btn-sm rounded-pill me-1" @onclick="() => EditProgram(prog)" title="Editar Programa">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                    <button class="btn btn-outline-info btn-sm rounded-pill me-1" @onclick="() => ManageMappings(prog)" title="Gestionar Pruebas">
                                                        <i class="bi bi-link-45deg"></i> Pruebas
                                                    </button>
                                                }
                                                @if (canDelete)
                                                {
                                                    <button class="btn btn-outline-danger btn-sm rounded-pill" @onclick="() => DeleteProgram(prog)" title="Eliminar Programa">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else if (activeTab == "enrollments")
            {
                <!-- ENROLLMENTS AND CALENDAR -->
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 p-4">
                            <h5 class="fw-bold mb-3"><i class="bi bi-journal-check text-primary me-2"></i>Inscripciones Anuales</h5>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-secondary">Año Seleccionado</label>
                                <select class="form-select form-select-premium" @bind="selectedYear" @bind:after="LoadYearEnrollments">
                                    <option value="2026">2026</option>
                                    <option value="2025">2025</option>
                                </select>
                            </div>
                            <div class="list-group">
                                @if (programs != null)
                                {
                                    @foreach (var prog in programs)
                                    {
                                        var enrollment = enrollments?.FirstOrDefault(e => e.ProgramId == prog.Id && e.Year == selectedYear);
                                        <div class="list-group-item list-group-item-action border border-light rounded-3 p-3 mb-2">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h6 class="fw-bold mb-1 text-dark">@prog.Name</h6>
                                                    <p class="small text-muted mb-1">Part. Code: @(enrollment?.ParticipantCode ?? "No Inscrito")</p>
                                                    @if (enrollment?.IsCritical == true)
                                                    {
                                                        <span class="badge bg-danger rounded-pill">Crítico (Alcance Acreditado)</span>
                                                    }
                                                </div>
                                                <span class="badge @GetEnrollmentBadgeClass(enrollment?.Status)">
                                                    @(enrollment?.Status.ToString() ?? "NOT_ENROLLED")
                                                </span>
                                            </div>
                                            <div class="d-flex justify-content-end gap-1 mt-2">
                                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="() => ManageEnrollment(prog, enrollment)">
                                                    Configurar
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-md-8">
                        <div class="card border-0 shadow-sm rounded-4 p-4">
                            <h5 class="fw-bold mb-3"><i class="bi bi-calendar-event text-primary me-2"></i>Calendario y Plazos de Envío</h5>
                            <div class="table-responsive">
                                <table class="table align-middle">
                                    <thead class="bg-light small fw-bold text-secondary">
                                        <tr>
                                            <th>Ronda</th>
                                            <th>Recepción Prevista</th>
                                            <th>Recepción Real</th>
                                            <th>Límite Envío</th>
                                            <th>Envío Real</th>
                                            <th>Estado</th>
                                            <th class="text-end">Acción</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        @if (rounds == null)
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center py-4">Cargando calendario...</td>
                                            </tr>
                                        }
                                        else if (!rounds.Any(r => r.Year == selectedYear))
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center py-4 text-muted">No hay rondas planificadas para el año @selectedYear.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var round in rounds.Where(r => r.Year == selectedYear).OrderBy(r => r.ExpectedReceiptDate))
                                            {
                                                var prog = programs?.FirstOrDefault(p => p.Id == round.ProgramId);
                                                <tr>
                                                    <td>
                                                        <div class="fw-bold text-dark">@round.ExternalCode</div>
                                                        <div class="text-muted small">@prog?.Name</div>
                                                    </td>
                                                    <td>@round.ExpectedReceiptDate?.ToString("dd/MM/yyyy")</td>
                                                    <td>@(round.RealReceiptDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                                    <td class="fw-semibold text-danger">@round.SubmissionDeadline?.ToString("dd/MM/yyyy")</td>
                                                    <td>@(round.RealSubmissionDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                                    <td>
                                                        <span class="badge rounded-pill @GetRoundBadgeClass(round.Status)">
                                                            @round.Status
                                                        </span>
                                                    </td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="() => ProcessRound(round)">
                                                            Gestionar
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (activeTab == "rounds")
            {
                <!-- ROUND PROCESSOR -->
                @if (selectedRound == null)
                {
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                            <div>
                                <h5 class="fw-bold mb-1 text-dark">
                                    <i class="bi bi-mailbox2 text-primary me-2"></i>Bandeja de Trabajo: Rondas del Año @selectedYear
                                </h5>
                                <p class="text-muted small mb-0">Haga clic en una ronda para gestionar sus plazos, registrar muestras (FCS) o cargar los informes de resultados del organizador.</p>
                            </div>
                            <div class="d-flex gap-2">
                                <select class="form-select form-select-premium py-1" style="width: auto;" @bind="selectedYear" @bind:after="LoadYearEnrollments">
                                    <option value="2026">2026</option>
                                    <option value="2025">2025</option>
                                </select>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="bg-light small fw-bold text-secondary">
                                    <tr>
                                        <th>Programa</th>
                                        <th>Ronda / Código</th>
                                        <th>Límite Envío</th>
                                        <th>Fecha Envío Real</th>
                                        <th>Resultado Global</th>
                                        <th>Estado</th>
                                        <th class="text-end">Acción</th>
                                    </tr>
                                </thead>
                                <tbody class="small">
                                    @if (rounds == null)
                                    {
                                        <tr>
                                            <td colspan="7" class="text-center py-4">Cargando rondas...</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        var activeYearRounds = rounds.Where(r => r.Year == selectedYear).OrderBy(r => r.Status == EQARoundStatus.CLOSED).ThenBy(r => r.SubmissionDeadline).ToList();
                                        if (!activeYearRounds.Any())
                                        {
                                            <tr>
                                                <td colspan="7" class="text-center py-4 text-muted">No hay rondas registradas para el año @selectedYear.</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var round in activeYearRounds)
                                            {
                                                var prog = programs?.FirstOrDefault(p => p.Id == round.ProgramId);
                                                var isOverdue = round.SubmissionDeadline < DateTime.UtcNow && round.Status != EQARoundStatus.CLOSED;
                                                <tr>
                                                    <td>
                                                        <div class="fw-bold text-dark">@prog?.Name</div>
                                                        <div class="text-muted small">@prog?.Provider</div>
                                                    </td>
                                                    <td>
                                                         <span class="fw-bold">@round.ExternalCode</span>
                                                         <span class="text-muted ms-1">(@round.RoundType)</span>
                                                         @if (!string.IsNullOrEmpty(round.ReportFileName))
                                                         {
                                                             <div class="mt-1">
                                                                 <a href="/api/eqa/files/report/@round.Id" target="_blank" class="text-decoration-none text-danger small fw-semibold">
                                                                     <i class="bi bi-file-earmark-pdf-fill me-1"></i>Informe
                                                                 </a>
                                                             </div>
                                                         }
                                                         @if (!string.IsNullOrEmpty(round.CertificateFileName))
                                                         {
                                                             <div class="mt-1">
                                                                 <a href="/api/eqa/files/certificate/@round.Id" target="_blank" class="text-decoration-none text-success small fw-semibold">
                                                                     <i class="bi bi-file-earmark-pdf-fill me-1"></i>Certificado
                                                                 </a>
                                                             </div>
                                                         }
                                                     </td>
                                                    <td>
                                                        <span class="@(isOverdue ? "text-danger fw-bold" : "text-dark")">
                                                            @round.SubmissionDeadline?.ToString("dd/MM/yyyy")
                                                            @if (isOverdue)
                                                            {
                                                                <span class="badge bg-danger ms-1">Vencido</span>
                                                            }
                                                        </span>
                                                    </td>
                                                    <td>@(round.RealSubmissionDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                                    <td>
                                                        @if (round.Status == EQARoundStatus.CLOSED || round.GlobalOutcome != EQAPerformance.PENDING_REVIEW)
                                                        {
                                                            <span class="badge @(round.GlobalOutcome == EQAPerformance.SATISFACTORY ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                                                @round.GlobalOutcome
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted italic">Pendiente evaluación</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge rounded-pill @GetRoundBadgeClass(round.Status)">
                                                            @round.Status
                                                        </span>
                                                    </td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="() => ProcessRound(round)">
                                                            <i class="bi bi-gear-fill me-1"></i>Gestionar
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    var prog = programs?.FirstOrDefault(p => p.Id == selectedRound.ProgramId);
                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
                            <div>
                                <span class="badge bg-secondary rounded-pill mb-2">@prog?.Name</span>
                                <h4 class="fw-bold text-dark mb-1">Ronda: @selectedRound.ExternalCode</h4>
                                <p class="text-muted small mb-0">Estado de la Ronda: <strong>@selectedRound.Status</strong> | Tipo: <strong>@selectedRound.RoundType</strong></p>
                            </div>
                            <div class="d-flex gap-2">
                                @if (canDelete)
                                {
                                    <button class="btn btn-outline-danger rounded-pill px-3" @onclick="DeleteActiveRound" title="Eliminar Ronda">
                                        <i class="bi bi-trash me-1"></i>Eliminar Ronda
                                    </button>
                                }
                                <button class="btn btn-outline-secondary rounded-pill px-3" @onclick="() => selectedRound = null">
                                    <i class="bi bi-arrow-left me-1"></i>Atrás
                                </button>
                                @if (canEdit)
                                {
                                    <button class="btn btn-success rounded-pill px-4" @onclick="SaveActiveRoundDetails">
                                        <i class="bi bi-save me-2"></i>Guardar Cambios
                                    </button>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(roundErrorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>@roundErrorMessage
                                <button type="button" class="btn-close" @onclick="() => roundErrorMessage = null" aria-label="Close"></button>
                            </div>
                        }

                        <div class="row g-4">
                            <!-- Left: Schedule & Files -->
                            <div class="col-md-6">
                                <h5 class="fw-bold mb-3"><i class="bi bi-clock-history text-primary me-2"></i>Hitos y Fechas</h5>
                                <div class="row g-3 mb-4">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold text-secondary">Fecha Recepción Real</label>
                                        <input type="date" class="form-control form-control-premium" @bind="selectedRound.RealReceiptDate" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold text-secondary">Fecha Límite de Envío</label>
                                        <input type="date" class="form-control form-control-premium" @bind="selectedRound.SubmissionDeadline" disabled />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold text-secondary">Fecha Envío Real</label>
                                        <input type="date" class="form-control form-control-premium" @bind="selectedRound.RealSubmissionDate" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold text-secondary">Estado Ronda</label>
                                        <select class="form-select form-select-premium" @bind="selectedRound.Status">
                                            @foreach (var val in Enum.GetValues<EQARoundStatus>())
                                            {
                                                <option value="@val">@val</option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <!-- PDF report results upload -->
                                <h5 class="fw-bold mb-3"><i class="bi bi-file-earmark-pdf-fill text-danger me-2"></i>Informe y Certificado EQA</h5>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold text-secondary">PDF Informe Recibido</label>
                                        <InputFile class="form-control" OnChange="UploadReportFile" />
                                        @if (!string.IsNullOrEmpty(selectedRound.ReportFileName))
                                        {
                                            <div class="small text-success mt-1">
                                                <i class="bi bi-check-circle me-1"></i>
                                                <a href="/api/eqa/files/report/@selectedRound.Id" target="_blank" class="text-decoration-none text-success fw-semibold">
                                                    <i class="bi bi-download ms-1 me-1"></i>@selectedRound.ReportFileName
                                                </a>
                                            </div>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-semibold text-secondary">PDF Certificado</label>
                                        <InputFile class="form-control" OnChange="UploadCertificateFile" />
                                        @if (!string.IsNullOrEmpty(selectedRound.CertificateFileName))
                                        {
                                            <div class="small text-success mt-1">
                                                <i class="bi bi-check-circle me-1"></i>
                                                <a href="/api/eqa/files/certificate/@selectedRound.Id" target="_blank" class="text-decoration-none text-success fw-semibold">
                                                    <i class="bi bi-download ms-1 me-1"></i>@selectedRound.CertificateFileName
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Muestras -->
                            <div class="col-md-6 border-start ps-4">
                                @{
                                    var expectedSamplesCount = prog?.ExpectedSamplesPerRound ?? 2;
                                    var actualSamplesCount = selectedRound.Samples.Count;
                                }
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 class="fw-bold mb-0"><i class="bi bi-bezier2 text-primary me-2"></i>Procesamiento de Muestras / FCS</h5>
                                    <span class="badge @(actualSamplesCount == expectedSamplesCount ? "bg-success" : "bg-warning text-dark") fs-7 rounded-pill">
                                        @actualSamplesCount / @expectedSamplesCount Muestras
                                    </span>
                                </div>

                                @if (actualSamplesCount != expectedSamplesCount)
                                {
                                    <div class="alert alert-warning rounded-3 p-3 mb-3 d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center me-2">
                                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                                            <span class="small">El número de muestras registradas (@actualSamplesCount) difiere del configurado en el programa (@expectedSamplesCount).</span>
                                        </div>
                                        <button class="btn btn-sm btn-primary rounded-pill text-nowrap px-3" @onclick="SyncRoundSamplesToExpected">
                                            Ajustar Ronda
                                        </button>
                                    </div>
                                }

                                <div class="list-group">
                                    @foreach (var sample in selectedRound.Samples)
                                    {
                                        <div class="list-group-item p-3 mb-3 border rounded-3 bg-light-subtle">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <h6 class="fw-bold mb-0 text-dark">@sample.InternalCode</h6>
                                                <span class="badge bg-secondary">@sample.SampleType</span>
                                            </div>
                                            
                                            <div class="row g-2 mb-3">
                                                <div class="col-md-6">
                                                    <label class="form-label small text-secondary mb-0.5">Integridad Muestra</label>
                                                    <select class="form-select form-select-sm" @bind="sample.Integrity">
                                                        @foreach (var val in Enum.GetValues<EQAIntegrity>())
                                                        {
                                                            <option value="@val">@val</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small text-secondary mb-0.5">Fecha Análisis</label>
                                                    <input type="date" class="form-control form-control-sm" @bind="sample.ProcessingEnd" />
                                                </div>
                                                <div class="col-md-12">
                                                    <label class="form-label small text-secondary mb-0.5">Equipo de Adquisición</label>
                                                    <select class="form-select form-select-sm" @bind="sample.EquipmentId">
                                                        <option value="">Seleccione equipo...</option>
                                                        @if (equipments != null)
                                                        {
                                                            @foreach (var eq in equipments)
                                                            {
                                                                <option value="@eq.Id">@eq.Name (@eq.InternalId)</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="mb-2">
                                                <label class="form-label small text-secondary mb-0.5">Valores de Resultados Enviados (Parámetros)</label>
                                                <textarea class="form-control form-control-sm" rows="3" placeholder="CD3+ % = 74.2&#10;CD34+ abs/uL = 42.1&#10;Resultado = Positivo" @bind="sample.SubmittedResultsJson"></textarea>
                                            </div>

                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" @bind="sample.FollowedRoutineProcedure" id="@($"chk-{sample.Id}")" />
                                                <label class="form-check-label small" for="@($"chk-{sample.Id}")">
                                                    ¿Tratada como muestra de paciente rutinaria? (ISO 15189)
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Provider report analysis & Internal evaluation -->
                        <div class="border-top mt-4 pt-4">
                            <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-clipboard-data text-primary me-2"></i>Recepción de Informe y Evaluación de Desempeño</h5>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label small fw-semibold text-secondary">Resultado Global Proveedor</label>
                                    <select class="form-select form-select-premium" @bind="selectedRound.GlobalOutcome">
                                        @foreach (var val in Enum.GetValues<EQAPerformance>())
                                        {
                                            <option value="@val">@val</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-semibold text-secondary">Puntuación Global (Score)</label>
                                    <input type="number" step="0.01" class="form-control form-control-premium" @bind="selectedRound.GlobalScore" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-semibold text-secondary">Fecha Evaluación Interna</label>
                                    <input type="date" class="form-control form-control-premium" @bind="selectedRound.InternalEvaluationDate" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small fw-semibold text-secondary">¿Requiere Acción Correctiva?</label>
                                    <select class="form-select form-select-premium" @bind="selectedRound.RequiresAction">
                                        <option value="false">No</option>
                                        <option value="true">Sí (Abrir Desviación)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-secondary">Comentarios del Evaluador Externo</label>
                                    <textarea class="form-control form-control-premium" rows="2" @bind="selectedRound.AssessorComments"></textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-semibold text-secondary">Justificación / Observaciones Internas</label>
                                    <textarea class="form-control form-control-premium" rows="2" @bind="selectedRound.InternalNotes"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (activeTab == "deviations")
            {
                <!-- DEVIATIONS & CAPA -->
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-slash-fill text-danger me-2"></i>Desviaciones y Acciones Correctivas (CAPA)</h5>
                        @if (canCreate)
                        {
                            <button class="btn btn-danger btn-sm rounded-pill px-3" @onclick="OpenCreateDeviationModal">
                                <i class="bi bi-plus-circle me-1"></i>Registrar Desviación
                            </button>
                        }
                    </div>

                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="bg-light small fw-bold text-secondary">
                                <tr>
                                    <th>Ronda / Programa</th>
                                    <th>Tipo Desviación</th>
                                    <th>Causa Probable</th>
                                    <th>Gravedad</th>
                                    <th>Estado</th>
                                    <th>Eficacia</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @if (deviations == null || !deviations.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">No hay desviaciones registradas.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var dev in deviations)
                                    {
                                        var r = rounds?.FirstOrDefault(x => x.Id == dev.RoundId);
                                        var p = programs?.FirstOrDefault(x => x.Id == r?.ProgramId);
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-dark">@(r?.ExternalCode ?? "N/A")</div>
                                                <div class="text-muted small">@(p?.Name ?? "N/A")</div>
                                            </td>
                                            <td>@dev.DeviationType</td>
                                            <td>@dev.ProbableCause</td>
                                            <td>
                                                <span class="badge @(dev.Severity == EQADeviationSeverity.CRITICAL ? "bg-danger" : "bg-warning")">
                                                    @dev.Severity
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @(dev.Status == "Cerrada" ? "bg-success" : "bg-primary")">
                                                    @dev.Status
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge @(dev.EffectivenessOutcome == "Eficaz" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                                    @(dev.EffectivenessOutcome ?? "Pendiente")
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary rounded-pill" @onclick="() => EditDeviation(dev)">
                                                    Gestionar CAPA / Eficacia
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- MODALS -->

<!-- Program Modal -->
@if (showProgramModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-award-fill me-2"></i>Ficha del Programa EQA</h5>
                    <button type="button" class="btn-close" @onclick="() => showProgramModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small text-secondary">Código Interno</label>
                            <input type="text" class="form-control" @bind="editingProgram.InternalCode" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small text-secondary">Nombre Programa</label>
                            <input type="text" class="form-control" @bind="editingProgram.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Proveedor / Organizador</label>
                            <input type="text" class="form-control" @bind="editingProgram.Provider" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Coordinador</label>
                            <input type="text" class="form-control" @bind="editingProgram.CoordinatorEntity" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-secondary">Subárea</label>
                            <select class="form-select" @bind="editingProgram.SubArea">
                                @foreach (var val in Enum.GetValues<EQASubArea>())
                                {
                                    <option value="@val">@GetSubAreaName(val)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-secondary">Tipo Muestra</label>
                            <select class="form-select" @bind="editingProgram.SampleType">
                                @foreach (var val in Enum.GetValues<EQASampleType>())
                                {
                                    <option value="@val">@val</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-secondary">Periodicidad</label>
                            <input type="text" class="form-control" @bind="editingProgram.Periodicity" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-secondary">Rondas al Año</label>
                            <input type="number" class="form-control" @bind="editingProgram.ExpectedRoundsPerYear" min="1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-secondary">Muestras por Ronda</label>
                            <input type="number" class="form-control" @bind="editingProgram.ExpectedSamplesPerRound" min="1" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => showProgramModal = false">Cancelar</button>
                    <button class="btn btn-primary rounded-pill px-4" @onclick="SaveProgram">Guardar Programa</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Enrollment Modal -->
@if (showEnrollmentModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-bookmark-fill me-2"></i>Inscripción Anual EQA</h5>
                    <button type="button" class="btn-close" @onclick="() => showEnrollmentModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <h6 class="fw-bold mb-1">@selectedProgramForEnrollment?.Name</h6>
                            <p class="small text-muted">Año: @selectedYear</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Código Participante</label>
                            <input type="text" class="form-control" @bind="editingEnrollment.ParticipantCode" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Estado Inscripción</label>
                            <select class="form-select" @bind="editingEnrollment.Status">
                                @foreach (var val in Enum.GetValues<EQAEnrollmentStatus>())
                                {
                                    <option value="@val">@val</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-secondary">Cargar Justificante Inscripción (PDF)</label>
                            <InputFile class="form-control" OnChange="UploadInscriptionFile" />
                            @if (!string.IsNullOrEmpty(editingEnrollment.EvidenceFileName))
                            {
                                <div class="small text-success mt-1">
                                    <i class="bi bi-check-circle me-1"></i>
                                    <a href="/api/eqa/files/evidence/@editingEnrollment.Id" target="_blank" class="text-decoration-none text-success fw-semibold">
                                        <i class="bi bi-download ms-1 me-1"></i>@editingEnrollment.EvidenceFileName
                                    </a>
                                </div>
                            }
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="editingEnrollment.IsCritical" id="chkCritical" />
                                <label class="form-check-label small" for="chkCritical">
                                    Prueba crítica (Alcance Acreditado) - Genera alerta si falta inscripción
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    @if (editingEnrollment.Id != Guid.Empty && canDelete)
                    {
                        <button class="btn btn-outline-danger rounded-pill px-4 me-auto" @onclick="DeleteEnrollment">Eliminar Inscripción</button>
                    }
                    <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => showEnrollmentModal = false">Cancelar</button>
                    @if ((editingEnrollment.Id == Guid.Empty && canCreate) || (editingEnrollment.Id != Guid.Empty && canEdit))
                    {
                        <button class="btn btn-primary rounded-pill px-4" @onclick="SaveEnrollment">Confirmar Inscripción</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Deviation / CAPA Modal -->
@if (showDeviationModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-shield-slash-fill me-2"></i>Desviación y CAPA</h5>
                    <button type="button" class="btn-close" @onclick="() => showDeviationModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(deviationErrorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@deviationErrorMessage
                            <button type="button" class="btn-close" @onclick="() => deviationErrorMessage = null" aria-label="Close"></button>
                        </div>
                    }
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Asociar a Ronda</label>
                            <select class="form-select" @bind="editingDeviation.RoundId">
                                <option value="">Seleccione ronda...</option>
                                @if (rounds != null)
                                {
                                    @foreach (var r in rounds)
                                    {
                                        <option value="@r.Id">@r.ExternalCode</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">No Conformidad Vinculada (NC/CAPA)</label>
                            <select class="form-select" @bind="editingDeviation.LinkedCapaId">
                                <option value="">-- Sin Vincular / Nueva NC --</option>
                                @if (activeNonconformities != null)
                                {
                                    @foreach (var nc in activeNonconformities)
                                    {
                                        <option value="@nc.Id">NC: @nc.Title (@nc.DetectedAt.ToString("dd/MM/yyyy"))</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Tipo de Desviación</label>
                            <input type="text" class="form-control" placeholder="Ej: Error cuantitativo CD4" @bind="editingDeviation.DeviationType" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Causa Probable (Análisis)</label>
                            <textarea class="form-control" rows="2" @bind="editingDeviation.ProbableCause"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Impacto Clínico y en Pacientes</label>
                            <textarea class="form-control" rows="2" @bind="editingDeviation.ClinicalImpact"></textarea>
                        </div>
                        <div class="col-md-12 border-top pt-3">
                            <h6 class="fw-bold mb-2">Acciones y Verificación de Eficacia (ISO 15189 §8.7.2)</h6>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Acción Correctiva (CAPA)</label>
                            <textarea class="form-control" rows="2" @bind="editingDeviation.ActionTaken"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Método de Evaluación de Eficacia</label>
                            <input type="text" class="form-control" placeholder="Ej: Siguiente ronda interlaboratorios" @bind="editingDeviation.EffectivenessMethod" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-secondary">Resultado de Eficacia</label>
                            <select class="form-select" @bind="editingDeviation.EffectivenessOutcome">
                                <option value="">Pendiente</option>
                                <option value="Eficaz">Eficaz</option>
                                <option value="Parcialmente Eficaz">Parcialmente Eficaz</option>
                                <option value="No Eficaz">No Eficaz</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-secondary">Fecha Evaluación</label>
                            <input type="date" class="form-control" @bind="editingDeviation.EffectivenessEvaluationDate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-secondary">Estado Desviación</label>
                            <select class="form-select" @bind="editingDeviation.Status">
                                <option value="Abierta">Abierta</option>
                                <option value="En curso">En curso</option>
                                <option value="Cerrada">Cerrada</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="() => showDeviationModal = false">Cancelar</button>
                    @if ((editingDeviation.Id == Guid.Empty && canCreate) || (editingDeviation.Id != Guid.Empty && canEdit))
                    {
                        <button class="btn btn-primary rounded-pill px-4" @onclick="SaveDeviation">Guardar Desviación</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Program Technical Tests (Mappings) Modal -->
@if (showMappingModal && selectedProgramForMapping != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1050;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title fw-bold text-dark">
                        <i class="bi bi-link-45deg me-2 text-primary"></i>Configuración de Pruebas: @selectedProgramForMapping.Name
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showMappingModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Current Mappings list -->
                    <h6 class="fw-bold mb-3">Pruebas / Métodos Asignados</h6>
                    <div class="table-responsive mb-4 border rounded-3 bg-white" style="max-height: 200px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="bg-light small fw-bold text-secondary">
                                <tr>
                                    <th>Prueba Interna</th>
                                    <th>Panel</th>
                                    <th>Método Relacionado</th>
                                    <th>Tipo de Resultado</th>
                                    <th>Acreditado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody class="small">
                                @if (activeMappings == null || !activeMappings.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-3 text-muted">No hay pruebas configuradas para este programa.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var m in activeMappings)
                                    {
                                        var methodName = availableMethods?.FirstOrDefault(x => x.Id == m.MethodId)?.Name ?? "Sin vincular";
                                        <tr>
                                            <td class="fw-bold">@m.InternalTestName</td>
                                            <td>@m.Panel</td>
                                            <td>@methodName</td>
                                            <td>@m.ResultType</td>
                                            <td>
                                                <span class="badge @(m.AlcanceAcreditado ? "bg-success" : "bg-secondary")">
                                                    @(m.AlcanceAcreditado ? "Sí" : "No")
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                @if (canEdit)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary py-0 px-2 me-1" @onclick="() => EditMapping(m)">
                                                        Editar
                                                    </button>
                                                }
                                                @if (canDelete)
                                                {
                                                    <button class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => DeleteMapping(m)">
                                                        Eliminar
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Add / Edit Form -->
                    <hr />
                    <h6 class="fw-bold mb-3">@(editingMapping.Id == Guid.Empty ? "Agregar Nueva Prueba" : "Editar Prueba")</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Nombre de la Prueba Interna</label>
                            <input type="text" class="form-control" @bind="editingMapping.InternalTestName" placeholder="Ej: Recuento CD34+" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Panel</label>
                            <input type="text" class="form-control" @bind="editingMapping.Panel" placeholder="Ej: Células Madre" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Método de Ensayo (Laboratorio)</label>
                            <select class="form-select" @bind="editingMapping.MethodId">
                                <option value="">-- No vincular a un método específico --</option>
                                @if (availableMethods != null)
                                {
                                    @foreach (var met in availableMethods)
                                    {
                                        <option value="@met.Id">@met.Code - @met.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-secondary">Tipo de Resultado</label>
                            <select class="form-select" @bind="editingMapping.ResultType">
                                @foreach (var val in Enum.GetValues<EQAResultType>())
                                {
                                    <option value="@val">@val</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-secondary">Criticidad</label>
                            <select class="form-select" @bind="editingMapping.Criticidad">
                                <option value="Baja">Baja</option>
                                <option value="Media">Media</option>
                                <option value="Alta">Alta</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small text-secondary">Nivel de Cobertura</label>
                            <input type="text" class="form-control" @bind="editingMapping.CoverageLevel" placeholder="Ej: Completa" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end pb-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" @bind="editingMapping.AlcanceAcreditado" id="chkAcred" />
                                <label class="form-check-label small fw-bold" for="chkAcred">
                                    Alcance Acreditado
                                </label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small text-secondary">Notas / Observaciones</label>
                            <textarea class="form-control" rows="2" @bind="editingMapping.Notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    @if (editingMapping.Id != Guid.Empty)
                    {
                        <button class="btn btn-outline-secondary rounded-pill px-3" @onclick="CancelMappingEdit">Cancelar Edición</button>
                    }
                    <button class="btn btn-outline-secondary rounded-pill px-3" @onclick="() => showMappingModal = false">Cerrar</button>
                    @if ((editingMapping.Id == Guid.Empty && canCreate) || (editingMapping.Id != Guid.Empty && canEdit))
                    {
                        <button class="btn btn-primary rounded-pill px-4" @onclick="SaveMapping">Guardar Prueba</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

