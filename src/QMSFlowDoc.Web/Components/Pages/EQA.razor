@code {
    private bool isAuthorized = false;
    private string activeTab = "dashboard";
    private int selectedYear = 2026;

    // Data lists
    private List<EQAProgram>? programs;
    private List<EQAEnrollment>? enrollments;
    private List<EQARound>? rounds;
    private List<EQADeviation>? deviations;
    private List<QMSFlowDoc.Shared.DTOs.EquipmentListDto>? equipments;
    private List<AlertItem> alerts = new();

    // Active Selection
    private EQARound? selectedRound;
    private string? roundErrorMessage;
    private string? deviationErrorMessage;
    private List<QMSFlowDoc.Shared.DTOs.NCListDto>? activeNonconformities;

    // Modal forms
    private bool showProgramModal = false;
    private EQAProgram editingProgram = new();

    private bool showEnrollmentModal = false;
    private EQAProgram? selectedProgramForEnrollment;
    private EQAEnrollment editingEnrollment = new();

    private bool showDeviationModal = false;
    private EQADeviation editingDeviation = new();

    // Mappings Modal State
    private bool showMappingModal = false;
    private List<EQAMapping>? activeMappings;
    private EQAProgram? selectedProgramForMapping;
    private EQAMapping editingMapping = new();
    private List<Method>? availableMethods;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }
    private Guid? currentUserId;
    private string? currentUserName;

    private bool canRead = false;
    private bool canCreate = false;
    private bool canEdit = false;
    private bool canDelete = false;
    private bool canPrint = false;

    private ChecklistMetric CriticalProgramsMetric
    {
        get
        {
            var criticalEnrollments = enrollments?.Where(e => e.IsCritical).ToList() ?? new();
            return CreateMetric(
                criticalEnrollments.Count,
                criticalEnrollments.Count(e => e.Status == EQAEnrollmentStatus.CONFIRMED));
        }
    }

    private ChecklistMetric RoundsOnTimeMetric
    {
        get
        {
            var assessableRounds = rounds?
                .Where(r => r.SubmissionDeadline.HasValue &&
                    (r.RealSubmissionDate.HasValue || r.SubmissionDeadline.Value < DateTime.UtcNow))
                .ToList() ?? new();

            return CreateMetric(
                assessableRounds.Count,
                assessableRounds.Count(r =>
                    r.RealSubmissionDate.HasValue &&
                    r.RealSubmissionDate.Value <= r.SubmissionDeadline!.Value));
        }
    }

    private ChecklistMetric CapaEffectivenessMetric
    {
        get
        {
            var assessedDeviations = deviations?
                .Where(d => !string.IsNullOrWhiteSpace(d.EffectivenessOutcome))
                .ToList() ?? new();

            return CreateMetric(
                assessedDeviations.Count,
                assessedDeviations.Count(d => string.Equals(
                    d.EffectivenessOutcome,
                    "Eficaz",
                    StringComparison.OrdinalIgnoreCase)));
        }
    }

    private static ChecklistMetric CreateMetric(int total, int compliant) =>
        total == 0
            ? new ChecklistMetric(false, 0, "Sin datos")
            : new ChecklistMetric(true, (int)Math.Round((double)compliant / total * 100), $"{(int)Math.Round((double)compliant / total * 100)}%");

    private static string GetMetricBadgeClass(ChecklistMetric metric, string color) =>
        metric.HasData ? $"bg-{color}" : "bg-secondary";

    private static string GetMetricBarClass(ChecklistMetric metric, string color) =>
        metric.HasData ? $"bg-{color}" : "bg-secondary";

    private readonly record struct ChecklistMetric(bool HasData, int Percentage, string Label);

    protected override async Task OnInitializedAsync()
    {
        isAuthorized = false;

        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;
            currentUserName = user.Identity?.Name;
            var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && Guid.TryParse(userIdClaim.Value, out var uId))
                currentUserId = uId;

            var perms = await PermissionService.GetPermissionsForUserAsync(user, "EQA");
            canRead = perms.CanRead;
            canCreate = perms.CanCreate;
            canEdit = perms.CanEdit;
            canDelete = perms.CanDelete;
            canPrint = perms.CanPrint;

            isAuthorized = canRead;
        }

        if (isAuthorized)
        {
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        programs = await EQAService.GetProgramsAsync();
        rounds = await EQAService.GetRoundsAsync();
        deviations = await EQAService.GetDeviationsAsync();
        
        // Fetch equipments for select lists
        equipments = await EquipmentService.GetEquipmentsAsync();

        // Fetch methods for mappings selection list
        availableMethods = await DbContext.Methods.Where(m => m.Status == MethodStatus.ACTIVE).OrderBy(m => m.Name).ToListAsync();

        try
        {
            activeNonconformities = (await QualityService.GetNonconformitiesAsync())?
                .Where(nc => nc.Status != QMSFlowDoc.Shared.Models.NCStatus.CLOSED)
                .ToList();
        }
        catch (Exception)
        {
            activeNonconformities = new();
        }

        await LoadYearEnrollments();
        GenerateAlerts();
    }

    private async Task LoadYearEnrollments()
    {
        enrollments = await EQAService.GetEnrollmentsAsync(selectedYear);
    }

    private void GenerateAlerts()
    {
        alerts.Clear();
        
        // Rule: Program Critical without enrollment
        if (programs != null)
        {
            foreach (var p in programs)
            {
                var enrollment = enrollments?.FirstOrDefault(e => e.ProgramId == p.Id && e.Year == selectedYear);
                if (enrollment == null || enrollment.Status == EQAEnrollmentStatus.NOT_ENROLLED || enrollment.Status == EQAEnrollmentStatus.PENDING)
                {
                    alerts.Add(new AlertItem
                    {
                        Title = $"Inscripción Pendiente: {p.Name}",
                        Description = $"Falta confirmar inscripción para el año {selectedYear}. Programa crítico (ISO 15189).",
                        Icon = "bi-exclamation-octagon-fill",
                        ColorClass = "text-danger",
                        BadgeClass = "bg-danger-subtle text-danger",
                        Type = "Inscripción",
                    });
                }
            }
        }

        // Rule: Rounds upcoming / close submission
        if (rounds != null)
        {
            foreach (var r in rounds.Where(x => x.Year == selectedYear))
            {
                var prog = programs?.FirstOrDefault(p => p.Id == r.ProgramId);
                if (!r.SubmissionDeadline.HasValue)
                {
                    continue;
                }

                var daysToDeadline = (r.SubmissionDeadline.Value - DateTime.UtcNow).Days;
                
                if (r.Status == EQARoundStatus.PLANNED || r.Status == EQARoundStatus.PENDING_RECEIPT)
                {
                    if (daysToDeadline > 0 && daysToDeadline <= 30)
                    {
                        alerts.Add(new AlertItem
                        {
                            Title = $"Plazo de Envío Próximo: {r.ExternalCode}",
                            Description = $"Faltan {daysToDeadline} días para enviar los resultados a {prog?.Provider}.",
                            Icon = "bi-clock-fill",
                            ColorClass = "text-warning",
                            BadgeClass = "bg-warning-subtle text-warning",
                            Type = "Envío",
                        });
                    }
                    else if (daysToDeadline <= 0)
                    {
                        alerts.Add(new AlertItem
                        {
                            Title = $"Plazo de Envío Vencido: {r.ExternalCode}",
                            Description = $"Venció el plazo límite de envío ({r.SubmissionDeadline?.ToString("dd/MM/yyyy")}).",
                            Icon = "bi-x-octagon-fill",
                            ColorClass = "text-danger",
                            BadgeClass = "bg-danger-subtle text-danger",
                            Type = "Vencido",
                        });
                    }
                }
            }
        }

        // Rule: Unsatisfactory performance
        if (rounds != null)
        {
            foreach (var r in rounds.Where(x => x.GlobalOutcome == EQAPerformance.UNSATISFACTORY))
            {
                var prog = programs?.FirstOrDefault(p => p.Id == r.ProgramId);
                var hasDeviation = deviations?.Any(d => d.RoundId == r.Id) ?? false;
                if (!hasDeviation)
                {
                    alerts.Add(new AlertItem
                    {
                        Title = $"Resultado No Satisfactorio sin CAPA: {r.ExternalCode}",
                        Description = $"Desempeño fuera de criterio en {prog?.Name}. Obligatorio documentar desviación (ISO 15189 §8.7.2).",
                        Icon = "bi-shield-exclamation",
                        ColorClass = "text-danger",
                        BadgeClass = "bg-danger-subtle text-danger",
                        Type = "Falta CAPA",
                    });
                }
            }
        }
    }

    private void ChangeTab(string tabName)
    {
        activeTab = tabName;
    }

    private void OpenCreateProgramModal()
    {
        editingProgram = new EQAProgram();
        showProgramModal = true;
    }

    private void EditProgram(EQAProgram prog)
    {
        editingProgram = prog;
        showProgramModal = true;
    }

    private async Task SaveProgram()
    {
        if (editingProgram.Id == Guid.Empty)
        {
            if (!canCreate)
            {
                await JS.InvokeVoidAsync("alert", "No tiene permisos para registrar nuevos programas.");
                return;
            }
            await EQAService.CreateProgramAsync(editingProgram, currentUserId, currentUserName);
        }
        else
        {
            if (!canEdit)
            {
                await JS.InvokeVoidAsync("alert", "No tiene permisos para modificar programas.");
                return;
            }
            await EQAService.UpdateProgramAsync(editingProgram, currentUserId, currentUserName);
        }
        showProgramModal = false;
        await LoadData();
    }

    private async Task ManageMappings(EQAProgram prog)
    {
        selectedProgramForMapping = prog;
        activeMappings = await EQAService.GetMappingsAsync(prog.Id);
        editingMapping = new EQAMapping { ProgramId = prog.Id, ResultType = EQAResultType.MIXED };
        showMappingModal = true;
    }

    private void EditMapping(EQAMapping mapping)
    {
        editingMapping = new EQAMapping
        {
            Id = mapping.Id,
            ProgramId = mapping.ProgramId,
            MethodId = mapping.MethodId,
            InternalTestName = mapping.InternalTestName,
            Panel = mapping.Panel,
            ResultType = mapping.ResultType,
            CoverageLevel = mapping.CoverageLevel,
            Criticidad = mapping.Criticidad,
            AlcanceAcreditado = mapping.AlcanceAcreditado,
            Notes = mapping.Notes
        };
    }

    private void CancelMappingEdit()
    {
        if (selectedProgramForMapping != null)
        {
            editingMapping = new EQAMapping { ProgramId = selectedProgramForMapping.Id, ResultType = EQAResultType.MIXED };
        }
    }

    private async Task SaveMapping()
    {
        if (string.IsNullOrWhiteSpace(editingMapping.InternalTestName))
        {
            await JS.InvokeVoidAsync("alert", "Error: El nombre de la prueba interna es obligatorio.");
            return;
        }

        if (!canEdit)
        {
            await JS.InvokeVoidAsync("alert", "No tiene permisos para modificar la configuración de pruebas.");
            return;
        }

        try
        {
            await EQAService.SaveMappingAsync(editingMapping, currentUserId, currentUserName);
            if (selectedProgramForMapping != null)
            {
                activeMappings = await EQAService.GetMappingsAsync(selectedProgramForMapping.Id);
                editingMapping = new EQAMapping { ProgramId = selectedProgramForMapping.Id, ResultType = EQAResultType.MIXED };
            }
            await LoadData();
            await JS.InvokeVoidAsync("alert", "Prueba guardada correctamente.");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al guardar la prueba: {ex.Message}");
        }
    }

    private async Task DeleteMapping(EQAMapping mapping)
    {
        if (!canDelete)
        {
            await JS.InvokeVoidAsync("alert", "No tiene permisos para eliminar pruebas del programa.");
            return;
        }

        bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Está seguro de que desea eliminar la prueba '{mapping.InternalTestName}'?");
        if (confirm)
        {
            try
            {
                await EQAService.DeleteMappingAsync(mapping.Id, currentUserId, currentUserName);
                if (selectedProgramForMapping != null)
                {
                    activeMappings = await EQAService.GetMappingsAsync(selectedProgramForMapping.Id);
                }
                await LoadData();
                await JS.InvokeVoidAsync("alert", "Prueba eliminada.");
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Error al eliminar la prueba: {ex.Message}");
            }
        }
    }

    private async Task DeleteProgram(EQAProgram prog)
    {
        if (!canDelete)
        {
            await JS.InvokeVoidAsync("alert", "No tiene permisos para eliminar programas.");
            return;
        }

        bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Está seguro de que desea eliminar el programa '{prog.Name}'? Esto también ocultará sus rondas, mapeos, inscripciones y desviaciones asociadas.");
        if (confirm)
        {
            try
            {
                await EQAService.DeleteProgramAsync(prog.Id, currentUserId, currentUserName);
                await LoadData();
                await JS.InvokeVoidAsync("alert", "Programa eliminado correctamente.");
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Error al eliminar el programa: {ex.Message}");
            }
        }
    }

    private async Task DeleteEnrollment()
    {
        if (editingEnrollment.Id == Guid.Empty) return;

        if (!canDelete)
        {
            await JS.InvokeVoidAsync("alert", "No tiene permisos para eliminar inscripciones.");
            return;
        }

        bool confirm = await JS.InvokeAsync<bool>("confirm", "¿Está seguro de que desea eliminar esta inscripción?");
        if (confirm)
        {
            try
            {
                await EQAService.DeleteEnrollmentAsync(editingEnrollment.Id, currentUserId, currentUserName);
                showEnrollmentModal = false;
                await LoadData();
                await JS.InvokeVoidAsync("alert", "Inscripción eliminada correctamente.");
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Error al eliminar la inscripción: {ex.Message}");
            }
        }
    }

    private async Task DeleteActiveRound()
    {
        if (selectedRound == null) return;

        if (!canDelete)
        {
            await JS.InvokeVoidAsync("alert", "No tiene permisos para eliminar rondas.");
            return;
        }

        bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Está seguro de que desea eliminar la ronda '{selectedRound.ExternalCode}'? Esto también eliminará las desviaciones asociadas.");
        if (confirm)
        {
            try
            {
                await EQAService.DeleteRoundAsync(selectedRound.Id, currentUserId, currentUserName);
                selectedRound = null;
                await LoadData();
                await JS.InvokeVoidAsync("alert", "Ronda eliminada correctamente.");
            }
            catch (Exception ex)
            {
                await JS.InvokeVoidAsync("alert", $"Error al eliminar la ronda: {ex.Message}");
            }
        }
    }

    private void ManageEnrollment(EQAProgram prog, EQAEnrollment? enrollment)
    {
        selectedProgramForEnrollment = prog;
        if (enrollment == null)
        {
            editingEnrollment = new EQAEnrollment
            {
                ProgramId = prog.Id,
                Year = selectedYear,
                Status = EQAEnrollmentStatus.PENDING
            };
        }
        else
        {
            editingEnrollment = enrollment;
        }
        showEnrollmentModal = true;
    }

    private async Task SaveEnrollment()
    {
        if (editingEnrollment.Id == Guid.Empty)
        {
            if (!canCreate)
            {
                await JS.InvokeVoidAsync("alert", "No tiene permisos para registrar inscripciones.");
                return;
            }
            await EQAService.CreateEnrollmentAsync(editingEnrollment, currentUserId, currentUserName);
        }
        else
        {
            if (!canEdit)
            {
                await JS.InvokeVoidAsync("alert", "No tiene permisos para modificar inscripciones.");
                return;
            }
            await EQAService.UpdateEnrollmentAsync(editingEnrollment, currentUserId, currentUserName);
        }
        showEnrollmentModal = false;
        await LoadData();
    }

    private void ProcessRound(EQARound round)
    {
        selectedRound = round;
        ChangeTab("rounds");
    }

    private async Task SaveActiveRoundDetails()
    {
        if (!canEdit)
        {
            await JS.InvokeVoidAsync("alert", "No tiene permisos para modificar detalles de la ronda.");
            return;
        }

        if (selectedRound != null)
        {
            try
            {
                roundErrorMessage = null;
                await EQAService.UpdateRoundAsync(selectedRound, currentUserId, currentUserName);
                await LoadData();
                // Refresh selectedRound reference from the newly loaded list to ensure database tracking is correct
                selectedRound = rounds?.FirstOrDefault(r => r.Id == selectedRound.Id);
                await JS.InvokeVoidAsync("alert", "Cambios de la ronda guardados correctamente.");
            }
            catch (InvalidOperationException ex)
            {
                roundErrorMessage = ex.Message;
            }
            catch (Exception ex)
            {
                roundErrorMessage = $"Error al guardar cambios de la ronda: {ex.Message}";
            }
        }
    }

    private async Task SyncRoundSamplesToExpected()
    {
        if (selectedRound == null) return;
        var prog = programs?.FirstOrDefault(p => p.Id == selectedRound.ProgramId);
        if (prog == null) return;

        var expectedCount = prog.ExpectedSamplesPerRound;
        var currentCount = selectedRound.Samples.Count;

        if (currentCount < expectedCount)
        {
            // Add missing samples
            for (int s = currentCount + 1; s <= expectedCount; s++)
            {
                selectedRound.Samples.Add(new EQASample
                {
                    Id = Guid.NewGuid(),
                    RoundId = selectedRound.Id,
                    InternalCode = $"{selectedRound.ExternalCode}-M{s}",
                    ExternalCode = $"{selectedRound.ExternalCode}-M{s}",
                    SampleType = selectedRound.RoundType.ToString(),
                    Integrity = EQAIntegrity.CORRECT,
                    FollowedRoutineProcedure = true
                });
            }
            await JS.InvokeVoidAsync("alert", $"Se han añadido {expectedCount - currentCount} plantilla(s) de muestra(s) para coincidir con el programa.");
        }
        else if (currentCount > expectedCount)
        {
            bool confirm = await JS.InvokeAsync<bool>("confirm", $"¿Está seguro de que desea reducir el número de muestras de {currentCount} a {expectedCount}? Se eliminarán las últimas muestras excedentes de la vista (debe hacer clic en Guardar Cambios para persistirlo).");
            if (confirm)
            {
                while (selectedRound.Samples.Count > expectedCount)
                {
                    selectedRound.Samples.RemoveAt(selectedRound.Samples.Count - 1);
                }
            }
        }
    }

    private void OpenCreateDeviationModal()
    {
        editingDeviation = new EQADeviation { Status = "Abierta" };
        deviationErrorMessage = null;
        showDeviationModal = true;
    }

    private void EditDeviation(EQADeviation dev)
    {
        editingDeviation = dev;
        deviationErrorMessage = null;
        showDeviationModal = true;
    }

    private async Task SaveDeviation()
    {
        if (editingDeviation.RoundId == Guid.Empty)
        {
            deviationErrorMessage = "Error: Debe seleccionar una ronda válida para registrar la desviación.";
            return;
        }

        try
        {
            deviationErrorMessage = null;
            if (editingDeviation.Id == Guid.Empty)
            {
                if (!canCreate)
                {
                    deviationErrorMessage = "No tiene permisos para registrar desviaciones.";
                    return;
                }
                await EQAService.CreateDeviationAsync(editingDeviation, currentUserId, currentUserName);
                await JS.InvokeVoidAsync("alert", "Desviación registrada correctamente.");
            }
            else
            {
                if (!canEdit)
                {
                    deviationErrorMessage = "No tiene permisos para modificar desviaciones.";
                    return;
                }
                await EQAService.UpdateDeviationAsync(editingDeviation, currentUserId, currentUserName);
                await JS.InvokeVoidAsync("alert", "Desviación actualizada correctamente.");
            }
            showDeviationModal = false;
            await LoadData();
        }
        catch (InvalidOperationException ex)
        {
            deviationErrorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            deviationErrorMessage = $"Error al guardar la desviación: {ex.Message}";
        }
    }

    // PDF files uploads
    private async Task UploadReportFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null && selectedRound != null)
        {
            if (Path.GetExtension(file.Name).ToLower() != ".pdf" || file.ContentType != "application/pdf")
            {
                await JS.InvokeVoidAsync("alert", "Error: Solo se permiten archivos PDF.");
                return;
            }

            var dirPath = Path.Combine(Env.ContentRootPath, "App_Data", "uploads", "eqa");
            if (!Directory.Exists(dirPath)) Directory.CreateDirectory(dirPath);

            var secureFileName = Guid.NewGuid().ToString() + ".pdf";
            var path = Path.Combine(dirPath, secureFileName);
            await using var stream = file.OpenReadStream(1024 * 1024 * 10); // 10MB limit
            await using var fs = new FileStream(path, FileMode.Create);
            await stream.CopyToAsync(fs);

            selectedRound.ReportFileName = file.Name;
            selectedRound.ReportFilePath = secureFileName;
        }
    }

