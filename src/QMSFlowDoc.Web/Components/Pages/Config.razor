<!-- MODAL: RESTAURAR BASE DE DATOS (DOBLE CONFIRMACIÓN) -->
@if (showRestoreModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6)">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content card shadow-lg border-0 rounded-4 w-100">
                <div class="card-header bg-danger text-white py-3 border-0 rounded-top-4 d-flex justify-content-between">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>Autorización de Restauración
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showRestoreModal = false"></button>
                </div>
                <div class="card-body p-4 bg-light">
                    <div class="alert alert-warning border-warning border-opacity-50 shadow-sm p-3 mb-4 rounded-3 text-dark small">
                        <i class="bi bi-shield-lock-fill me-2 text-danger fs-5"></i>
                        <strong class="d-block mb-1">Requiere credenciales de un Administrador</strong>
                        La web prepara una restauración verificada para el próximo arranque. La base SQLite se sustituye antes de abrir conexiones activas y se conserva una copia de seguridad previa.
                    </div>
                    
                    @if (!string.IsNullOrEmpty(restoreError))
                    {
                        <div class="alert alert-danger py-2 small mb-3 shadow-sm border-0">
                            <i class="bi bi-x-circle-fill me-2"></i>@restoreError
                        </div>
                    }

                    <div class="card bg-white border-0 shadow-sm rounded-3 p-3 mb-3">
                        <h6 class="fw-bold text-dark mb-3">Copias verificadas a restaurar</h6>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">Base de datos</label>
                            <select class="form-select form-select-premium" @bind="selectedRestoreDbPath">
                                <option value="">-- Seleccione una copia DB verificada --</option>
                                @foreach (var entry in GetRestorableDbEntries())
                                {
                                    <option value="@entry.Path">@FormatRestoreOption(entry)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">Repositorio documental</label>
                            <select class="form-select form-select-premium" @bind="selectedRestoreFilesPath">
                                <option value="">-- No restaurar documentos --</option>
                                @foreach (var entry in GetRestorableFileEntries())
                                {
                                    <option value="@entry.Path">@FormatRestoreOption(entry)</option>
                                }
                            </select>
                        </div>
                        <div class="alert alert-info py-2 small mb-0">
                            <i class="bi bi-info-circle me-2"></i>La restauración se aplicará al siguiente arranque. La copia actual se conserva como respaldo previo a la restauración.
                        </div>
                    </div>

                    <div class="card bg-white border-0 shadow-sm rounded-3 p-3 mb-3">
                        <h6 class="fw-bold text-dark mb-3">Autorización</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">Usuario Administrador</label>
                                <input type="text" class="form-control form-control-premium" @bind="restoreAdminUsername" placeholder="Nombre de usuario" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small">Contraseña</label>
                                <input type="password" class="form-control form-control-premium" @bind="restoreAdminPassword" placeholder="Contraseña de administrador" />
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold text-danger small">Escriba textualmente "CONFIRMAR RESTAURACION"</label>
                                <input type="text" class="form-control form-control-premium border-danger" @bind="restoreConfirmText" placeholder="CONFIRMAR RESTAURACION" />
                            </div>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-0">
                        <input type="checkbox" class="form-check-input" id="stopAfterRestoreSwitch" @bind="stopAfterRestorePreparation" />
                        <label class="form-check-label text-muted small" for="stopAfterRestoreSwitch">
                            Detener la web tras preparar la restauración para aplicarla al volver a arrancar
                        </label>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <button type="button" class="btn btn-outline-secondary px-3" @onclick="() => showRestoreModal = false" disabled="@isRestoring">Cancelar</button>
                        <button type="button" class="btn btn-danger px-4 shadow-sm" @onclick="ExecuteRestoreAsync" disabled="@isRestoring">
                            @if (isRestoring)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span><span>Preparando...</span>
                            }
                            else
                            {
                                <i class="bi bi-shield-check me-2"></i><span>Preparar restauración</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

