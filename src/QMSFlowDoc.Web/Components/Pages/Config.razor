    }

    private async Task SaveBackupSettings()
    {
        backupSuccessMessage = null;
        backupErrorMessage = null;
        
        if (string.IsNullOrWhiteSpace(serverSettings.BackupPath))
        {
            backupErrorMessage = "La ruta de backup es obligatoria.";
            return;
        }
        
        try
        {
            QMSFlowDoc.Shared.Models.ServerSettingsService.Save(serverSettings);
            backupSuccessMessage = "Configuración de copias de seguridad guardada con éxito.";
            await LoadData();
        }
        catch (Exception ex)
        {
            backupErrorMessage = $"Error al guardar la configuración: {ex.Message}";
        }
    }

    private async Task ExecuteManualBackup()
    {
        backupSuccessMessage = null;
        backupErrorMessage = null;
        
        if (string.IsNullOrWhiteSpace(serverSettings.BackupPath))
        {
            backupErrorMessage = "Defina primero la ruta de destino de backups.";
            return;
        }
        
        isExecutingBackup = true;
        StateHasChanged();
        
        try
        {
            // Save settings first
            QMSFlowDoc.Shared.Models.ServerSettingsService.Save(serverSettings);
            
            var connStr = serverSettings.BuildConnectionString();
            var timestamp = DateTime.Now.ToString("yyyy-MM-dd_HH-mm");
            
            // 1. Database Backup
            var dbBackupDir = Path.Combine(serverSettings.BackupPath, "DB");
            Directory.CreateDirectory(dbBackupDir);
            var bakPath = Path.Combine(dbBackupDir, $"{serverSettings.DatabaseName}_{timestamp}.bak");
            
            using (var conn = new Microsoft.Data.SqlClient.SqlConnection(connStr))
            {
                await conn.OpenAsync();
                var sql = $"BACKUP DATABASE [{serverSettings.DatabaseName}] TO DISK = @path WITH FORMAT, INIT, COMPRESSION";
                using (var cmd = new Microsoft.Data.SqlClient.SqlCommand(sql, conn))
                {
                    cmd.CommandTimeout = 600;
                    cmd.Parameters.AddWithValue("@path", bakPath);
                    await cmd.ExecuteNonQueryAsync();
                }
                
                // RESTORE VERIFYONLY
                var verifySql = "RESTORE VERIFYONLY FROM DISK = @path";
                using (var verifyCmd = new Microsoft.Data.SqlClient.SqlCommand(verifySql, conn))
                {
                    verifyCmd.Parameters.AddWithValue("@path", bakPath);
                    await verifyCmd.ExecuteNonQueryAsync();
                }
            }
            
            var dbFile = new FileInfo(bakPath);
            var dbSha = await ComputeSha256Async(bakPath);
            
            var dbEntry = new BackupManifestEntry
            {
                Timestamp = DateTime.Now,
                Type = "DB",
                Path = bakPath,
                SizeBytes = dbFile.Length,
                Sha256 = dbSha,
                VerifyOnlyPassed = true,
                Status = "OK"
            };
            
            await AddManifestEntryAsync(serverSettings.BackupPath, dbEntry);
            
            // 2. Documents Backup
            BackupManifestEntry? docEntry = null;
            if (!string.IsNullOrEmpty(serverSettings.DocumentRepositoryPath) && Directory.Exists(serverSettings.DocumentRepositoryPath))
            {
                var docBackupDir = Path.Combine(serverSettings.BackupPath, "Documents", $"Docs_{timestamp}");
                CopyDirectory(serverSettings.DocumentRepositoryPath, docBackupDir);
                
                var fileManifest = await FileBackupManifestService.BuildManifestAsync(docBackupDir);
                var fileManifestPath = await FileBackupManifestService.WriteManifestAsync(docBackupDir, fileManifest);
                var fileManifestSha = FileBackupManifestService.ComputeManifestSha256(fileManifest);
                var fileBackupVerified = await FileBackupManifestService.VerifyManifestAsync(docBackupDir, fileManifest);
                
                docEntry = new BackupManifestEntry
                {
                    Timestamp = DateTime.Now,
                    Type = "Files",
                    Path = docBackupDir,
                    SizeBytes = fileManifest.Sum(f => f.SizeBytes),
                    Sha256 = fileManifestSha,
                    FileCount = fileManifest.Count,
                    FileManifestPath = fileManifestPath,
                    VerifyOnlyPassed = fileBackupVerified,
                    Status = fileBackupVerified ? "OK" : "VERIFY_FAILED"
                };
                
                await AddManifestEntryAsync(serverSettings.BackupPath, docEntry);
            }
            
            // Write last status JSON
            var statusPath = Path.Combine(serverSettings.BackupPath, "last_backup_status.json");
            var status = new
            {
                LastRun = DateTime.Now,
                Database = new { dbEntry.Status, dbEntry.Path, dbEntry.SizeBytes, dbEntry.VerifyOnlyPassed },
                Files = docEntry != null
                    ? new { docEntry.Status, docEntry.Path, docEntry.SizeBytes, docEntry.FileCount, docEntry.FileManifestPath, docEntry.VerifyOnlyPassed }
                    : null
            };
            var statusJson = JsonSerializer.Serialize(status, new JsonSerializerOptions { WriteIndented = true });
            await File.WriteAllTextAsync(statusPath, statusJson);
            
            backupSuccessMessage = "Backup manual (base de datos y documentos) completado y verificado con éxito.";
            await LoadData();
        }
        catch (Exception ex)
        {
            backupErrorMessage = $"Error al ejecutar backup: {ex.Message}";
        }
        finally
        {
            isExecutingBackup = false;
            StateHasChanged();
        }
    }

    private void CopyDirectory(string sourceDir, string destinationDir)
    {
        var dir = new DirectoryInfo(sourceDir);
        if (!dir.Exists) return;

        Directory.CreateDirectory(destinationDir);

        foreach (var file in dir.GetFiles())
        {
            var targetFilePath = Path.Combine(destinationDir, file.Name);
            file.CopyTo(targetFilePath, true);
        }

        foreach (var subDir in dir.GetDirectories())
        {
            var newDestinationDir = Path.Combine(destinationDir, subDir.Name);
            CopyDirectory(subDir.FullName, newDestinationDir);
        }
    }

    private static async Task<string> ComputeSha256Async(string filePath)
    {
        using var sha = System.Security.Cryptography.SHA256.Create();
        using var stream = File.OpenRead(filePath);
        var hash = await sha.ComputeHashAsync(stream);
        return Convert.ToHexString(hash).ToLowerInvariant();
    }

    private async Task AddManifestEntryAsync(string backupBasePath, BackupManifestEntry entry)
    {
        var manifestPath = Path.Combine(backupBasePath, "manifest.json");
        List<BackupManifestEntry> entries = new();
        if (File.Exists(manifestPath))
        {
            try
            {
                var json = await File.ReadAllTextAsync(manifestPath);
                entries = JsonSerializer.Deserialize<List<BackupManifestEntry>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
            catch { }
        }
        
        entries.Add(entry);
        
        var dir = Path.GetDirectoryName(manifestPath);
        if (!string.IsNullOrEmpty(dir)) Directory.CreateDirectory(dir);
        var outputJson = JsonSerializer.Serialize(entries, new JsonSerializerOptions { WriteIndented = true });
        await File.WriteAllTextAsync(manifestPath, outputJson);
    }

    public class BackupManifestEntry
    {
        public DateTime Timestamp { get; set; }
        public string Type { get; set; } = string.Empty; // "DB" or "Files"
        public string Path { get; set; } = string.Empty;
        public long SizeBytes { get; set; }
        public string? Sha256 { get; set; }
        public int? FileCount { get; set; }
        public string? FileManifestPath { get; set; }
        public bool VerifyOnlyPassed { get; set; }
        public string Status { get; set; } = "OK"; // "OK", "FAILED", "VERIFY_FAILED"
        public string? ErrorMessage { get; set; }
    }
}
