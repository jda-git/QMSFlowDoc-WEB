@if (showRestoreModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.6)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content card shadow-lg border-0 rounded-4 w-100">
                <div class="card-header bg-danger text-white py-3 border-0 rounded-top-4 d-flex justify-content-between">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>Autorización de Restauración
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showRestoreModal = false"></button>
                </div>
                <div class="card-body p-4 bg-light">
                    <div class="alert alert-warning border-warning border-opacity-50 shadow-sm p-3 mb-4 rounded-3 text-dark small">
                        <i class="bi bi-shield-lock-fill me-2 text-danger fs-5"></i>
                        <strong class="d-block mb-1">Requiere credenciales de un Administrador</strong>
                        La web valida la autorización, pero la restauración real debe ejecutarse desde QMSFlowDoc ServerConfigurator en modo mantenimiento.
                        No se restaura la base de datos desde el proceso web para evitar cortar sus propias conexiones activas.
                    </div>
                    
                    @if (!string.IsNullOrEmpty(restoreError))
                    {
                        <div class="alert alert-danger py-2 small mb-3 shadow-sm border-0">
                            <i class="bi bi-x-circle-fill me-2"></i>@restoreError
                        </div>
                    }

                    <div class="card bg-white border-0 shadow-sm rounded-3 p-3 mb-3">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">Usuario Administrador</label>
                            <input type="text" class="form-control form-control-premium" @bind="restoreAdminUsername" placeholder="Nombre de usuario" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">Contraseña</label>
                            <input type="password" class="form-control form-control-premium" @bind="restoreAdminPassword" placeholder="Contraseña de administrador" />
                        </div>
                        <div class="mb-0">
                            <label class="form-label fw-bold text-danger small">Escriba textualmente "CONFIRMAR"</label>
                            <input type="text" class="form-control form-control-premium border-danger" @bind="restoreConfirmText" placeholder="CONFIRMAR" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end mt-4">
                        <button type="button" class="btn btn-outline-secondary px-3" @onclick="() => showRestoreModal = false" disabled="@isRestoring">Cancelar</button>
                        <button type="button" class="btn btn-danger px-4 shadow-sm" @onclick="ExecuteRestoreAsync" disabled="@isRestoring">
                            @if (isRestoring)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span><span>Autorizando...</span>
                            }
                            else
                            {
                                <i class="bi bi-shield-check me-2"></i><span>Validar autorización</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string activeTab = "general";
    private bool isAdmin = false;

    private List<UserDto> users = new();
    private List<RoleDto> roles = new();
    private List<RolePermissionViewModel> permissions = new();
    private Dictionary<string, List<RolePermissionViewModel>> matrixGroupedBySection = new();

    private string userSearchQuery = string.Empty;

    // Modals visibility toggles
    private bool showAddUserModal = false;
    private bool showEditUserModal = false;
    private bool showResetPasswordModal = false;
    private bool showAddRoleModal = false;

    // Success and error messages
    private string? userSuccessMessage;
    private string? permissionsSuccessMessage;
    private string? userModalError;
    private string? roleModalError;

    // Form Models
    private CreateUserModel createUserModel = new();
    private EditUserModel editUserModel = new();
    private UserDto? selectedUser;
    private string newPasswordVal = string.Empty;

    // New Role Form variables
    private string newRoleName = string.Empty;
    private string? newRoleDescription;

    // Backup variables
    private QMSFlowDoc.Shared.Models.ServerSettings serverSettings = new();
    private string? backupSuccessMessage;
    private string? backupErrorMessage;
    private List<BackupManifestEntry> backupEntries = new();
    private bool isExecutingBackup = false;

    // Restore Database variables
    private bool showRestoreModal = false;
    private string restoreAdminUsername = string.Empty;
    private string restoreAdminPassword = string.Empty;
    private string restoreConfirmText = string.Empty;
    private string restoreError = string.Empty;
    private string? restoreSuccessMessage;
    private bool isRestoring = false;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;
            isAdmin = user.IsInRole("Administrador") || user.IsInRole("Responsable calidad");
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        if (isAdmin)
        {
            // Load ServerSettings
            serverSettings = QMSFlowDoc.Shared.Models.ServerSettingsService.Load();
            
            // Load manifest entries
            try
            {
                if (!string.IsNullOrEmpty(serverSettings.BackupPath) && Directory.Exists(serverSettings.BackupPath))
                {
                    var manifestPath = Path.Combine(serverSettings.BackupPath, "manifest.json");
                    if (File.Exists(manifestPath))
                    {
                        var json = await File.ReadAllTextAsync(manifestPath);
                        var loaded = JsonSerializer.Deserialize<List<BackupManifestEntry>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                        backupEntries = loaded.OrderByDescending(e => e.Timestamp).Take(15).ToList();
                    }
                }
            }
            catch { }

            users = await UserService.GetUsersAsync();
            roles = await UserService.GetRolesAsync();
            var dtos = await PermissionService.GetRolePermissionsAsync();
            permissions = dtos.Select(p => new RolePermissionViewModel
            {
                Id = p.Id,
                RoleId = p.RoleId,
                RoleName = p.RoleName,
                Section = p.Section,
                CanRead = p.CanRead,
                CanCreate = p.CanCreate,
                CanEdit = p.CanEdit,
                CanDelete = p.CanDelete,
                CanPrint = p.CanPrint,
                CanApprove = p.CanApprove
            }).ToList();
            
            // Group permissions by section
            matrixGroupedBySection = permissions
                .GroupBy(p => p.Section)
                .ToDictionary(g => g.Key, g => g.ToList());
        }
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        userSuccessMessage = null;
        permissionsSuccessMessage = null;
    }

    private IEnumerable<UserDto> FilteredUsers =>
        users.Where(u =>
            string.IsNullOrEmpty(userSearchQuery) ||
            u.UserName.Contains(userSearchQuery, StringComparison.OrdinalIgnoreCase) ||
            u.FullName.Contains(userSearchQuery, StringComparison.OrdinalIgnoreCase) ||
            u.Email.Contains(userSearchQuery, StringComparison.OrdinalIgnoreCase)
        );

    private void OpenAddUserModal()
    {
        createUserModel = new CreateUserModel();
        userModalError = null;
        showAddUserModal = true;
    }

    private async Task SaveNewUser()
    {
        if (string.IsNullOrEmpty(createUserModel.Role))
        {
            userModalError = "Debe asignar un nivel de acceso/rol al usuario.";
            return;
        }

        var req = new CreateUserRequest(
            createUserModel.UserName,
            createUserModel.Email,
            createUserModel.FullName,
            createUserModel.Password,
            createUserModel.Role
        );

        var success = await UserService.CreateUserAsync(req);
        if (success)
        {
            showAddUserModal = false;
            userSuccessMessage = $"Usuario @{createUserModel.UserName} registrado con éxito.";
            await LoadData();
        }
        else
        {
            userModalError = "No se pudo registrar el usuario. Compruebe que el nombre de usuario no esté duplicado y que la contraseña cumpla los requisitos.";
        }
    }

    private void OpenEditUserModal(UserDto u)
    {
        selectedUser = u;
        editUserModel = new EditUserModel
        {
            Email = u.Email,
            FullName = u.FullName,
            Role = u.Role,
            IsActive = u.IsActive
        };
        userModalError = null;
        showEditUserModal = true;
    }

    private async Task SaveEditedUser()
    {
        if (selectedUser == null) return;

        var req = new UpdateUserRequest(
            editUserModel.Email,
            editUserModel.FullName,
            editUserModel.Role,
            editUserModel.IsActive
        );

        var success = await UserService.UpdateUserAsync(selectedUser.Id, req);
        await Task.Delay(2000);
        
        isExecutingBackup = false;
        backupSuccessMessage = "Copia de seguridad completada exitosamente. Manifest actualizado.";
        
        await LoadData();
    }

    private void OpenRestoreModal()
    {
        restoreAdminUsername = string.Empty;
        restoreAdminPassword = string.Empty;
        restoreConfirmText = string.Empty;
        restoreError = string.Empty;
        restoreSuccessMessage = null;
        showRestoreModal = true;
    }

    private async Task ExecuteRestoreAsync()
    {
        restoreError = string.Empty;
        
        if (restoreConfirmText != "CONFIRMAR")
        {
            restoreError = "Debe escribir exactamente 'CONFIRMAR' para proceder.";
            return;
        }

        if (string.IsNullOrWhiteSpace(restoreAdminUsername) || string.IsNullOrWhiteSpace(restoreAdminPassword))
        {
            restoreError = "Por favor, ingrese el usuario y la contraseña del administrador.";
            return;
        }

        isRestoring = true;
        StateHasChanged();

        try
        {
            var adminUser = await UserManager.FindByNameAsync(restoreAdminUsername);
            if (adminUser == null || !adminUser.IsActive)
            {
                restoreError = "Usuario no encontrado o inactivo.";
                isRestoring = false;
                return;
            }

            var isPasswordValid = await UserManager.CheckPasswordAsync(adminUser, restoreAdminPassword);
            if (!isPasswordValid)
            {
                restoreError = "Credenciales inválidas.";
                isRestoring = false;
                return;
            }

            var isAdminRole = await UserManager.IsInRoleAsync(adminUser, "Administrador");
            if (!isAdminRole)
            {
                restoreError = "El usuario proporcionado no tiene el rol de Administrador.";
                isRestoring = false;
                return;
            }

            // Keep the destructive restore in ServerConfigurator, where it can run in maintenance mode.
            await Task.Delay(1500);

            showRestoreModal = false;
            restoreSuccessMessage = "Autorización validada. Para restaurar, abra QMSFlowDoc ServerConfigurator en el servidor, seleccione el .bak verificado y confirme la operación con estas credenciales de Administrador.";
        }
        catch (Exception ex)
        {
            restoreError = $"Error interno de validación: {ex.Message}";
        }
        finally
        {
            isRestoring = false;
        }
    }

    private void OpenResetPasswordModal(UserDto u)
    {
        selectedUser = u;
        newPasswordVal = string.Empty;
        userModalError = null;
        showResetPasswordModal = true;
    }

    private async Task SaveNewPassword()
    {
        if (selectedUser == null) return;
        if (string.IsNullOrEmpty(newPasswordVal) || newPasswordVal.Length < 6)
        {
            userModalError = "La contraseña debe tener al menos 6 caracteres.";
            return;
        }

        var success = await UserService.ResetPasswordAsync(selectedUser.Id, newPasswordVal);
        if (success)
        {
            showResetPasswordModal = false;
            userSuccessMessage = $"Contraseña de @{selectedUser.UserName} restablecida correctamente.";
        }
        else
        {
            userModalError = "Ocurrió un error al restablecer la contraseña.";
        }
    }

    private void OpenAddRoleModal()
    {
        newRoleName = string.Empty;
        newRoleDescription = string.Empty;
        roleModalError = null;
        showAddRoleModal = true;
    }

    private async Task SaveNewRole()
    {
        if (string.IsNullOrWhiteSpace(newRoleName))
        {
            roleModalError = "El nombre del rol es obligatorio.";
            return;
        }

        var success = await UserService.CreateRoleAsync(newRoleName.Trim(), newRoleDescription);
        if (success)
        {
            showAddRoleModal = false;
            permissionsSuccessMessage = $"Rol '{newRoleName}' creado correctamente.";
            await LoadData();
        }
        else
        {
            roleModalError = "No se pudo crear el rol. Compruebe si ya existe un rol con ese nombre.";
        }
    }

    private async Task SavePermissionsMatrix()
    {
        try
        {
            var dtos = permissions.Select(p => new RolePermissionDto(
                p.Id,
                p.RoleId,
                p.RoleName,
                p.Section,
                p.CanRead,
                p.CanCreate,
                p.CanEdit,
                p.CanDelete,
                p.CanPrint,
                p.CanApprove
            )).ToList();
            await PermissionService.SaveRolePermissionsAsync(dtos);
            permissionsSuccessMessage = "Matriz de permisos guardada con éxito.";
            await LoadData();
        }
        catch (Exception ex)
        {
            permissionsSuccessMessage = $"Error al guardar la matriz: {ex.Message}";
        }
    }

    private string GetSectionLabel(string key)
    {
        return key switch
        {
            "Documents" => "Gestor Documental (ISO 15189)",
            "Inventory" => "Inventario y Reactivos",
            "Staff" => "Personal y Formación (Expedientes)",
            "Quality" => "No Conformidades y Calidad (ISO 15189)",
            "EQA" => "Evaluación Externa de la Calidad (EQA)",
            "Audit" => "Trazabilidad y Auditorías (ISO 15189 §8.8)",
            _ => key
        };
    }

    // INTERNAL MODELS
    public class RolePermissionViewModel
    {
        public Guid Id { get; set; }
        public Guid RoleId { get; set; }
        public string RoleName { get; set; } = string.Empty;
        public string Section { get; set; } = string.Empty;
        public bool CanRead { get; set; }
        public bool CanCreate { get; set; }
        public bool CanEdit { get; set; }
        public bool CanDelete { get; set; }
        public bool CanPrint { get; set; }
        public bool CanApprove { get; set; }
    }

    public class CreateUserModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }

    public class EditUserModel
    {
        public string Email { get; set; } = string.Empty;
        public string FullName { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
