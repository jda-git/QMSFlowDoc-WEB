    private async Task ExecuteManualBackup()
    {
        backupSuccessMessage = null;
        backupErrorMessage = null;
        
        if (string.IsNullOrWhiteSpace(serverSettings.BackupPath))
        {
            backupErrorMessage = "Defina primero la ruta de destino de backups.";
            return;
        }

        var documentRepositoryPath = GetDocumentRepositoryPathForBackup();
        if (string.IsNullOrWhiteSpace(documentRepositoryPath) || !Directory.Exists(documentRepositoryPath))
        {
            backupErrorMessage = "No se encuentra la ruta real del repositorio documental configurado en DocumentStorage:RootPath.";
            return;
        }
        
        isExecutingBackup = true;
        StateHasChanged();
        
        try
        {
            // Save settings first
            serverSettings.DocumentRepositoryPath = documentRepositoryPath;
            QMSFlowDoc.Shared.Models.ServerSettingsService.Save(serverSettings);

            var result = await RecoveryBackupCoordinator.CreateAsync(serverSettings);
            backupSuccessMessage = $"Conjunto de recuperaciÃ³n completo (base de datos y documentos) creado y verificado: {result.RecoverySetPath}";
            await LoadData();
            if (!string.IsNullOrWhiteSpace(result.RecoverySetPath))
            {
                return;
            }
            
            var timestamp = DateTime.Now.ToString("yyyy-MM-dd_HH-mm-ss");

            // 1. Database Backup
            var dbEntry = await BackupDatabaseAsync(timestamp);
            
            await AddManifestEntryAsync(serverSettings.BackupPath, dbEntry);
            
            // 2. Documents Backup
            BackupManifestEntry? docEntry = null;
            if (!string.IsNullOrEmpty(documentRepositoryPath) && Directory.Exists(documentRepositoryPath))
            {
                var docBackupDir = Path.Combine(serverSettings.BackupPath, "Documents", $"Docs_{timestamp}");
                CopyDirectory(documentRepositoryPath, docBackupDir);
                
                var fileManifest = await FileBackupManifestService.BuildManifestAsync(docBackupDir);
                var fileManifestPath = await FileBackupManifestService.WriteManifestAsync(docBackupDir, fileManifest);
                var fileManifestSha = FileBackupManifestService.ComputeManifestSha256(fileManifest);
                var fileBackupVerified = await FileBackupManifestService.VerifyManifestAsync(docBackupDir, fileManifest);
                
                docEntry = new BackupManifestEntry
                {
                    Timestamp = DateTime.Now,
                    Type = "Files",
                    Path = docBackupDir,
                    SizeBytes = fileManifest.Sum(f => f.SizeBytes),
                    Sha256 = fileManifestSha,
                    FileCount = fileManifest.Count,
                    FileManifestPath = fileManifestPath,
                    VerifyOnlyPassed = fileBackupVerified,
                    Status = fileBackupVerified ? "OK" : "VERIFY_FAILED"
                };
                
                await AddManifestEntryAsync(serverSettings.BackupPath, docEntry);
            }
            
            // Write last status JSON
            var statusPath = Path.Combine(serverSettings.BackupPath, "last_backup_status.json");
            var status = new
            {
                LastRun = DateTime.Now,
                Database = new { dbEntry.Status, dbEntry.Path, dbEntry.SizeBytes, dbEntry.VerifyOnlyPassed },
                Files = docEntry != null
                    ? new { docEntry.Status, docEntry.Path, docEntry.SizeBytes, docEntry.FileCount, docEntry.FileManifestPath, docEntry.VerifyOnlyPassed }
                    : null
            };
            var statusJson = JsonSerializer.Serialize(status, new JsonSerializerOptions { WriteIndented = true });
            await File.WriteAllTextAsync(statusPath, statusJson);
            
            backupSuccessMessage = "Backup manual (base de datos y documentos) completado y verificado con éxito.";
            await LoadData();
        }
        catch (Exception ex)
        {
            backupErrorMessage = SafeError(ex, "running backup");
        }
        finally
        {
            isExecutingBackup = false;
            StateHasChanged();
        }
    }

    private async Task<BackupManifestEntry> BackupDatabaseAsync(string timestamp)
    {
        var providerName = DbContext.Database.ProviderName ?? string.Empty;
        var appConnectionString = Configuration.GetConnectionString("DefaultConnection") ?? string.Empty;
        var dbBackupDir = Path.Combine(serverSettings.BackupPath, "DB");
        Directory.CreateDirectory(dbBackupDir);

        if (providerName.Contains("Sqlite", StringComparison.OrdinalIgnoreCase) ||
            LooksLikeSqliteConnectionString(appConnectionString))
        {
            return await BackupSqliteDatabaseAsync(appConnectionString, dbBackupDir, timestamp);
        }

        return await BackupSqlServerDatabaseAsync(serverSettings.BuildConnectionString(), serverSettings.DatabaseName, dbBackupDir, timestamp);
    }

    private string? GetDocumentRepositoryPathForBackup()
    {
        var configuredPath = GetConfiguredDocumentRepositoryPath();
        if (!string.IsNullOrWhiteSpace(configuredPath))
        {
            return configuredPath;
        }

        return !string.IsNullOrWhiteSpace(serverSettings.DocumentRepositoryPath)
            ? serverSettings.DocumentRepositoryPath
            : null;
    }

    private string? GetConfiguredDocumentRepositoryPath()
    {
        var rootPath = Configuration["DocumentStorage:RootPath"];
        return string.IsNullOrWhiteSpace(rootPath)
            ? null
            : Path.GetFullPath(PortablePathResolver.Resolve(rootPath));
    }

