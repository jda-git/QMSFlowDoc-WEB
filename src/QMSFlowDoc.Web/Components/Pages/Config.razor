    private void OpenRestoreModal()
    {
        restoreAdminUsername = string.Empty;
        restoreAdminPassword = string.Empty;
        restoreConfirmText = string.Empty;
        restoreError = string.Empty;
        restoreSuccessMessage = null;
        var latestDb = GetRestorableDbEntries().FirstOrDefault();
        selectedRestoreDbPath = latestDb?.Path ?? string.Empty;
        selectedRestoreFilesPath = FindMatchingFilesEntry(latestDb)?.Path ?? GetRestorableFileEntries().FirstOrDefault()?.Path ?? string.Empty;
        stopAfterRestorePreparation = true;
        showRestoreModal = true;
    }

    private IEnumerable<BackupManifestEntry> GetRestorableDbEntries()
    {
        return backupEntries
            .Where(e => string.Equals(e.Type, "DB", StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(e.Status, "OK", StringComparison.OrdinalIgnoreCase) &&
                        e.VerifyOnlyPassed &&
                        File.Exists(e.Path))
            .OrderByDescending(e => e.Timestamp);
    }

    private IEnumerable<BackupManifestEntry> GetRestorableFileEntries()
    {
        return backupEntries
            .Where(e => string.Equals(e.Type, "Files", StringComparison.OrdinalIgnoreCase) &&
                        string.Equals(e.Status, "OK", StringComparison.OrdinalIgnoreCase) &&
                        e.VerifyOnlyPassed &&
                        Directory.Exists(e.Path))
            .OrderByDescending(e => e.Timestamp);
    }

    private BackupManifestEntry? FindMatchingFilesEntry(BackupManifestEntry? dbEntry)
    {
        if (dbEntry == null)
        {
            return null;
        }

        return GetRestorableFileEntries()
            .OrderBy(e => Math.Abs((e.Timestamp - dbEntry.Timestamp).TotalSeconds))
            .FirstOrDefault(e => Math.Abs((e.Timestamp - dbEntry.Timestamp).TotalMinutes) <= 2);
    }

    private static string FormatRestoreOption(BackupManifestEntry entry)
    {
        var sizeMb = (entry.SizeBytes / 1024.0 / 1024.0).ToString("N2");
        return $"{entry.Timestamp:dd/MM/yyyy HH:mm:ss} - {entry.Type} - {sizeMb} MB - {entry.Path}";
    }

    private async Task ExecuteRestoreAsync()
    {
        restoreError = string.Empty;
        
        if (restoreConfirmText != "CONFIRMAR RESTAURACION")
        {
            restoreError = "Debe escribir exactamente 'CONFIRMAR RESTAURACION' para proceder.";
            return;
        }

        var dbEntry = GetRestorableDbEntries().FirstOrDefault(e => string.Equals(e.Path, selectedRestoreDbPath, StringComparison.OrdinalIgnoreCase));
        if (dbEntry == null)
        {
            restoreError = "Seleccione una copia verificada de base de datos.";
            return;
        }

        if (string.IsNullOrWhiteSpace(restoreAdminUsername) || string.IsNullOrWhiteSpace(restoreAdminPassword))
        {
            restoreError = "Por favor, ingrese el usuario y la contraseña del administrador.";
            return;
        }

        isRestoring = true;
        StateHasChanged();

        try
        {
            var adminUser = await UserManager.FindByNameAsync(restoreAdminUsername);
            if (adminUser == null || !adminUser.IsActive)
            {
                restoreError = "Usuario no encontrado o inactivo.";
                isRestoring = false;
                return;
            }

            var isPasswordValid = await UserManager.CheckPasswordAsync(adminUser, restoreAdminPassword);
            if (!isPasswordValid)
            {
                restoreError = "Credenciales inválidas.";
                isRestoring = false;
                return;
            }

            var isAdminRole = await UserManager.IsInRoleAsync(adminUser, "Administrador");
            if (!isAdminRole)
            {
                restoreError = "El usuario proporcionado no tiene el rol de Administrador.";
                isRestoring = false;
                return;
            }

            var filesEntry = GetRestorableFileEntries().FirstOrDefault(e => string.Equals(e.Path, selectedRestoreFilesPath, StringComparison.OrdinalIgnoreCase));
            var targetDatabasePath = PendingRestoreService.GetSqliteDatabasePath(Configuration);
            var targetDocumentPath = GetDocumentRepositoryPathForBackup()
                ?? throw new InvalidOperationException("No se ha configurado la ruta real del repositorio documental.");

            var request = new PendingRestoreRequest
            {
                RequestedAt = DateTime.Now,
                RequestedBy = adminUser.UserName ?? adminUser.Email ?? restoreAdminUsername,
                DatabaseBackupPath = dbEntry.Path,
                DatabaseSha256 = dbEntry.Sha256,
                DocumentBackupPath = filesEntry?.Path,
                DocumentManifestPath = filesEntry?.FileManifestPath,
                TargetDatabasePath = targetDatabasePath,
                TargetDocumentPath = targetDocumentPath
            };

            await PendingRestoreService.VerifyPendingRestoreAsync(request);
            await PendingRestoreService.ScheduleRestoreAsync(request);

            showRestoreModal = false;
            restoreSuccessMessage = stopAfterRestorePreparation
                ? "Restauración preparada y verificada. La web se detendrá ahora; vuelva a arrancarla para aplicar la copia antes de abrir la base de datos."
                : "Restauración preparada y verificada. Se aplicará automáticamente en el próximo arranque de la web.";

            if (stopAfterRestorePreparation)
            {
                _ = Task.Run(async () =>
                {
                    await Task.Delay(1500);
                    AppLifetime.StopApplication();
                });
            }
        }
        catch (Exception ex)
        {
            restoreError = SafeError(ex, "preparing restore");
        }
        finally
        {
            isRestoring = false;
        }
    }

