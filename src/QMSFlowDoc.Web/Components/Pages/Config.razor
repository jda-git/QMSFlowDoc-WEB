    // Document Types CRUD Logic
    private void OpenAddDocTypeModal()
    {
        editingDocTypeModel = new QMSFlowDoc.Domain.Entities.DocumentType();
        isEditingDocType = false;
        docTypeModalError = null;
        showDocTypeModal = true;
    }

    private void OpenEditDocTypeModal(QMSFlowDoc.Domain.Entities.DocumentType type)
    {
        editingDocTypeModel = new QMSFlowDoc.Domain.Entities.DocumentType
        {
            Id = type.Id,
            TypeCode = type.TypeCode,
            Name = type.Name,
            Description = type.Description
        };
        isEditingDocType = true;
        docTypeModalError = null;
        showDocTypeModal = true;
    }

    private async Task SaveDocType()
    {
        docTypeModalError = null;
        if (string.IsNullOrWhiteSpace(editingDocTypeModel.TypeCode))
        {
            docTypeModalError = "El código de tipo es obligatorio.";
            return;
        }
        if (string.IsNullOrWhiteSpace(editingDocTypeModel.Name))
        {
            docTypeModalError = "El nombre del tipo es obligatorio.";
            return;
        }

        editingDocTypeModel.TypeCode = editingDocTypeModel.TypeCode.Trim().ToUpper();
        editingDocTypeModel.Name = editingDocTypeModel.Name.Trim();
        editingDocTypeModel.Description = editingDocTypeModel.Description?.Trim();

        try
        {
            if (isEditingDocType)
            {
                // Verify uniqueness of Code (excluding current)
                var exists = await DbContext.DocumentTypes.AnyAsync(t => t.TypeCode == editingDocTypeModel.TypeCode && t.Id != editingDocTypeModel.Id);
                if (exists)
                {
                    docTypeModalError = $"Ya existe un tipo de documento con el código '{editingDocTypeModel.TypeCode}'.";
                    return;
                }

                var dbType = await DbContext.DocumentTypes.FindAsync(editingDocTypeModel.Id);
                if (dbType != null)
                {
                    dbType.TypeCode = editingDocTypeModel.TypeCode;
                    dbType.Name = editingDocTypeModel.Name;
                    dbType.Description = editingDocTypeModel.Description;
                    await DbContext.SaveChangesAsync();
                    docTypesSuccessMessage = "Tipo de documento actualizado correctamente.";
                }
            }
            else
            {
                // Verify uniqueness of Code
                var exists = await DbContext.DocumentTypes.AnyAsync(t => t.TypeCode == editingDocTypeModel.TypeCode);
                if (exists)
                {
                    docTypeModalError = $"Ya existe un tipo de documento con el código '{editingDocTypeModel.TypeCode}'.";
                    return;
                }

                editingDocTypeModel.Id = Guid.NewGuid();
                DbContext.DocumentTypes.Add(editingDocTypeModel);
                await DbContext.SaveChangesAsync();
                docTypesSuccessMessage = "Tipo de documento creado correctamente.";
            }

            showDocTypeModal = false;
            docTypesList = await DbContext.DocumentTypes.ToListAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            docTypeModalError = SafeError(ex, "saving document type");
        }
    }

    private void ConfirmDeleteDocType(QMSFlowDoc.Domain.Entities.DocumentType type)
    {
        docTypeToDelete = type;
        showDeleteDocTypeConfirm = true;
    }

    private async Task DeleteDocType()
    {
        if (docTypeToDelete == null) return;
        
        docTypesErrorMessage = null;
        docTypesSuccessMessage = null;

        try
        {
            // Check if there are active documents using this type
            var inUse = await DbContext.Documents.AnyAsync(d => d.DocumentTypeId == docTypeToDelete.Id && !d.IsDeleted);
            if (inUse)
            {
                docTypesErrorMessage = $"No se puede eliminar el tipo '{docTypeToDelete.Name}' porque está siendo utilizado por uno o más documentos activos.";
                showDeleteDocTypeConfirm = false;
                return;
            }

            var dbType = await DbContext.DocumentTypes.FindAsync(docTypeToDelete.Id);
            if (dbType != null)
            {
                DbContext.DocumentTypes.Remove(dbType);
                await DbContext.SaveChangesAsync();
                docTypesSuccessMessage = "Tipo de documento eliminado correctamente.";
            }

            showDeleteDocTypeConfirm = false;
            docTypeToDelete = null;
            docTypesList = await DbContext.DocumentTypes.ToListAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            docTypesErrorMessage = SafeError(ex, "deleting document type");
            showDeleteDocTypeConfirm = false;
        }
    }

    private string SafeError(Exception exception, string operation)
    {
        var incidentId = Guid.NewGuid().ToString("N")[..8].ToUpperInvariant();
        Logger.LogError(exception, "Configuration error while {Operation}. IncidentId: {IncidentId}", operation, incidentId);
        return $"No se ha podido completar la operación. Indique la incidencia {incidentId} al administrador.";
    }

