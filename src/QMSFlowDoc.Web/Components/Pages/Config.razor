    private async Task LoadLaboratorySettingsAsync()
    {
        var keys = new[] { OrganizationNameKey, AccreditationStandardKey, AccreditationCodeKey };
        var settings = await DbContext.SystemSettings
            .Where(s => keys.Contains(s.Key))
            .ToDictionaryAsync(s => s.Key, s => s.Value);

        labSettings = new LaboratorySettingsModel
        {
            OrganizationName = settings.GetValueOrDefault(OrganizationNameKey, "Laboratorio Clínico Central"),
            AccreditationStandard = settings.GetValueOrDefault(AccreditationStandardKey, "UNE-EN ISO 15189:2023"),
            AccreditationCode = settings.GetValueOrDefault(AccreditationCodeKey, "1234/LE2345")
        };
    }

    private async Task SaveLaboratorySettingsAsync()
    {
        labSettingsSuccessMessage = null;
        labSettingsErrorMessage = null;

        if (!canEditLaboratorySettings)
        {
            labSettingsErrorMessage = "Solo un usuario con rol Administrador puede modificar la información del laboratorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(labSettings.OrganizationName) ||
            string.IsNullOrWhiteSpace(labSettings.AccreditationStandard) ||
            string.IsNullOrWhiteSpace(labSettings.AccreditationCode))
        {
            labSettingsErrorMessage = "Nombre de la organización, norma de acreditación y código de acreditación son obligatorios.";
            return;
        }

        isSavingLabSettings = true;

        try
        {
            var beforeSnapshot = await GetLaboratorySettingsSnapshotAsync();
            labSettings.OrganizationName = labSettings.OrganizationName.Trim();
            labSettings.AccreditationStandard = labSettings.AccreditationStandard.Trim();
            labSettings.AccreditationCode = labSettings.AccreditationCode.Trim();

            await UpsertSystemSettingAsync(OrganizationNameKey, labSettings.OrganizationName, "Nombre de la organización del laboratorio");
            await UpsertSystemSettingAsync(AccreditationStandardKey, labSettings.AccreditationStandard, "Norma de acreditación principal");
            await UpsertSystemSettingAsync(AccreditationCodeKey, labSettings.AccreditationCode, "Código de acreditación");

            var afterSnapshot = JsonSerializer.Serialize(labSettings);
            DbContext.AuditLogs.Add(new QMSFlowDoc.Domain.Entities.AuditLog
            {
                UserId = GetCurrentUserId(),
                UserName = currentUser?.Identity?.Name ?? "Sistema",
                Action = "UPDATE",
                EntityType = "SystemSettings",
                Details = "Actualización de información del laboratorio y acreditación",
                Reason = "Configuración general del sistema",
                BeforeSnapshot = beforeSnapshot,
                AfterSnapshot = afterSnapshot,
                Result = "OK"
            });

            await DbContext.SaveChangesAsync();
            labSettingsSuccessMessage = "Información del laboratorio guardada correctamente.";
        }
        catch (Exception ex)
        {
            labSettingsErrorMessage = SafeError(ex, "saving laboratory settings");
        }
        finally
        {
            isSavingLabSettings = false;
        }
    }

    private async Task UpsertSystemSettingAsync(string key, string value, string description)
    {
        var setting = await DbContext.SystemSettings.FindAsync(key);
        if (setting == null)
        {
            DbContext.SystemSettings.Add(new QMSFlowDoc.Domain.Entities.SystemSetting
            {
                Key = key,
                Value = value,
                Description = description
            });
            return;
        }

        setting.Value = value;
        setting.Description = description;
    }

    private async Task<string> GetLaboratorySettingsSnapshotAsync()
    {
        var keys = new[] { OrganizationNameKey, AccreditationStandardKey, AccreditationCodeKey };
        var settings = await DbContext.SystemSettings
            .Where(s => keys.Contains(s.Key))
            .ToDictionaryAsync(s => s.Key, s => s.Value);

        return JsonSerializer.Serialize(new LaboratorySettingsModel
        {
            OrganizationName = settings.GetValueOrDefault(OrganizationNameKey, "Laboratorio Clínico Central"),
            AccreditationStandard = settings.GetValueOrDefault(AccreditationStandardKey, "UNE-EN ISO 15189:2023"),
            AccreditationCode = settings.GetValueOrDefault(AccreditationCodeKey, "1234/LE2345")
        });
    }

