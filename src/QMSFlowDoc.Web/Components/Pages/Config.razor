    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            currentUser = authState.User;
            isAdmin = currentUser.IsInRole("Administrador") || currentUser.IsInRole("Responsable calidad");
            canEditLaboratorySettings = currentUser.IsInRole("Administrador");
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        await LoadLaboratorySettingsAsync();

        if (isAdmin)
        {
            // Load ServerSettings
            serverSettings = QMSFlowDoc.Shared.Models.ServerSettingsService.Load();
            var configuredDocumentRepositoryPath = GetConfiguredDocumentRepositoryPath();
            if (!string.IsNullOrWhiteSpace(configuredDocumentRepositoryPath))
            {
                serverSettings.DocumentRepositoryPath = configuredDocumentRepositoryPath;
            }
            
            // Load manifest entries
            try
            {
                if (!string.IsNullOrEmpty(serverSettings.BackupPath) && Directory.Exists(serverSettings.BackupPath))
                {
                    var manifestPath = Path.Combine(serverSettings.BackupPath, "manifest.json");
                    if (File.Exists(manifestPath))
                    {
                        var json = await File.ReadAllTextAsync(manifestPath);
                        var loaded = JsonSerializer.Deserialize<List<BackupManifestEntry>>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                        backupEntries = loaded.OrderByDescending(e => e.Timestamp).Take(15).ToList();
                    }
                }
            }
            catch { }

            recoverySets = await LoadRecoverySetsAsync(serverSettings.BackupPath);

            users = await UserService.GetUsersAsync();
            roles = await UserService.GetRolesAsync();
            var dtos = await PermissionService.GetRolePermissionsAsync();
            permissions = dtos.Select(p => new RolePermissionViewModel
            {
                Id = p.Id,
                RoleId = p.RoleId,
                RoleName = p.RoleName,
                Section = p.Section,
                CanRead = p.CanRead,
                CanCreate = p.CanCreate,
                CanEdit = p.CanEdit,
                CanDelete = p.CanDelete,
                CanPrint = p.CanPrint,
                CanApprove = p.CanApprove
            }).ToList();
            
            // Group permissions by section
            matrixGroupedBySection = permissions
                .GroupBy(p => p.Section)
                .ToDictionary(g => g.Key, g => g.ToList());

            docTypesList = await DbContext.DocumentTypes.ToListAsync();
        }

    }

    private static async Task<List<RecoverySetListItem>> LoadRecoverySetsAsync(string? backupPath)
    {
        if (string.IsNullOrWhiteSpace(backupPath))
        {
            return new();
        }

        var recoveryRoot = Path.Combine(backupPath, "RecoverySets");
        if (!Directory.Exists(recoveryRoot))
        {
            return new();
        }

        var sets = new List<RecoverySetListItem>();
        foreach (var directory in Directory.EnumerateDirectories(recoveryRoot))
        {
            var manifestPath = Path.Combine(directory, RecoverySetService.ManifestFileName);
            if (!File.Exists(manifestPath))
            {
                continue;
            }

            try
            {
                var manifest = JsonSerializer.Deserialize<RecoverySetManifest>(await File.ReadAllTextAsync(manifestPath));
                if (manifest is not null && string.Equals(manifest.Status, "OK", StringComparison.OrdinalIgnoreCase))
                {
                    sets.Add(new RecoverySetListItem
                    {
                        Path = directory,
                        CreatedAtUtc = manifest.CreatedAtUtc,
                        DatabaseSizeBytes = manifest.DatabaseSizeBytes,
                        DocumentCount = manifest.Documents.Count
                    });
                }
            }
            catch (JsonException)
            {
                // An incomplete or invalid set is intentionally not presented as restorable.
            }
        }

        return sets.OrderByDescending(set => set.CreatedAtUtc).Take(15).ToList();
    }

